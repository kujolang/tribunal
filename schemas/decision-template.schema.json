{
  "title": "TribunalDecisionPacketTemplate",
  "type": "object",
  "required": ["schemaVersion", "id", "defaults", "append"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$" },
    "defaults": { "type": "object", "properties": { "suggestedOwnerRole": { "type": "string", "maxLength": 256 }, "suggestedModelLevel": { "type": "string", "maxLength": 512 } }, "additionalProperties": false },
    "append": { "type": "object", "required": ["acceptanceCriteria", "evidenceRequired", "stopTheLineConditions"], "properties": { "acceptanceCriteria": { "type": "array", "maxItems": 32, "items": { "type": "string", "minLength": 1, "maxLength": 512 } }, "evidenceRequired": { "type": "array", "maxItems": 32, "items": { "type": "string", "minLength": 1, "maxLength": 512 } }, "stopTheLineConditions": { "type": "array", "maxItems": 32, "items": { "type": "string", "minLength": 1, "maxLength": 512 } } }, "additionalProperties": false }
  },
  "additionalProperties": false
}
