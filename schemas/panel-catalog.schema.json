{
  "title": "TribunalPanelCatalog",
  "type": "object",
  "required": ["schemaVersion", "catalogId", "seats", "panels"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "catalogId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$" },
    "seats": {
      "type": "array", "minItems": 1, "maxItems": 16,
      "items": {
        "type": "object",
        "required": ["id", "name", "authority", "nonGoals", "stageResponsibilities", "requiredOutputSchema", "defaultModelPreference", "escalationTriggers", "promptTemplate", "permissions"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$" },
          "name": { "type": "string", "minLength": 1, "maxLength": 128 },
          "authority": { "type": "string", "minLength": 1, "maxLength": 2048 },
          "nonGoals": { "type": "array", "maxItems": 32, "items": { "type": "string", "minLength": 1, "maxLength": 512 } },
          "stageResponsibilities": { "type": "array", "minItems": 1, "maxItems": 8, "items": { "enum": ["blind-first-pass", "cross-examination"] } },
          "requiredOutputSchema": { "type": "object" },
          "defaultModelPreference": {
            "type": "object", "required": ["class", "preferred", "fallback"],
            "properties": { "class": { "type": "string", "minLength": 1 }, "preferred": { "type": "array", "maxItems": 8, "items": { "type": "string", "minLength": 1 } }, "fallback": { "type": "string", "minLength": 1 } },
            "additionalProperties": false
          },
          "escalationTriggers": { "type": "array", "maxItems": 32, "items": { "type": "string", "minLength": 1, "maxLength": 512 } },
          "promptTemplate": { "type": "string", "minLength": 20, "maxLength": 8192 },
          "permissions": {
            "type": "object", "required": ["contextSources", "maySeePeerTestimony"],
            "properties": { "contextSources": { "type": "array", "minItems": 1, "maxItems": 2, "items": { "enum": ["docket", "context-pack"] } }, "maySeePeerTestimony": { "const": false } },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    },
    "panels": {
      "type": "array", "minItems": 1, "maxItems": 16,
      "items": {
        "type": "object", "required": ["id", "name", "description", "seatIds"],
        "properties": { "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$" }, "name": { "type": "string", "minLength": 1, "maxLength": 128 }, "description": { "type": "string", "minLength": 1, "maxLength": 1024 }, "seatIds": { "type": "array", "minItems": 1, "maxItems": 16, "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$" } } },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
