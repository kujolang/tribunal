{
  "title": "Tribunal cryptographic algorithm registry",
  "type": "object",
  "required": ["schemaVersion", "algorithms"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "algorithms": {
      "type": "array", "minItems": 3,
      "items": {
        "type": "object",
        "required": ["id", "status", "runtimeAvailable", "minimumEnvelope", "maximumEnvelope", "keyTypes", "verificationPolicy"],
        "properties": {
          "id": { "enum": ["RSA-PKCS1v15-SHA256", "RSA-PSS-SHA256", "Ed25519"] },
          "status": { "enum": ["legacy-write", "migration-target"] },
          "runtimeAvailable": { "type": "boolean" },
          "minimumEnvelope": { "type": "string" },
          "maximumEnvelope": { "type": "string" },
          "keyTypes": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "verificationPolicy": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
