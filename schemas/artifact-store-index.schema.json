{
  "title": "TribunalArtifactStoreIndex",
  "type": "object",
  "required": ["schemaVersion", "runId", "currentVersion", "versions"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "runId": { "type": "string", "minLength": 1 },
    "currentVersion": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "versions": { "type": "array", "minItems": 1, "items": { "type": "object" } }
  },
  "additionalProperties": false
}
