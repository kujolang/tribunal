{
  "title": "TribunalArtifactStoreIndex",
  "type": "object",
  "required": ["schemaVersion", "runId", "currentVersion", "versions"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "runId": { "type": "string", "minLength": 1, "maxLength": 128 },
    "currentVersion": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "versions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10000,
      "items": {
        "type": "object",
        "required": ["version", "publishedAt", "keyId", "path"],
        "properties": {
          "version": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "publishedAt": { "type": "string", "minLength": 1 },
          "keyId": { "type": "string", "pattern": "^[a-f0-9]{32}$" },
          "path": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
