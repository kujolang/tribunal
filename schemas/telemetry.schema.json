{
  "title": "TribunalTelemetryExport",
  "type": "object",
  "required": ["schemaVersion", "exportedAt", "metrics", "auditEvents", "runsProcessed", "pageLimit", "cursor", "nextCursor", "hasMore"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "exportedAt": { "type": "string", "minLength": 1 },
    "metrics": { "type": "object" },
    "auditEvents": { "type": "array", "items": { "type": "object" } },
    "runsProcessed": { "type": "integer", "minimum": 0, "maximum": 500 },
    "pageLimit": { "type": "integer", "minimum": 1, "maximum": 500 },
    "cursor": { "type": "string" },
    "nextCursor": { "type": "string" },
    "hasMore": { "type": "boolean" }
  },
  "additionalProperties": false
}
