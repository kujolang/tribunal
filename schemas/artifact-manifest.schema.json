{
  "title": "TribunalArtifactManifest",
  "type": "object",
  "required": [
    "schemaVersion",
    "runId",
    "generatedAt",
    "algorithm",
    "exclusions",
    "artifacts"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "runId": { "type": "string", "minLength": 1 },
    "generatedAt": { "type": "string", "minLength": 1 },
    "algorithm": { "const": "sha256" },
    "exclusions": {
      "type": "array",
      "items": { "enum": ["artifact-manifest.json", "signature.json"] },
      "minItems": 2,
      "maxItems": 2
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path", "bytes", "sha256"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "bytes": { "type": "integer", "minimum": 0 },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
