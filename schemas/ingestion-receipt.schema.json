{
  "title": "TribunalIngestionReceipt",
  "type": "object",
  "required": [
    "schemaVersion",
    "target",
    "tribunalRunId",
    "manifestSha256",
    "keyId",
    "ingestedAt",
    "targetId",
    "targetPath"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "target": { "enum": ["runledger", "casefile"] },
    "tribunalRunId": { "type": "string", "minLength": 1 },
    "manifestSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "keyId": { "type": "string", "pattern": "^[a-f0-9]{32}$" },
    "ingestedAt": { "type": "string", "minLength": 1 },
    "targetId": { "type": "string", "minLength": 1 },
    "targetPath": { "type": "string", "minLength": 1 }
  },
  "additionalProperties": false
}
