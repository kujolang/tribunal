{
  "title": "TribunalConfig",
  "type": "object",
  "required": ["tribunal", "kujo_ai", "context", "limits", "execution", "panels", "decision_packet", "security", "authorization", "governance", "artifact_store", "telemetry"],
  "properties": {
    "tribunal": {
      "type": "object",
      "required": [
        "storage_dir",
        "default_panel",
        "require_blind_first_pass",
        "require_decision_packet",
        "stop_the_line_enabled"
      ],
      "properties": {
        "storage_dir": { "type": "string" },
        "default_panel": { "type": "string" },
        "require_blind_first_pass": { "const": true },
        "require_decision_packet": { "const": true },
        "stop_the_line_enabled": { "const": true }
      },
      "additionalProperties": false
    },
    "kujo_ai": {
      "type": "object",
      "required": [
        "default_runtime",
        "allow_direct_provider_fallback",
        "mock_mode",
        "sdk_path",
        "kujo_bin",
        "provider"
      ],
      "properties": {
        "default_runtime": { "const": "kujo-ai-sdk" },
        "allow_direct_provider_fallback": { "const": false },
        "mock_mode": { "type": "boolean" },
        "sdk_path": { "type": "string" },
        "kujo_bin": { "type": "string" },
        "provider": { "enum": ["openai", "openrouter", "deepseek"] },
        "offline_fixture": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "context": {
      "type": "object",
      "required": ["provider", "packwrite_path", "kujo_bin", "plugin_manifest_path", "plugin_provenance_path", "plugin_public_key_path", "plugin_anchor_path"],
      "properties": {
        "provider": { "enum": ["local", "packwrite", "plugin"] },
        "packwrite_path": { "type": "string", "minLength": 1 },
        "kujo_bin": { "type": "string", "minLength": 1 },
        "plugin_manifest_path": { "type": "string" },
        "plugin_provenance_path": { "type": "string" },
        "plugin_public_key_path": { "type": "string" },
        "plugin_anchor_path": { "type": "string" }
      },
      "additionalProperties": false
    },
    "limits": {
      "type": "object",
      "required": [
        "max_docket_bytes",
        "max_context_bytes",
        "max_model_output_bytes",
        "max_process_output_bytes",
        "model_timeout_ms"
      ],
      "properties": {
        "max_docket_bytes": { "type": "integer", "minimum": 1024, "maximum": 67108864 },
        "max_context_bytes": { "type": "integer", "minimum": 4096, "maximum": 67108864 },
        "max_model_output_bytes": { "type": "integer", "minimum": 1024, "maximum": 16777216 },
        "max_process_output_bytes": { "type": "integer", "minimum": 4096, "maximum": 67108864 },
        "model_timeout_ms": { "type": "integer", "minimum": 1000, "maximum": 600000 }
      },
      "additionalProperties": false
    },
    "execution": {
      "type": "object",
      "required": ["blind_parallelism", "provider_max_concurrency", "cancel_on_failure", "live_parallel_enabled"],
      "properties": {
        "blind_parallelism": { "type": "integer", "minimum": 1, "maximum": 16 },
        "provider_max_concurrency": { "type": "integer", "minimum": 1, "maximum": 16 },
        "cancel_on_failure": { "const": true },
        "live_parallel_enabled": { "const": false }
      },
      "additionalProperties": false
    },
    "panels": {
      "type": "object",
      "required": ["catalog_path", "provenance_path", "public_key_path", "anchor_path"],
      "properties": {
        "catalog_path": { "type": "string" },
        "provenance_path": { "type": "string" },
        "public_key_path": { "type": "string" },
        "anchor_path": { "type": "string" }
      },
      "additionalProperties": false
    },
    "decision_packet": {
      "type": "object",
      "required": ["template_path", "policy_path", "policy_provenance_path", "policy_public_key_path", "policy_anchor_path"],
      "properties": {
        "template_path": { "type": "string" },
        "policy_path": { "type": "string" },
        "policy_provenance_path": { "type": "string" },
        "policy_public_key_path": { "type": "string" },
        "policy_anchor_path": { "type": "string" }
      },
      "additionalProperties": false
    },
    "security": {
      "type": "object",
      "required": ["organization_secret_patterns_path", "require_same_mount", "private_key_permission_mode"],
      "properties": {
        "organization_secret_patterns_path": { "type": "string" },
        "require_same_mount": { "const": false },
        "private_key_permission_mode": { "const": "managed-provider-required" }
      },
      "additionalProperties": false
    },
    "authorization": {
      "type": "object",
      "required": ["mode", "identity", "policy_path"],
      "properties": {
        "mode": { "enum": ["local", "policy"] },
        "identity": { "type": "string", "minLength": 1 },
        "policy_path": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "governance": {
      "type": "object",
      "required": ["retention_class", "retention_days", "legal_hold", "owner"],
      "properties": {
        "retention_class": { "type": "string", "minLength": 1 },
        "retention_days": { "type": "integer", "minimum": 1, "maximum": 36500 },
        "legal_hold": { "type": "boolean" },
        "owner": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "artifact_store": {
      "type": "object",
      "required": ["provider", "root", "endpoint", "tenant_id", "bearer_token_file", "region"],
      "properties": {
        "provider": { "enum": ["local-immutable", "http-immutable"] },
        "root": { "type": "string" },
        "endpoint": { "type": "string" },
        "tenant_id": { "type": "string" },
        "bearer_token_file": { "type": "string" },
        "region": { "type": "string" }
      },
      "additionalProperties": false
    },
    "telemetry": {
      "type": "object",
      "required": ["collector", "destination"],
      "properties": {
        "collector": { "enum": ["jsonl", "http"] },
        "destination": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
