{
  "title": "TribunalContextConnector",
  "type": "object",
  "required": ["schemaVersion", "id", "adapterPath", "allowedRoots", "timeoutMs", "maxOutputBytes"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$" },
    "adapterPath": { "type": "string", "minLength": 1 },
    "allowedRoots": { "type": "array", "minItems": 1, "maxItems": 16, "items": { "type": "string", "minLength": 1 } },
    "timeoutMs": { "type": "integer", "minimum": 1000, "maximum": 120000 },
    "maxOutputBytes": { "type": "integer", "minimum": 1024, "maximum": 8388608 }
  },
  "additionalProperties": false
}
