{
  "title": "TribunalAdoptionAggregate",
  "type": "object",
  "required": ["schemaVersion", "period", "consentSurface", "tribunalDocsOptIns", "kujoDocsArrivals", "kujoFirstRunCompletions", "privacy"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "period": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}$" },
    "consentSurface": { "const": "explicit-documentation-link" },
    "tribunalDocsOptIns": { "type": "integer", "minimum": 0 },
    "kujoDocsArrivals": { "type": "integer", "minimum": 0 },
    "kujoFirstRunCompletions": { "type": "integer", "minimum": 0 },
    "privacy": { "type": "object", "required": ["aggregateOnly", "runtimeTelemetry", "cookies", "rawIpRetention", "minimumCohort"], "properties": { "aggregateOnly": { "const": true }, "runtimeTelemetry": { "const": false }, "cookies": { "const": false }, "rawIpRetention": { "const": false }, "minimumCohort": { "type": "integer", "minimum": 10 } }, "additionalProperties": false }
  },
  "additionalProperties": false
}
