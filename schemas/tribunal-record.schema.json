{
  "title": "TribunalRecord",
  "type": "object",
  "required": [
    "schemaVersion",
    "runId",
    "status",
    "startedAt",
    "completedAt",
    "panel",
    "seats",
    "stagesCompleted",
    "testimonies",
    "crossExaminations",
    "artifactPaths"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "runId": { "type": "string" },
    "status": { "enum": ["completed", "stopped"] },
    "startedAt": { "type": "string", "minLength": 1 },
    "completedAt": { "type": "string", "minLength": 1 },
    "docket": { "type": "object" },
    "panel": { "type": "object" },
    "seats": { "type": "array", "items": { "type": "object" } },
    "stagesCompleted": { "type": "array", "items": { "type": "string" } },
    "testimonies": { "type": "array", "items": { "type": "object" } },
    "crossExaminations": { "type": "array", "items": { "type": "object" } },
    "killPass": { "type": "object" },
    "ruling": { "type": "object" },
    "decisionPacket": { "type": "object" },
    "stopReason": { "type": "string" },
    "governance": {
      "type": "object",
      "required": ["schemaVersion", "retentionClass", "retentionDays", "retainUntilMs", "legalHold", "owner", "createdBy", "createdAt"],
      "properties": {
        "schemaVersion": { "const": "1.0.0" },
        "retentionClass": { "type": "string", "minLength": 1 },
        "retentionDays": { "type": "integer", "minimum": 1 },
        "retainUntilMs": { "type": "integer", "minimum": 0 },
        "legalHold": { "type": "boolean" },
        "owner": { "type": "string", "minLength": 1 },
        "createdBy": { "type": "string", "minLength": 1 },
        "createdAt": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "artifactPaths": { "type": "array", "items": { "type": "string" } }
  },
  "additionalProperties": false
}
