{
  "title": "TribunalSigningProvider",
  "type": "object",
  "required": ["schemaVersion", "provider", "command", "keyReference", "kujoBin"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "provider": { "type": "string", "minLength": 1 },
    "command": { "type": "string", "minLength": 1 },
    "keyReference": { "type": "string", "minLength": 1 },
    "kujoBin": { "type": "string", "minLength": 1 },
    "timeoutMs": { "type": "integer", "minimum": 1000, "maximum": 120000 },
    "protocol": { "enum": ["command-v1", "vault-transit-jwt-v1"] },
    "endpoint": { "type": "string" },
    "jwtRole": { "type": "string" },
    "jwtAuthPath": { "type": "string" },
    "transitPath": { "type": "string" },
    "namespace": { "type": "string" },
    "audience": { "type": "string" },
    "maxAttempts": { "type": "integer", "minimum": 1, "maximum": 5 },
    "baseDelayMs": { "type": "integer", "minimum": 10, "maximum": 5000 }
  },
  "additionalProperties": false
}
