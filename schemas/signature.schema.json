{
  "title": "TribunalSignatureEnvelope",
  "type": "object",
  "required": [
    "schemaVersion",
    "runId",
    "algorithm",
    "manifestSha256",
    "keyId",
    "signedAt",
    "signature"
  ],
  "properties": {
    "schemaVersion": { "enum": ["1.0.0", "1.1.0", "1.2.0"] },
    "runId": { "type": "string", "minLength": 1 },
    "algorithm": { "const": "RSA-PKCS1v15-SHA256" },
    "manifestSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "keyId": { "type": "string", "pattern": "^[a-f0-9]{32}$" },
    "signedAt": { "type": "string", "minLength": 1 },
    "payloadSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "signature": { "type": "string", "minLength": 40 },
    "signingProvider": { "type": "string", "minLength": 1 },
    "signerRef": { "type": "string", "minLength": 1 }
  },
  "anyOf": [
    {
      "type": "object",
      "required": ["schemaVersion"],
      "properties": { "schemaVersion": { "const": "1.0.0" } }
    },
    {
      "type": "object",
      "required": ["schemaVersion", "payloadSha256"],
      "properties": { "schemaVersion": { "enum": ["1.1.0", "1.2.0"] } }
    }
  ],
  "additionalProperties": false
}
