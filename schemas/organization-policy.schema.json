{
  "title": "TribunalOrganizationPolicy",
  "type": "object",
  "required": ["schemaVersion", "id", "mode", "requiredEvidence", "requiredAcceptanceCriteria", "forbiddenDispositions"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$" },
    "mode": { "enum": ["advisory", "enforce"] },
    "requiredEvidence": { "type": "array", "maxItems": 32, "items": { "type": "string", "minLength": 1, "maxLength": 512 } },
    "requiredAcceptanceCriteria": { "type": "array", "maxItems": 32, "items": { "type": "string", "minLength": 1, "maxLength": 512 } },
    "forbiddenDispositions": { "type": "array", "maxItems": 3, "items": { "enum": ["proceed", "reject", "redesign"] } }
  },
  "additionalProperties": false
}
