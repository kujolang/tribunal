{
  "name": "@kujolang/tribunal",
  "version": "0.1.0",
  "description": "Local-first structured adversarial decision review for the KUJO ecosystem.",
  "type": "module",
  "bin": {
    "tribunal": "dist/src/cli.js"
  },
  "files": [
    "dist",
    "integrations",
    "schemas",
    "tribunal.config.json",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20",
    "npm": ">=10"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rm -rf dist coverage",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test --test-reporter=spec dist/tests/*.test.js",
    "test:all": "npm run build && npm run lint && npm run test",
    "tribunal": "node dist/cli.js"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.1",
    "@types/node": "^24.0.10",
    "eslint": "^9.30.1",
    "prettier": "^3.6.2",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.36.0"
  },
  "license": "MIT"
}
