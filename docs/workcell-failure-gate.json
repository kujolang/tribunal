{
  "version": 1,
  "name": "tribunal-intentional-failure",
  "runtime": {
    "backend": "docker",
    "image": "kujolang/workcell-kujo:tribunal-kujo-1.5.0-cc2d7db",
    "build_context": ""
  },
  "workspace": {
    "strategy": "git-worktree",
    "mount_path": "/workspace"
  },
  "command": [
    "sh",
    "-lc",
    "printf \"intentional-workload-failure\\n\" > tribunal-workcell-proof.txt; exit 17"
  ],
  "environment": {
    "allow": [],
    "set": {
      "KUJO": "/usr/local/bin/kujo",
      "KUJO_BIN": "/usr/local/bin/kujo"
    }
  },
  "secrets": [],
  "resources": {
    "cpus": 1,
    "memory": "512m",
    "pids": 128,
    "timeout_ms": 120000
  },
  "network": {
    "mode": "none"
  },
  "filesystem": {
    "read_only_root": true,
    "tmpfs": [
      "/tmp"
    ]
  },
  "artifacts": {
    "export": [
      "tribunal-workcell-proof.txt"
    ]
  },
  "cleanup": {
    "keep_failed": false
  },
  "trust_profile": "contained-standard",
  "receipt": {
    "path": ".workcell/runs"
  }
}
