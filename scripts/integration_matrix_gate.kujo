from src.common import read_json, dict_get
from src.version import VERSION

home := path_absolute(env_or("TRIBUNAL_HOME", "."))
matrix := read_json(join_path(home, "docs/INTEGRATION_MATRIX.json"))
mut failures := []
if matrix["schemaVersion"] != "1.0.0" || matrix["tribunalVersion"] != VERSION || len(matrix["integrations"]) != 10 || len(dict_get(matrix, "excluded", [])) != 1 {
    failures = push(failures, "matrix-contract")
}

mut names := {}
for integration in matrix["integrations"] {
    if has_key(names, integration["name"]) == 1 { failures = push(failures, "duplicate:" + integration["name"]) }
    names[integration["name"]] := true
    resolved := join_path(home, integration["path"])
    if path_is_dir(resolved) == false || len(integration["revision"]) != 40 || integration["version"] != "1.0.0" || trim(integration["gate"]) == "" || trim(integration["scope"]) == "" {
        failures = push(failures, "invalid:" + integration["name"])
        continue
    }
    revision := spawn_process(["git", "-C", resolved, "rev-parse", "HEAD"], {"inherit_env": true, "timeout_ms": 10000, "max_output_bytes": 4096})
    if revision.success != true || trim(revision.stdout) != integration["revision"] { failures = push(failures, "revision:" + integration["name"]) }
}

for excluded in dict_get(matrix, "excluded", []) {
    if has_key(names, excluded["name"]) == 1 { failures = push(failures, "duplicate:" + excluded["name"]) }
    names[excluded["name"]] := true
    resolved := join_path(home, excluded["path"])
    if path_is_dir(resolved) == false || len(excluded["revision"]) != 40 || excluded["version"] != "1.0.0" || trim(excluded["reason"]) == "" {
        failures = push(failures, "invalid-exclusion:" + excluded["name"])
        continue
    }
    revision := spawn_process(["git", "-C", resolved, "rev-parse", "HEAD"], {"inherit_env": true, "timeout_ms": 10000, "max_output_bytes": 4096})
    if revision.success != true || trim(revision.stdout) != excluded["revision"] { failures = push(failures, "revision:" + excluded["name"]) }
}

print(to_json({"ok": len(failures) == 0, "tribunalVersion": matrix["tribunalVersion"], "integrations": len(matrix["integrations"]), "excluded": len(dict_get(matrix, "excluded", [])), "revisionPinned": true, "workingTreesMatch": len(failures) == 0, "failures": failures}))
if len(failures) > 0 { exit(1) }
exit(0)
