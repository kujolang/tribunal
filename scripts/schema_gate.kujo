# Tribunal :: Kujo-native emitted-contract and schema gate

from src.common import ensure_dir, remove_tree, dict_get
from src.config import load_config
from src.tribunal import review
from src.storage import load_record, load_events, artifact_path
from src.integrity import generate_keys, verify

mut failures := []

func require(condition, message) {
    if condition != true { failures = push(failures, message) }
}

home := env_or("TRIBUNAL_HOME", ".")
for name in ["tribunal-config.schema.json", "tribunal-record.schema.json", "tribunal-event.schema.json", "artifact-manifest.schema.json", "signature.schema.json", "ingestion-receipt.schema.json"] {
    path := join_path(join_path(home, "schemas"), name)
    require(file_exists(path), "Missing schema: " + name)
    if file_exists(path) {
        parsed := null
        try { parsed = parse_json(read_file(path)) } except err { parsed = null }
        require(type(parsed) == "dict", "Invalid JSON schema: " + name)
        if type(parsed) == "dict" { require(dict_get(parsed, "$schema", "") != "", "Schema declaration missing: " + name) }
    }
}

loaded := load_config(join_path(home, "tribunal.config.json"))
require(loaded["ok"] == true, "tribunal.config.json failed Kujo validation")

root := join_path(env_or("TMPDIR", "/tmp"), "tribunal-schema-gate-" + to_string(current_timestamp()))
ensure_dir(root)
docket := join_path(root, "docket.md")
write_file(docket, "# Schema gate\n\n## Scope\n\nValidate every emitted Kujo Tribunal contract.\n")
private_key := join_path(root, "private.pem")
public_key := join_path(root, "public.pem")
keys_result := generate_keys(private_key, public_key)
require(keys_result["ok"] == true, "Kujo RSA key generation failed")

if loaded["ok"] == true && keys_result["ok"] == true {
    config := loaded["config"]
    tribunal := config["tribunal"]
    tribunal["storage_dir"] := join_path(root, "runs")
    config["tribunal"] := tribunal
    result := review(config, docket, "fast-two-model", private_key, public_key)
    require(result["ok"] == true, "Schema gate review failed")
    if result["ok"] == true {
        run_id := result["runId"]
        record := load_record(tribunal["storage_dir"], run_id)
        for key in ["schemaVersion", "runId", "status", "startedAt", "completedAt", "panel", "seats", "stagesCompleted", "testimonies", "crossExaminations", "artifactPaths"] {
            require(has_key(record, key) == 1, "record.json missing " + key)
        }
        require(len(record["stagesCompleted"]) == 9, "record.json did not complete all stages")
        events := load_events(tribunal["storage_dir"], run_id)
        require(len(events) > 0, "events.jsonl is empty")
        for event in events {
            for key in ["timestamp", "runId", "stageId", "eventType", "summary", "metadata"] {
                require(has_key(event, key) == 1, "event missing " + key)
            }
        }
        signature := parse_json(read_file(artifact_path(tribunal["storage_dir"], run_id, "signature.json")))
        require(signature["algorithm"] == "RSA-PKCS1v15-SHA256", "signature algorithm is not Kujo-native RSA")
        checked := verify(tribunal["storage_dir"], run_id, public_key)
        require(checked["ok"] == true && checked["signature"] == "verified", "signed artifact set did not verify")
        require(checked["artifactsChecked"] >= 18, "artifact manifest coverage is incomplete")
    }
}

remove_tree(root)
if len(failures) > 0 {
    for failure in failures { print("FAIL: " + failure) }
    exit(1)
}
print("Schema gate passed: 6 schemas; emitted record, events, manifest, and RSA signature verified with Kujo tooling.")
exit(0)
