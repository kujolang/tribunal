# Tribunal :: Kujo-native emitted-contract and schema gate

from src.common import ensure_dir, remove_tree, dict_get
from src.config import load_config
from src.tribunal import review
from src.storage import load_record, load_events, artifact_path
from src.integrity import generate_keys, verify
from src.contracts import validate_run_contracts
from src.bundles import export_bundle
from src.artifact_store import publish_local
from src.telemetry import telemetry_payload
from src.audit import audit_run

mut failures := []

func require(condition, message) {
    if condition != true { failures = push(failures, message) }
}

home := env_or("TRIBUNAL_HOME", ".")
schema_names := ["access-policy.schema.json", "algorithm-registry.schema.json", "artifact-manifest.schema.json", "artifact-store-index.schema.json", "audit-report.schema.json", "bundle.schema.json", "decision-packet.schema.json", "encrypted-bundle.schema.json", "governance.schema.json", "http-store-conformance-report.schema.json", "ingestion-receipt.schema.json", "kms-conformance-report.schema.json", "legal-hold.schema.json", "provenance-anchor.schema.json", "provenance.schema.json", "receipt.schema.json", "ruling.schema.json", "signature.schema.json", "signing-provider.schema.json", "telemetry.schema.json", "tribunal-config.schema.json", "tribunal-event.schema.json", "tribunal-record.schema.json", "trust-policy.schema.json"]
for name in schema_names {
    path := join_path(join_path(home, "schemas"), name)
    require(file_exists(path), "Missing schema: " + name)
    if file_exists(path) {
        parsed := null
        try { parsed = parse_json(read_file(path)) } except err { parsed = null }
        require(type(parsed) == "dict", "Invalid JSON schema: " + name)
        if type(parsed) == "dict" {
            require(dict_get(parsed, "title", "") != "", "Schema title missing: " + name)
            engine_result := null
            try { engine_result = json_schema_validate({}, parsed) } except err { engine_result = null }
            require(type(engine_result) == "dict", "Kujo schema engine rejected schema: " + name)
        }
    }
}

loaded := load_config(join_path(home, "examples/tribunal.config.json"))
require(loaded["ok"] == true, "examples/tribunal.config.json failed Kujo validation")
if loaded["ok"] == true {
    config_schema := parse_json(read_file(join_path(join_path(home, "schemas"), "tribunal-config.schema.json")))
    require(json_schema_validate(loaded["config"], config_schema)["valid"] == true, "example config failed JSON Schema validation")
}
for mapping in [["examples/access-policy.json", "access-policy.schema.json"], ["examples/trust-policy.json", "trust-policy.schema.json"], ["examples/signing-provider.json", "signing-provider.schema.json"]] {
    value := parse_json(read_file(join_path(home, mapping[0])))
    schema := parse_json(read_file(join_path(join_path(home, "schemas"), mapping[1])))
    require(json_schema_validate(value, schema)["valid"] == true, mapping[0] + " failed JSON Schema validation")
}

root := join_path(env_or("TMPDIR", "/tmp"), "tribunal-schema-gate-" + to_string(current_timestamp()))
ensure_dir(root)
docket := join_path(root, "docket.md")
write_file(docket, "# Schema gate\n\n## Scope\n\nValidate every emitted Kujo Tribunal contract.\n")
private_key := join_path(root, "private.pem")
public_key := join_path(root, "public.pem")
keys_result := generate_keys(private_key, public_key, 2048)
require(keys_result["ok"] == true, "Kujo RSA key generation failed")

if loaded["ok"] == true && keys_result["ok"] == true {
    config := loaded["config"]
    tribunal := config["tribunal"]
    tribunal["storage_dir"] := join_path(root, "runs")
    config["tribunal"] := tribunal
    result := review(config, docket, "fast-two-model", private_key, public_key)
    require(result["ok"] == true, "Schema gate review failed")
    if result["ok"] == true {
        run_id := result["runId"]
        record := load_record(tribunal["storage_dir"], run_id)
        for key in ["schemaVersion", "runId", "status", "startedAt", "completedAt", "panel", "seats", "stagesCompleted", "testimonies", "crossExaminations", "artifactPaths"] {
            require(has_key(record, key) == 1, "record.json missing " + key)
        }
        require(len(record["stagesCompleted"]) == 9, "record.json did not complete all stages")
        events := load_events(tribunal["storage_dir"], run_id)
        require(len(events) > 0, "events.jsonl is empty")
        for event in events {
            for key in ["timestamp", "runId", "stageId", "eventType", "summary", "metadata"] {
                require(has_key(event, key) == 1, "event missing " + key)
            }
        }
        signature := parse_json(read_file(artifact_path(tribunal["storage_dir"], run_id, "signature.json")))
        require(signature["algorithm"] == "RSA-PKCS1v15-SHA256", "signature algorithm is not Kujo-native RSA")
        require(signature["schemaVersion"] == "1.1.0" && len(signature["payloadSha256"]) == 64, "signature payload contract is not v1.1.0")
        receipt := parse_json(read_file(artifact_path(tribunal["storage_dir"], run_id, "receipt.json")))
        require(receipt["runId"] == run_id && len(receipt["recordSha256"]) == 64, "receipt contract is invalid")
        require(type(record["ruling"]) == "dict" && type(record["decisionPacket"]) == "dict", "ruling or decision packet contract is missing")
        checked := verify(tribunal["storage_dir"], run_id, public_key)
        require(checked["ok"] == true && checked["signature"] == "verified", "signed artifact set did not verify")
        require(checked["artifactsChecked"] >= 18, "artifact manifest coverage is incomplete")
        contracts := validate_run_contracts(home, tribunal["storage_dir"], run_id)
        require(contracts["ok"] == true && contracts["validated"] > 10, "emitted artifacts failed complete JSON Schema validation")
        audit := audit_run(home, tribunal["storage_dir"], run_id, public_key, true, null, "audit")
        audit_schema := parse_json(read_file(join_path(join_path(home, "schemas"), "audit-report.schema.json")))
        require(audit["ok"] == true && json_schema_validate(audit, audit_schema)["valid"] == true, "audit report failed schema")
        bundle_path := join_path(root, "bundle")
        bundle := export_bundle(tribunal["storage_dir"], run_id, bundle_path)
        require(bundle["ok"] == true, "signed bundle export failed")
        if bundle["ok"] == true {
            bundle_schema := parse_json(read_file(join_path(join_path(home, "schemas"), "bundle.schema.json")))
            require(json_schema_validate(bundle["bundle"], bundle_schema)["valid"] == true, "bundle metadata failed schema")
        }
        store := publish_local(tribunal["storage_dir"], run_id, join_path(root, "store"), "")
        require(store["ok"] == true, "artifact-store publication failed")
        if store["ok"] == true {
            index_schema := parse_json(read_file(join_path(join_path(home, "schemas"), "artifact-store-index.schema.json")))
            require(json_schema_validate(store["index"], index_schema)["valid"] == true, "artifact-store index failed schema")
        }
        telemetry_schema := parse_json(read_file(join_path(join_path(home, "schemas"), "telemetry.schema.json")))
        require(json_schema_validate(telemetry_payload(tribunal["storage_dir"]), telemetry_schema)["valid"] == true, "telemetry export failed schema")
    }
}

remove_tree(root)
if len(failures) > 0 {
    for failure in failures { print("FAIL: " + failure) }
    exit(1)
}
print("Schema gate passed: " + to_string(len(schema_names)) + " executable schemas; policies, config, evidence, audit, bundle, store index, telemetry, and RSA signature fully validated with Kujo tooling.")
exit(0)
