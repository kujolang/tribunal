from src.common import write_json
from src.version import VERSION
platform := env_or("TRIBUNAL_PLATFORM", ""); revision := env_or("TRIBUNAL_SOURCE_REVISION", ""); output := env_or("TRIBUNAL_COMPATIBILITY_OUTPUT", "")
kujo := env_or("KUJO_BIN", "")
if platform == "" || revision == "" || output == "" || file_exists(kujo) == false { print("Platform receipt inputs are required."); exit(2) }
gates := [
    "kujo-check-all",
    "tribunal-tests",
    "cli-integration",
    "enterprise-tests",
    "property-tests",
    "schema",
    "concord-drift",
    "strict-spec",
    "eval",
    "performance",
    "scale-performance",
    "index-performance",
    "load-chaos",
    "adversarial",
    "dashboard-accessibility",
    "security-review-register",
    "integration-matrix",
    "kennel-package",
    "gallery",
    "reproducible-release-archive",
    "doctor"
]
environment := {
    "runnerImage": env_or("TRIBUNAL_RUNNER_IMAGE", "local"),
    "osRelease": env_or("TRIBUNAL_OS_RELEASE", "not-recorded"),
    "kernel": env_or("TRIBUNAL_KERNEL", "not-recorded")
}
receipt := {"schemaVersion": "1.1.0", "tribunalVersion": VERSION, "sourceRevision": revision, "platform": platform, "environment": environment, "kujoVersion": "1.0.0", "kujoSha256": sha256_file(kujo), "measuredAt": now_utc(), "gates": gates, "result": "pass", "claimBoundary": "This receipt covers only the named revision, pinned runtime digest, measured environment, architecture, and completed gates."}
write_json(output, receipt); print(to_json(receipt)); exit(0)
