# Generate command reference, man page, and shell completions from CLI help.
from src.common import ensure_dir, safe_process_env, write_text

home := path_absolute(env_or("TRIBUNAL_HOME", ".")); kujo := env_or("KUJO_BIN", join_path(home, "../kujo/target/release/kujo"))
proc := spawn_process([kujo, "run", join_path(home, "tribunal.kujo"), "--interpreter", "--", "help"], {"inherit_env": false, "env": safe_process_env({"TRIBUNAL_HOME": home}), "timeout_ms": 30000, "max_output_bytes": 1048576})
if proc.success == false { print("Unable to generate CLI assets from help output."); exit(1) }
mut usages := []; mut commands := []
for line in split(proc.stdout, "\n") {
    value := trim(line)
    if starts_with(value, "tribunal ") {
        usages = push(usages, value)
        tokens := split(value, " "); command := tokens[1]
        if contains(join(commands, " "), command) == 0 { commands = push(commands, command) }
    }
}
if len(commands) < 20 { print("CLI help parser found too few commands."); exit(1) }
ensure_dir(join_path(home, "completions")); ensure_dir(join_path(home, "man/man1"))
mut markdown := "# Tribunal command reference\n\nGenerated from `tribunal help`; edit the CLI help source and rerun `scripts/generate_cli_assets.kujo`.\n\n## Commands\n\n```text\n"
for usage in usages { markdown = markdown + usage + "\n" }
markdown = markdown + "```\n\nExit codes: `0` success, `1` runtime failure, `2` usage/configuration or stopped hearing, and `3` integrity failure. All commands accept `--config`, `--storage-dir`, `--identity`, and `--access-policy` where applicable.\n"
write_text(join_path(home, "docs/COMMAND_REFERENCE.md"), markdown)
words := join(commands, " ")
dollar := substring("$x", 0, 1)
write_text(join_path(home, "completions/tribunal.bash"), "# generated\n_tribunal_complete() { local cur=\"" + dollar + "{COMP_WORDS[COMP_CWORD]}\"; if [ \"" + dollar + "COMP_CWORD\" -eq 1 ]; then COMPREPLY=( " + dollar + "(compgen -W \"" + words + "\" -- \"" + dollar + "cur\") ); fi; }\ncomplete -F _tribunal_complete tribunal\n")
mut zsh := "#compdef tribunal\n# generated\n_arguments '1:command:(" + words + ")' '*::argument:->args'\n"
write_text(join_path(home, "completions/_tribunal"), zsh)
mut fish := "# generated\n"
for command in commands { fish = fish + "complete -c tribunal -n '__fish_use_subcommand' -a '" + command + "'\n" }
write_text(join_path(home, "completions/tribunal.fish"), fish)
mut man := ".TH TRIBUNAL 1 \"2026-07-12\" \"Tribunal\" \"User Commands\"\n.SH NAME\ntribunal \\- sealed adversarial decision review in Kujo\n.SH SYNOPSIS\n.B tribunal\n.I command options\n.SH COMMANDS\n"
for usage in usages { man = man + ".TP\n.B " + replace(usage, "-", "\\-") + "\n" }
man = man + ".SH EXIT STATUS\n0 success; 1 runtime failure; 2 usage/configuration or stopped hearing; 3 integrity failure.\n.SH SEE ALSO\nTribunal README and docs/OPERATIONS.md.\n"
write_text(join_path(home, "man/man1/tribunal.1"), man)
print(to_json({"ok": true, "commands": len(commands), "usages": len(usages), "outputs": ["docs/COMMAND_REFERENCE.md", "completions/tribunal.bash", "completions/_tribunal", "completions/tribunal.fish", "man/man1/tribunal.1"]}))
exit(0)
