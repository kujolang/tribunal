from src.providers import openai_provider, openrouter_provider, deepseek_provider
from src.ai_sdk import create_client, create_message, chat_completion, provider_metadata, resolve_model_preference

func dict_get_or(obj, key, fallback) {
	if type(obj) != "dict" {
		return fallback
	}
	if has_key(obj, key) {
		return obj[key]
	}
	return fallback
}

func fixture_value(schema) {
	if type(schema) != "dict" { return null }
	enum_values := dict_get_or(schema, "enum", [])
	if type(enum_values) == "array" && len(enum_values) > 0 { return enum_values[0] }
	value_type := dict_get_or(schema, "type", "")
	if value_type == "string" { return "fixture" }
	if value_type == "integer" { return dict_get_or(schema, "minimum", 0) }
	if value_type == "number" { return dict_get_or(schema, "minimum", 0) }
	if value_type == "boolean" { return false }
	if value_type == "array" {
		mut values := []
		mut i := 0
		minimum := dict_get_or(schema, "minItems", 0)
		while i < minimum { values = push(values, fixture_value(dict_get_or(schema, "items", {}))); i = i + 1 }
		return values
	}
	if value_type == "object" || type(dict_get_or(schema, "properties", null)) == "dict" {
		mut value := {}
		properties := dict_get_or(schema, "properties", {})
		for name in dict_get_or(schema, "required", []) {
			if has_key(properties, name) { value[name] := fixture_value(properties[name]) }
		}
		return value
	}
	return null
}

payload_text := trim(to_string(env("KUJO_TRIBUNAL_PAYLOAD")))
if payload_text == "" {
	print(to_json({"ok": false, "error": {"code": "invalid_request", "message": "Missing KUJO_TRIBUNAL_PAYLOAD", "retryable": false}}))
	exit(1)
}

payload := parse_json(payload_text)
provider_id := dict_get_or(payload, "provider", "openai")
provider := openai_provider()
if provider_id == "openrouter" {
	provider = openrouter_provider()
}
if provider_id == "deepseek" {
	provider = deepseek_provider()
}

model_resolution := resolve_model_preference(provider, dict_get_or(payload, "modelPreference", {}))
if !model_resolution["ok"] {
	print(to_json({
		"ok": false,
		"provider": provider["name"],
		"model": "",
		"error": {
			"code": model_resolution["error"]["code"],
			"message": model_resolution["error"]["message"],
			"retryable": false
		},
		"model_resolution": model_resolution
	}))
	exit(1)
}
model := model_resolution["model"]
provider["default_model"] = model
messages := [
	create_message("system", dict_get_or(payload, "systemPrompt", "")),
	create_message("user", dict_get_or(payload, "input", ""))
]
options := {
	"model": model,
	"temperature": 0.2,
	"max_tokens": 1600,
	"max_retries": 2,
	"overall_timeout_ms": dict_get_or(payload, "timeoutMs", 45000),
	"max_prompt_characters": 50000,
	"endpoint_allowlist_enabled": true,
	"endpoint_allowlist_hosts": [provider_metadata(provider)["host"]]
}
output_schema := dict_get_or(payload, "outputSchema", null)
if type(output_schema) == "dict" {
	options["structured_output_schema"] = output_schema
}
offline_fixture := dict_get_or(payload, "offlineFixture", false)
if offline_fixture {
	fixture_output := to_json(fixture_value(dict_get_or(payload, "outputSchema", {"type": "object"})))
	options["transport"] = func(url, request_options) {
		return Ok({
			"_status": 200,
			"_body": to_json({
				"id": "tribunal-offline-fixture",
				"choices": [{"message": {"content": fixture_output}, "finish_reason": "stop"}],
				"usage": {"prompt_tokens": 1, "completion_tokens": 1, "total_tokens": 2}
			})
		})
	}
}
api_key := null
if offline_fixture { api_key = "tribunal-offline-fixture" }
client := create_client(provider, api_key)
result := chat_completion(client, messages, options)
result["model_resolution"] = model_resolution
print(to_json(result))
