# Tribunal :: external HSM/KMS signing-provider contract

from src.common import dict_get, last_json_line, parent_dir, read_json, redact, safe_http_url, safe_process_env, safe_relative_path, safe_run_id, write_json
from src.integrity import begin_seal_transaction, finish_seal_transaction, rollback_seal_transaction, seal, signature_payload_for, verify
from src.storage import artifact_path

PROVIDER_SCHEMA := {
    "type": "object",
    "required": ["schemaVersion", "provider", "command", "keyReference", "kujoBin"],
    "properties": {
        "schemaVersion": {"const": "1.0.0"},
        "provider": {"type": "string", "minLength": 1},
        "command": {"type": "string", "minLength": 1},
        "keyReference": {"type": "string", "minLength": 1},
        "kujoBin": {"type": "string", "minLength": 1},
        "timeoutMs": {"type": "integer", "minimum": 1000, "maximum": 120000},
        "protocol": {"enum": ["command-v1", "vault-transit-jwt-v1"]},
        "endpoint": {"type": "string"},
        "jwtRole": {"type": "string"},
        "jwtAuthPath": {"type": "string"},
        "transitPath": {"type": "string"},
        "namespace": {"type": "string"},
        "audience": {"type": "string"},
        "maxAttempts": {"type": "integer", "minimum": 1, "maximum": 5},
        "baseDelayMs": {"type": "integer", "minimum": 10, "maximum": 5000}
    },
    "additionalProperties": false
}

PROVIDER_RESPONSE_SCHEMA := {
    "type": "object",
    "required": ["ok", "algorithm", "keyId", "publicKey", "signature"],
    "properties": {
        "ok": {"const": true},
        "algorithm": {"const": "RSA-PKCS1v15-SHA256"},
        "keyId": {"type": "string", "pattern": "^[a-f0-9]{32}$"},
        "publicKey": {"type": "string", "minLength": 40, "maxLength": 1048576},
        "signature": {"type": "string", "minLength": 40, "maxLength": 1048576},
        "attempts": {"type": "integer", "minimum": 1, "maximum": 15},
        "keyVersion": {"type": "string", "maxLength": 128},
        "auditId": {"type": "string", "maxLength": 512},
        "workloadSubject": {"type": "string", "maxLength": 512}
    },
    "additionalProperties": false
}

export func load_signing_provider(path) {
    if path == "" || file_exists(path) == false { return {"ok": false, "error": "Signing-provider config is missing."} }
    if path_is_symlink(path) { return {"ok": false, "error": "Signing-provider config must not be a symbolic link."} }
    if file_size(path) > 1048576 { return {"ok": false, "error": "Signing-provider config exceeds the 1 MiB safety limit."} }
    config := null
    try { config = read_json(path) } except err { return {"ok": false, "error": "Signing-provider config is invalid JSON."} }
    checked := json_schema_validate(config, PROVIDER_SCHEMA)
    if checked["valid"] != true { return {"ok": false, "error": "Signing-provider config failed validation: " + to_json(checked["errors"])} }
    protocol := dict_get(config, "protocol", "command-v1")
    if protocol == "vault-transit-jwt-v1" {
        endpoint := dict_get(config, "endpoint", "")
        if safe_http_url(endpoint) == false { return {"ok": false, "error": "Vault Transit endpoint must use a valid HTTPS URL outside loopback development."} }
        if contains(endpoint, "@") || contains(endpoint, "?") || contains(endpoint, "#") { return {"ok": false, "error": "Vault Transit endpoint must be a credential-free base URL."} }
        for field in ["jwtRole", "audience"] { if trim(dict_get(config, field, "")) == "" { return {"ok": false, "error": "Vault Transit signing requires " + field + "."} } }
        if trim(dict_get(config, "jwtAuthPath", "jwt")) == "" || trim(dict_get(config, "transitPath", "transit")) == "" { return {"ok": false, "error": "Vault auth and transit paths are required."} }
        if safe_relative_path(dict_get(config, "jwtAuthPath", "jwt")) == false || safe_relative_path(dict_get(config, "transitPath", "transit")) == false || safe_run_id(config["keyReference"]) == false { return {"ok": false, "error": "Vault mount paths or key reference are unsafe."} }
    }
    base := parent_dir(path_absolute(path))
    if starts_with(config["command"], "/") == false { config["command"] := join_path(base, config["command"]) }
    if starts_with(config["kujoBin"], "/") == false { config["kujoBin"] := join_path(base, config["kujoBin"]) }
    if file_exists(config["command"]) == false || path_is_symlink(config["command"]) || file_size(config["command"]) > 16777216 { return {"ok": false, "error": "Signing-provider command is missing, oversized, or unsafe."} }
    if file_exists(config["kujoBin"]) == false || path_is_symlink(config["kujoBin"]) { return {"ok": false, "error": "Signing-provider Kujo runtime is missing or unsafe."} }
    return {"ok": true, "config": config}
}

func provider_environment(request) {
    values := {"TRIBUNAL_SIGNING_REQUEST": to_json(request)}
    # Federated workload identity only. Long-lived cloud secret variables are deliberately excluded.
    for name in ["TRIBUNAL_WORKLOAD_IDENTITY_TOKEN_FILE", "AWS_ROLE_ARN", "AWS_WEB_IDENTITY_TOKEN_FILE", "AWS_REGION", "AWS_DEFAULT_REGION", "AZURE_CLIENT_ID", "AZURE_TENANT_ID", "AZURE_FEDERATED_TOKEN_FILE", "GOOGLE_APPLICATION_CREDENTIALS", "ACTIONS_ID_TOKEN_REQUEST_URL", "ACTIONS_ID_TOKEN_REQUEST_TOKEN"] {
        value := env_or(name, "")
        if value != "" { values[name] := value }
    }
    return safe_process_env(values)
}

export func seal_with_provider(storage_dir, run_id, provider_config) {
    prepared := verify(storage_dir, run_id, "")
    if prepared["ok"] != true {
        unsigned := seal(storage_dir, run_id, "", "")
        if unsigned["ok"] != true { return unsigned }
        prepared = verify(storage_dir, run_id, "")
    }
    manifest_path := artifact_path(storage_dir, run_id, "artifact-manifest.json")
    manifest_text := read_file(manifest_path)
    manifest_hash := sha256(manifest_text)
    signed_at := format_date(now(), "YYYY-MM-DDTHH:mm:ssZ")
    request := {
        "schemaVersion": "1.0.0",
        "operation": "sign",
        "algorithm": "RSA-PKCS1v15-SHA256",
        "runId": run_id,
        "manifestSha256": manifest_hash,
        "signedAt": signed_at,
        "keyReference": provider_config["keyReference"]
    }
    for field in ["protocol", "endpoint", "jwtRole", "jwtAuthPath", "transitPath", "namespace", "audience", "maxAttempts", "baseDelayMs"] {
        if has_key(provider_config, field) == 1 { request[field] := provider_config[field] }
    }
    if file_exists(provider_config["kujoBin"]) == false || file_exists(provider_config["command"]) == false { return {"ok": false, "error": "Signing provider runtime or command is unavailable."} }
    kujo_bin := path_absolute(provider_config["kujoBin"])
    command := path_absolute(provider_config["command"])
    proc := spawn_process([kujo_bin, "run", command, "--interpreter"], {
        "inherit_env": false,
        "env": provider_environment(request),
        "timeout_ms": dict_get(provider_config, "timeoutMs", 60000),
        "max_output_bytes": 1048576
    })
    line := last_json_line(proc.stdout)
    if line == "" { return {"ok": false, "error": "Signing provider returned no JSON: " + redact(proc.stderr)} }
    if proc.success == false { return {"ok": false, "error": "Signing provider process failed: " + redact(proc.stderr)} }
    response := null
    try { response = parse_json(line) } except err { return {"ok": false, "error": "Signing provider returned invalid JSON."} }
    if dict_get(response, "ok", false) != true { return {"ok": false, "error": "Signing provider failed: " + redact(dict_get(response, "error", "unknown error")), "providerEvidence": {"attempts": dict_get(response, "attempts", 0)}} }
    response_contract := json_schema_validate(response, PROVIDER_RESPONSE_SCHEMA)
    if response_contract["valid"] != true { return {"ok": false, "error": "Signing provider response failed validation."} }
    public_key := dict_get(response, "publicKey", "")
    if contains(public_key, "PRIVATE KEY") { return {"ok": false, "error": "Signing provider attempted to return private key material."} }
    if contains(public_key, "PUBLIC KEY") == false { return {"ok": false, "error": "Signing provider returned no usable public key."} }
    key_id := substring(sha256(public_key), 0, 32)
    if dict_get(response, "keyId", "") != key_id { return {"ok": false, "error": "Signing provider key identity is inconsistent."} }
    payload := signature_payload_for("1.2.0", run_id, manifest_hash, key_id, signed_at)
    payload_text := to_json(payload)
    signature := dict_get(response, "signature", "")
    valid := false
    try { valid = rsa_verify(payload_text, signature, public_key) } except err { valid = false }
    if valid != true { return {"ok": false, "error": "Signing provider signature did not verify."} }
    envelope := {
        "schemaVersion": "1.2.0",
        "runId": run_id,
        "algorithm": "RSA-PKCS1v15-SHA256",
        "manifestSha256": manifest_hash,
        "keyId": key_id,
        "signedAt": signed_at,
        "payloadSha256": sha256(payload_text),
        "signature": signature,
        "signingProvider": provider_config["provider"],
        "signerRef": provider_config["keyReference"]
    }
    transaction := begin_seal_transaction(storage_dir, run_id)
    if transaction["ok"] != true { return transaction }
    try { write_json(artifact_path(storage_dir, run_id, "signature.json"), envelope) } except err { rollback_seal_transaction(storage_dir, run_id); return {"ok": false, "error": "Unable to persist external signature."} }
    finish_seal_transaction(storage_dir, run_id)
    provider_evidence := {
        "attempts": dict_get(response, "attempts", 1),
        "keyVersion": dict_get(response, "keyVersion", ""),
        "auditId": dict_get(response, "auditId", ""),
        "workloadSubject": dict_get(response, "workloadSubject", "")
    }
    return {"ok": true, "manifestSha256": manifest_hash, "signature": envelope, "publicKey": public_key, "providerEvidence": provider_evidence}
}
