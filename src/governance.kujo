# Tribunal :: retention, legal hold, and policy-driven whole-run deletion

from src.common import dict_get, ensure_dir, read_json, remove_tree, safe_existing_file, write_json
from src.storage import artifact_path, remove_run_from_index, run_dir
from src.locking import acquire_lock, release_lock

export func governance_metadata(config, actor) {
    policy := config["governance"]
    created_ms := current_timestamp()
    return {
        "schemaVersion": "1.0.0",
        "retentionClass": policy["retention_class"],
        "retentionDays": policy["retention_days"],
        "retainUntilMs": created_ms + policy["retention_days"] * 86400000,
        "legalHold": policy["legal_hold"],
        "owner": policy["owner"],
        "createdBy": actor,
        "createdAt": now_utc()
    }
}

export func deletion_eligibility(storage_dir, run_id, force_expired) {
    path := artifact_path(storage_dir, run_id, "record.json")
    if path == "" || safe_existing_file(path, 4194304, "Run record")["ok"] != true { return {"ok": false, "error": "Run record is missing or unsafe."} }
    record := null
    try { record = read_json(path) } except err { return {"ok": false, "error": "Run record is invalid."} }
    if type(record) != "dict" || dict_get(record, "runId", "") != run_id { return {"ok": false, "error": "Run record identity is invalid."} }
    governance := dict_get(record, "governance", {})
    if type(governance) != "dict" || len(keys(governance)) == 0 { return {"ok": false, "error": "Run has no retention metadata."} }
    if dict_get(governance, "legalHold", false) == true { return {"ok": false, "error": "Run is under legal hold."} }
    hold_path := join_path(join_path(storage_dir, ".governance"), run_id + ".json")
    if file_exists(hold_path) {
        if safe_existing_file(hold_path, 4194304, "External governance record")["ok"] != true { return {"ok": false, "error": "External governance record is unsafe."} }
        hold := null
        try { hold = read_json(hold_path) } except err { return {"ok": false, "error": "External governance record is unreadable."} }
        if type(hold) != "dict" || dict_get(hold, "runId", "") != run_id || type(dict_get(hold, "legalHold", null)) != "bool" { return {"ok": false, "error": "External governance record is invalid."} }
        if dict_get(hold, "legalHold", false) == true { return {"ok": false, "error": "Run is under externally applied legal hold."} }
    }
    if force_expired != true && current_timestamp() < dict_get(governance, "retainUntilMs", 0) { return {"ok": false, "error": "Run retention period has not expired."} }
    return {"ok": true, "record": record, "governance": governance}
}

export func set_legal_hold(storage_dir, run_id, actor, enabled, reason) {
    if trim(actor) == "" || trim(reason) == "" || len(reason) > 4096 { return {"ok": false, "error": "A legal-hold actor and reason of at most 4096 characters are required."} }
    if path_is_dir(run_dir(storage_dir, run_id)) == false { return {"ok": false, "error": "Run does not exist."} }
    locked := acquire_lock(storage_dir, run_id, "legal-hold:" + actor, 300000)
    if locked["ok"] != true { return locked }
    root := join_path(storage_dir, ".governance")
    if file_exists(root) && path_is_symlink(root) { release_lock(storage_dir, run_id, locked["lock"]["token"]); return {"ok": false, "error": "External governance root is unsafe."} }
    ensure_dir(root)
    path := join_path(root, run_id + ".json")
    history := []
    if file_exists(path) {
        try { history = dict_get(read_json(path), "history", []) } except err { release_lock(storage_dir, run_id, locked["lock"]["token"]); return {"ok": false, "error": "External governance record is unreadable."} }
    }
    action := {"actor": actor, "legalHold": enabled, "reason": reason, "changedAt": now_utc()}
    history = push(history, action)
    record := {"schemaVersion": "1.0.0", "runId": run_id, "legalHold": enabled, "updatedAt": action["changedAt"], "updatedBy": actor, "reason": reason, "history": history}
    try { write_json(path, record) } except err { release_lock(storage_dir, run_id, locked["lock"]["token"]); return {"ok": false, "error": "Unable to persist external governance record."} }
    release_lock(storage_dir, run_id, locked["lock"]["token"])
    return {"ok": true, "governance": record, "path": path}
}

export func delete_run(storage_dir, run_id, actor, reason, force_expired) {
    if trim(actor) == "" || trim(reason) == "" || len(reason) > 4096 { return {"ok": false, "error": "A deletion actor and reason of at most 4096 characters are required."} }
    eligible := deletion_eligibility(storage_dir, run_id, force_expired)
    if eligible["ok"] != true { return eligible }
    locked := acquire_lock(storage_dir, run_id, "delete:" + actor, 300000)
    if locked["ok"] != true { return locked }
    eligible = deletion_eligibility(storage_dir, run_id, force_expired)
    if eligible["ok"] != true { release_lock(storage_dir, run_id, locked["lock"]["token"]); return eligible }
    manifest_path := artifact_path(storage_dir, run_id, "artifact-manifest.json")
    signature_path := artifact_path(storage_dir, run_id, "signature.json")
    tombstone := {
        "schemaVersion": "1.0.0",
        "status": "deleting",
        "runId": run_id,
        "actor": actor,
        "reason": reason,
        "deletedAt": now_utc(),
        "recordSha256": sha256(read_file(artifact_path(storage_dir, run_id, "record.json"))),
        "manifestSha256": "",
        "keyId": "",
        "governance": eligible["governance"]
    }
    if file_exists(manifest_path) { tombstone["manifestSha256"] := sha256(read_file(manifest_path)) }
    if file_exists(signature_path) {
        try { tombstone["keyId"] := dict_get(read_json(signature_path), "keyId", "") } except err { tombstone["keyId"] := "" }
    }
    deletion_root := join_path(storage_dir, ".deletions")
    if file_exists(deletion_root) && path_is_symlink(deletion_root) { release_lock(storage_dir, run_id, locked["lock"]["token"]); return {"ok": false, "error": "Deletion registry is unsafe."} }
    ensure_dir(deletion_root)
    tombstone_path := join_path(deletion_root, run_id + ".json")
    if file_exists(tombstone_path) { release_lock(storage_dir, run_id, locked["lock"]["token"]); return {"ok": false, "error": "Deletion tombstone already exists; operator reconciliation is required."} }
    try { write_json(tombstone_path, tombstone) } except err { release_lock(storage_dir, run_id, locked["lock"]["token"]); return {"ok": false, "error": "Unable to persist pre-deletion tombstone."} }
    root := run_dir(storage_dir, run_id)
    remove_tree(root)
    remove_run_from_index(storage_dir, run_id)
    tombstone["status"] := "deleted"
    write_json(tombstone_path, tombstone)
    release_lock(storage_dir, run_id, locked["lock"]["token"])
    return {"ok": true, "tombstone": tombstone}
}
