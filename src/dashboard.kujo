# Tribunal :: offline read-only dashboard export (no network service boundary)

from src.analytics import collect_stats
from src.common import dict_get, ensure_dir, parent_dir, write_text
from src.storage import list_runs_page

func escape(value) {
    text := to_string(value)
    text = replace(text, "&", "&amp;")
    text = replace(text, "<", "&lt;")
    text = replace(text, ">", "&gt;")
    text = replace(text, "\"", "&quot;")
    return text
}

export func export_dashboard(storage_dir, output) {
    stats := collect_stats(storage_dir)
    page := list_runs_page(storage_dir, "", "", 500, "")
    rows := ""
    for run in page["items"] {
        rows = rows + "<tr><td>" + escape(dict_get(run, "runId", "")) + "</td><td>" + escape(dict_get(run, "status", "")) + "</td><td>" + escape(dict_get(run, "panelId", "")) + "</td><td>" + escape(dict_get(run, "openedAt", "")) + "</td></tr>"
    }
    html := "<!doctype html><html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><meta http-equiv=\"Content-Security-Policy\" content=\"default-src 'none'; style-src 'unsafe-inline'; img-src data:; base-uri 'none'; form-action 'none'\"><title>Tribunal Evidence Dashboard</title><style>body{font:16px system-ui;background:#0b1020;color:#edf2ff;margin:2rem;line-height:1.5}main{max-width:1100px;margin:auto}.cards{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:1rem}.card,table{background:#151d33;border:1px solid #34415f;border-radius:.6rem}.card{padding:1rem}.value{font-size:2rem;font-weight:700}table{width:100%;border-collapse:collapse;margin-top:2rem;overflow:hidden}th,td{text-align:left;padding:.7rem;border-bottom:1px solid #34415f}th{color:#9fc2ff}caption{text-align:left;font-size:1.4rem;font-weight:700;margin-bottom:.6rem}</style></head><body><main><h1>Tribunal Evidence Dashboard</h1><p>Offline, read-only projection. Source run evidence remains sealed and unchanged.</p><section class=\"cards\"><div class=\"card\"><div>Runs</div><div class=\"value\">" + to_string(stats["runs"]) + "</div></div><div class=\"card\"><div>Completed</div><div class=\"value\">" + to_string(stats["completed"]) + "</div></div><div class=\"card\"><div>Stopped</div><div class=\"value\">" + to_string(stats["stopped"]) + "</div></div><div class=\"card\"><div>Invocations</div><div class=\"value\">" + to_string(stats["modelInvocations"]) + "</div></div></section><table><caption>Recent runs</caption><thead><tr><th>Run ID</th><th>Status</th><th>Panel</th><th>Opened</th></tr></thead><tbody>" + rows + "</tbody></table></main></body></html>"
    ensure_dir(parent_dir(output))
    write_text(output, html)
    return {"ok": true, "path": path_absolute(output), "runsRendered": len(page["items"]), "truncated": page["hasMore"]}
}
