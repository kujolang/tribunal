# Tribunal :: offline read-only dashboard export (no network service boundary)

from src.analytics import collect_stats
from src.common import dict_get, ensure_dir, external_path_outside, parent_dir, write_text
from src.storage import list_runs_page

func escape(value) {
    text := to_string(value)
    text = replace(text, "&", "&amp;")
    text = replace(text, "<", "&lt;")
    text = replace(text, ">", "&gt;")
    text = replace(text, "\"", "&quot;")
    return text
}

export func export_dashboard(storage_dir, output) {
    if trim(output) == "" { return {"ok": false, "error": "Dashboard output is required."} }
    if external_path_outside(storage_dir, output) == false { return {"ok": false, "error": "Dashboard output must be outside Tribunal run storage without symbolic-link aliases."} }
    if file_exists(output) || path_is_dir(output) { return {"ok": false, "error": "Dashboard output already exists; refusing to overwrite it."} }
    stats := collect_stats(storage_dir)
    page := list_runs_page(storage_dir, "", "", 100, "")
    rows := ""
    for run in page["items"] {
        rows = rows + "<tr><td>" + escape(dict_get(run, "runId", "")) + "</td><td>" + escape(dict_get(run, "status", "")) + "</td><td>" + escape(dict_get(run, "panelId", "")) + "</td><td>" + escape(dict_get(run, "openedAt", "")) + "</td></tr>"
    }
    continuation := ""
    if page["hasMore"] { continuation = "<p>Showing 100 runs. Continue with cursor <code>" + escape(page["nextCursor"]) + "</code> through the CLI or library API.</p>" }
    html := "<!doctype html><html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><meta name=\"color-scheme\" content=\"dark\"><meta http-equiv=\"Content-Security-Policy\" content=\"default-src 'none'; style-src 'unsafe-inline'; img-src data:; base-uri 'none'; form-action 'none'\"><title>Tribunal Evidence Dashboard</title><style>body{font:16px system-ui;background:#0b1020;color:#f5f7ff;margin:0;line-height:1.6}main{max-width:1100px;margin:auto;padding:2rem}.skip{position:absolute;left:-10000px;background:#fff;color:#000;padding:.75rem}.skip:focus{left:1rem;top:1rem;z-index:2}.cards{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:1rem;padding:0}.card,table{background:#151d33;border:2px solid #52658d;border-radius:.6rem}.card{padding:1rem;list-style:none}.card dd{font-size:2rem;font-weight:700;margin:0}.table-wrap{overflow-x:auto}table{width:100%;border-collapse:collapse;margin-top:2rem}th,td{text-align:left;padding:.7rem;border-bottom:1px solid #52658d}th{color:#c8dcff}caption{text-align:left;font-size:1.4rem;font-weight:700;margin-bottom:.6rem}code{color:#d4e5ff}</style></head><body><a class=\"skip\" href=\"#runs\">Skip to recent runs</a><main><h1>Tribunal Evidence Dashboard</h1><p>Offline, read-only projection. Source run evidence remains sealed and unchanged.</p><dl class=\"cards\" aria-label=\"Hearing totals\"><div class=\"card\"><dt>Runs</dt><dd>" + to_string(stats["runs"]) + "</dd></div><div class=\"card\"><dt>Completed</dt><dd>" + to_string(stats["completed"]) + "</dd></div><div class=\"card\"><dt>Stopped</dt><dd>" + to_string(stats["stopped"]) + "</dd></div><div class=\"card\"><dt>Invocations</dt><dd>" + to_string(stats["modelInvocations"]) + "</dd></div></dl><div class=\"table-wrap\" tabindex=\"0\" role=\"region\" aria-label=\"Recent runs, horizontally scrollable on small screens\"><table id=\"runs\"><caption>Recent runs</caption><thead><tr><th scope=\"col\">Run ID</th><th scope=\"col\">Status</th><th scope=\"col\">Panel</th><th scope=\"col\">Opened</th></tr></thead><tbody>" + rows + "</tbody></table></div>" + continuation + "<footer><p>Generated by Tribunal. No scripts, forms, or network requests are present.</p></footer></main></body></html>"
    ensure_dir(parent_dir(output))
    write_text(output, html)
    return {"ok": true, "path": path_absolute(output), "runsRendered": len(page["items"]), "pageLimit": 100, "truncated": page["hasMore"], "nextCursor": page["nextCursor"]}
}
