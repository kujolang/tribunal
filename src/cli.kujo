func command_error(message, code) {
    eprint("tribunal: " + message)
    return code
}

func allowed_options(parsed, command) {
    global := ["help", "config", "storage-dir", "ai-sdk-path", "kujo-bin", "provider", "context-provider", "packwrite-path", "offline-fixture", "model-timeout-ms", "identity", "access-policy"]
    command_options := {
        "review": ["panel", "mock", "live", "private-key", "public-key"],
        "resume": ["private-key", "public-key"],
        "compare": ["output"],
        "re-review": ["panel", "output", "mock", "live", "private-key", "public-key"],
        "kill": ["mock", "live", "private-key", "public-key"],
        "validate": ["json"],
        "list": ["status", "panel", "limit", "cursor", "json"],
        "show": ["json"],
        "replay": ["public-key", "require-signature"],
        "keys": ["private-key", "public-key", "bits"],
        "seal": ["private-key", "public-key"],
        "verify": ["public-key", "require-signature"],
        "verify-bulk": ["cursor", "limit", "public-key", "require-signature", "json"],
        "ingest": ["target", "public-key", "runledger-path", "ledger", "casefile-path", "casefile-output"],
        "export": ["format"],
        "panels": ["json"],
        "seats": ["json"],
        "doctor": ["json"],
        "stats": ["json"],
        "contracts": ["json"],
        "audit": ["public-key", "trust-policy", "target", "require-signature", "json"],
        "seal-provider": ["provider-config"],
        "verify-policy": ["trust-policy", "target"],
        "bundle-export": ["output"],
        "bundle-import": ["trust-policy", "target"],
        "bundle-encrypt": ["output", "recipient-public-key", "recovery-public-key"],
        "bundle-decrypt": ["recipient-private-key", "trust-policy", "target"],
        "bundle-rekey": ["recipient-private-key", "recipient-public-key"],
        "store-publish": ["expected-version"],
        "store-pull": ["version", "trust-policy", "target"],
        "telemetry-export": ["collector", "destination", "json"],
        "locks-recover": ["stale-after-ms", "json"],
        "index-check": ["json"],
        "index-rebuild": ["json"],
        "index-repair": ["json"],
        "delete": ["reason", "force-expired"],
        "auth-check": ["permission", "json"],
        "dashboard-export": ["output", "json"],
        "legal-hold": ["enable", "release", "reason"],
        "provenance-sign": ["kind", "sequence", "private-key", "public-key", "output", "anchor", "previous"],
        "provenance-verify": ["provenance", "public-key", "anchor"],
        "version": []
    }
    allowed := global
    if has_key(command_options, command) == 1 {
        for option in command_options[command] { allowed = push(allowed, option) }
    }
    for key in keys(parsed["flags"]) {
        if array_includes(allowed, key) == false { return "Unknown option '--" + key + "' for " + command + "." }
    }
    if has_flag(parsed, "mock") && has_flag(parsed, "live") { return "--mock and --live are mutually exclusive." }
    return ""
}

func validate_cli(command, parsed) {
    errors := dict_get(parsed, "errors", [])
    if len(errors) > 0 { return errors[0] }
    return allowed_options(parsed, command)
}

func require_positionals(parsed, exact, usage) {
    if len(parsed["positionals"]) != exact { return usage }
    return ""
}

func config_for(parsed) {
    loaded := load_config(flag(parsed, "config", ""))
    if loaded["ok"] != true { return loaded }
    config := apply_overrides(loaded["config"], parsed)
    error := validate_config(config)
    if error != "" { return {"ok": false, "error": error} }
    return {"ok": true, "config": config}
}

func command_permission(command) {
    mapping := {
        "review": "runs.create", "kill": "runs.create", "resume": "runs.create", "re-review": "runs.create", "compare": "runs.read", "validate": "runs.create",
        "list": "runs.list", "show": "runs.read", "replay": "runs.read", "export": "runs.read",
        "panels": "catalog.read", "seats": "catalog.read", "stats": "runs.read", "doctor": "system.diagnose",
        "keys": "keys.generate", "seal": "runs.sign", "seal-provider": "runs.sign", "verify": "runs.verify", "verify-bulk": "runs.verify", "verify-policy": "runs.verify",
        "ingest": "runs.ingest", "contracts": "contracts.validate", "audit": "runs.audit", "bundle-export": "bundles.export", "bundle-import": "bundles.import", "bundle-encrypt": "bundles.export", "bundle-decrypt": "bundles.import", "bundle-rekey": "bundles.rekey",
        "store-publish": "store.publish", "store-pull": "store.pull", "telemetry-export": "telemetry.export",
        "locks-recover": "locks.recover", "index-check": "runs.index.verify", "index-rebuild": "runs.index.rebuild", "index-repair": "runs.index.repair", "delete": "runs.delete", "auth-check": "authorization.inspect", "version": "system.version",
        "dashboard-export": "dashboard.export", "legal-hold": "governance.hold", "provenance-sign": "governance.sign", "provenance-verify": "governance.verify"
    }
    return dict_get(mapping, command, "unknown")
}

func authorize_command(config, command) {
    authorization := config["authorization"]
    identity := authorization["identity"]
    permission := command_permission(command)
    if authorization["mode"] == "local" {
        if identity != "local-operator" { return {"ok": false, "error": "Local authorization accepts only the local-operator identity."} }
        return {"ok": true, "identity": identity, "role": "local-administrator", "permission": permission}
    }
    loaded := load_access_policy(authorization["policy_path"])
    if loaded["ok"] != true { return loaded }
    return authorize(loaded["policy"], identity, permission)
}

func required_run(parsed) {
    return positional(parsed, 0, "")
}

func cmd_review(command, parsed, config) {
    usage_error := require_positionals(parsed, 1, "Usage: tribunal " + command + " <file>")
    if usage_error != "" { return command_error(usage_error, 2) }
    file := positional(parsed, 0, "")
    if file == "" { return command_error("Usage: tribunal " + command + " <file>", 2) }
    panel_id := flag(parsed, "panel", config["tribunal"]["default_panel"])
    if command == "kill" { panel_id = "executioner-only" }
    result := review(config, file, panel_id, flag(parsed, "private-key", ""), flag(parsed, "public-key", ""))
    if result["ok"] != true {
        if has_key(result, "runId") == 1 {
            print("Tribunal stopped: " + result["error"])
            print("Run: " + result["runId"])
            print("Record: " + result["runDir"])
            return 2
        }
        return command_error(result["error"], 1)
    }
    ruling := result["record"]["ruling"]
    print(result["runId"])
    print(ruling["disposition"] + ": " + ruling["finalVerdict"])
    print(result["runDir"])
    return 0
}

func cmd_validate(parsed, config) {
    usage_error := require_positionals(parsed, 1, "Usage: tribunal validate <file>")
    if usage_error != "" { return command_error(usage_error, 2) }
    result := validate_docket(config, positional(parsed, 0, ""))
    if has_flag(parsed, "json") { print(to_json_pretty(result)) }
    else if result["ok"] { print("valid\t" + result["docket"]["id"] + "\t" + result["docket"]["title"]) }
    else { eprint("invalid\t" + result["error"]) }
    if result["ok"] { return 0 }
    return 1
}

func cmd_resume(parsed, config) {
    usage_error := require_positionals(parsed, 1, "Usage: tribunal resume <stopped-run-id>")
    if usage_error != "" { return command_error(usage_error, 2) }
    result := resume(config, positional(parsed, 0, ""), flag(parsed, "private-key", ""), flag(parsed, "public-key", ""))
    if result["ok"] != true { return command_error(result["error"], 1) }
    print(to_json_pretty({"runId": result["runId"], "priorRunId": result["record"]["lineage"]["priorRunId"], "runDir": result["runDir"]}))
    return 0
}

func cmd_compare(parsed, config) {
    usage_error := require_positionals(parsed, 2, "Usage: tribunal compare <base-run-id> <candidate-run-id> --output <prefix>")
    if usage_error != "" || flag(parsed, "output", "") == "" { return command_error("Usage: tribunal compare <base-run-id> <candidate-run-id> --output <prefix>", 2) }
    result := compare_rulings(config["tribunal"]["storage_dir"], positional(parsed, 0, ""), positional(parsed, 1, ""), flag(parsed, "output", ""))
    if result["ok"] != true { return command_error(result["error"], 1) }
    print(to_json_pretty(result)); return 0
}

func cmd_re_review(parsed, config) {
    usage_error := require_positionals(parsed, 2, "Usage: tribunal re-review <base-run-id> <file> --panel <panel-name> --output <prefix>")
    if usage_error != "" || flag(parsed, "output", "") == "" { return command_error("Usage: tribunal re-review <base-run-id> <file> --panel <panel-name> --output <prefix>", 2) }
    result := re_review(config, positional(parsed, 0, ""), positional(parsed, 1, ""), flag(parsed, "panel", config["tribunal"]["default_panel"]), flag(parsed, "private-key", ""), flag(parsed, "public-key", ""), flag(parsed, "output", ""))
    if result["ok"] != true { return command_error(result["error"], 1) }
    print(to_json_pretty({"runId": result["runId"], "comparison": result["comparison"]["jsonPath"]})); return 0
}

func cmd_list(parsed, config) {
    limit := 100
    if has_flag(parsed, "limit") {
        try { limit = to_int(flag(parsed, "limit", "0")) } except err { limit = -1 }
        if limit < 1 || limit > 10000 { return command_error("--limit must be between 1 and 10000.", 2) }
    }
    page := list_runs_page(config["tribunal"]["storage_dir"], flag(parsed, "status", ""), flag(parsed, "panel", ""), limit, flag(parsed, "cursor", ""))
    if page["cursorFound"] != true { return command_error("List cursor was not found.", 2) }
    runs := page["items"]
    if has_flag(parsed, "json") { print(to_json_pretty(page)); return 0 }
    if len(runs) == 0 { print("No Tribunal runs found."); return 0 }
    for run in runs {
        print(run["runId"] + "\t" + run["status"] + "\t" + run["panelId"] + "\t" + run["openedAt"])
    }
    if page["hasMore"] { print("next-cursor\t" + page["nextCursor"]) }
    return 0
}

func cmd_show(parsed, config) {
    run_id := required_run(parsed)
    if run_id == "" { return command_error("show requires a run ID.", 2) }
    record := load_record(config["tribunal"]["storage_dir"], run_id)
    if type(record) != "dict" { return command_error("No such run: " + run_id, 1) }
    if has_flag(parsed, "json") { print(to_json_pretty(record)) } else { print(summary(record)) }
    return 0
}

func cmd_replay(parsed, config) {
    run_id := required_run(parsed)
    if run_id == "" { return command_error("replay requires a run ID.", 2) }
    checked := verify(config["tribunal"]["storage_dir"], run_id, flag(parsed, "public-key", ""))
    if has_flag(parsed, "require-signature") && checked["signature"] != "verified" {
        checked["ok"] := false
        checked["errors"] := push(checked["errors"], "A verified signature is required.")
    }
    if checked["ok"] != true { return command_error("Replay verification failed: " + to_json(checked), 3) }
    print("integrity\t" + to_string(checked["artifactsChecked"]) + " artifacts\t" + checked["signature"])
    events := load_events(config["tribunal"]["storage_dir"], run_id)
    for event in events { print(event["timestamp"] + "\t" + event["stageId"] + "\t" + dict_get(event, "seatId", "-") + "\t" + event["eventType"] + "\t" + event["summary"]) }
    return 0
}

func cmd_keys(parsed, config) {
    bits := 4096
    try { bits = to_int(flag(parsed, "bits", "4096")) } except err { bits = 0 }
    private_path := flag(parsed, "private-key", "")
    public_path := flag(parsed, "public-key", "")
    if path_within(config["tribunal"]["storage_dir"], private_path) || path_within(config["tribunal"]["storage_dir"], public_path) { return command_error("Key outputs must be outside Tribunal run storage.", 2) }
    created := generate_keys(private_path, public_path, bits)
    if created["ok"] != true { return command_error(created["error"], 2) }
    print(to_json_pretty(created))
    return 0
}

func cmd_seal(parsed, config) {
    run_id := required_run(parsed)
    if run_id == "" { return command_error("seal requires a run ID.", 2) }
    result := seal(config["tribunal"]["storage_dir"], run_id, flag(parsed, "private-key", ""), flag(parsed, "public-key", ""))
    if result["ok"] != true { return command_error(result["error"], 1) }
    print(to_json_pretty({"runId": run_id, "artifacts": len(result["manifest"]["artifacts"]), "keyId": dict_get(dict_get(result, "signature", {}), "keyId", ""), "manifestSha256": dict_get(dict_get(result, "signature", {}), "manifestSha256", "")}))
    return 0
}

func cmd_verify(parsed, config) {
    run_id := required_run(parsed)
    if run_id == "" { return command_error("verify requires a run ID.", 2) }
    result := verify(config["tribunal"]["storage_dir"], run_id, flag(parsed, "public-key", ""))
    if has_flag(parsed, "require-signature") && result["signature"] != "verified" {
        result["ok"] := false
        result["errors"] := push(result["errors"], "A verified signature is required.")
    }
    print(to_json_pretty(result))
    if result["ok"] { return 0 }
    return 3
}

func cmd_verify_bulk(parsed, config) {
    limit := 25
    try { limit = to_int(flag(parsed, "limit", "25")) } except err { limit = 0 }
    if limit < 1 || limit > 100 { return command_error("verify-bulk --limit must be between 1 and 100.", 2) }
    result := verify_runs_page(config["tribunal"]["storage_dir"], flag(parsed, "cursor", ""), limit, flag(parsed, "public-key", ""), has_flag(parsed, "require-signature"))
    print(to_json_pretty(result))
    if has_key(result, "error") == 1 { return 2 }
    if result["ok"] { return 0 }
    return 3
}

func cmd_ingest(parsed, config) {
    run_id := required_run(parsed)
    target := flag(parsed, "target", "")
    public_key := flag(parsed, "public-key", "")
    if run_id == "" || public_key == "" { return command_error("ingest requires a run ID and --public-key.", 2) }
    home := path_absolute(env_or("TRIBUNAL_HOME", "."))
    result := null
    if target == "runledger" {
        ledger_path := flag(parsed, "ledger", "./.runledger")
        if path_within(config["tribunal"]["storage_dir"], ledger_path) { return command_error("RunLedger output must be outside Tribunal run storage.", 2) }
        result = ingest_runledger(config["tribunal"]["storage_dir"], run_id, {
            "public_key": public_key,
            "kujo_bin": config["kujo_ai"]["kujo_bin"],
            "runledger_path": flag(parsed, "runledger-path", join_path(home, "../runledger/runledger.kujo")),
            "ledger": ledger_path
        })
    } else if target == "casefile" {
        casefile_output := flag(parsed, "casefile-output", "./.casefile")
        if path_within(config["tribunal"]["storage_dir"], casefile_output) { return command_error("CaseFile output must be outside Tribunal run storage.", 2) }
        result = ingest_casefile(config["tribunal"]["storage_dir"], run_id, {
            "public_key": public_key,
            "kujo_bin": config["kujo_ai"]["kujo_bin"],
            "casefile_path": flag(parsed, "casefile-path", join_path(home, "../casefile/casefile.kujo")),
            "output_dir": casefile_output
        })
    } else {
        return command_error("Ingestion target must be runledger or casefile.", 2)
    }
    if result["ok"] != true { return command_error(result["error"], 1) }
    print(to_json_pretty(result["receipt"]))
    return 0
}

func cmd_export(parsed, config) {
    run_id := required_run(parsed)
    format := flag(parsed, "format", "json")
    if run_id == "" { return command_error("export requires a run ID.", 2) }
    if format == "json" {
        record := load_record(config["tribunal"]["storage_dir"], run_id)
        if type(record) != "dict" { return command_error("No such run: " + run_id, 1) }
        print(to_json_pretty(record))
        return 0
    }
    if format == "jsonl" {
        for event in load_events(config["tribunal"]["storage_dir"], run_id) { print(to_json(event)) }
        return 0
    }
    return command_error("Export format must be json or jsonl.", 2)
}

func cmd_panels(parsed) {
    if has_flag(parsed, "json") { print(to_json_pretty(PANELS)); return 0 }
    for id in sort(keys(PANELS)) {
        value := PANELS[id]
        print(value["id"] + "\t" + join(value["seatIds"], ",") + "\t" + value["description"])
    }
    return 0
}

func cmd_seats(parsed) {
    if has_flag(parsed, "json") { print(to_json_pretty(SEATS)); return 0 }
    for id in sort(keys(SEATS)) {
        value := SEATS[id]
        print(value["id"] + "\t" + value["name"] + "\t" + value["authority"])
    }
    return 0
}

func cmd_doctor(parsed, config) {
    result := doctor(config, path_absolute(env_or("TRIBUNAL_HOME", ".")))
    if has_flag(parsed, "json") { print(to_json_pretty(result)) }
    else {
        for check in result["checks"] { print(check["status"] + "\t" + check["name"] + "\t" + check["message"]) }
        print("failures=" + to_string(result["failures"]) + " warnings=" + to_string(result["warnings"]))
    }
    if result["ok"] { return 0 }
    return 1
}

func cmd_stats(parsed, config) {
    result := collect_stats(config["tribunal"]["storage_dir"])
    if has_flag(parsed, "json") { print(to_json_pretty(result)) }
    else {
        print("runs\t" + to_string(result["runs"]))
        print("completed\t" + to_string(result["completed"]))
        print("stopped\t" + to_string(result["stopped"]))
        print("model invocations\t" + to_string(result["modelInvocations"]))
        print("total tokens\t" + to_string(result["totalTokens"]))
        print("average duration ms\t" + to_string(result["averageDurationMs"]))
    }
    return 0
}

func cmd_contracts(parsed, config) {
    result := validate_run_contracts(path_absolute(env_or("TRIBUNAL_HOME", ".")), config["tribunal"]["storage_dir"], required_run(parsed))
    print(to_json_pretty(result))
    if result["ok"] { return 0 }
    return 3
}

func cmd_audit(parsed, config) {
    trust_policy := null
    if has_flag(parsed, "public-key") && has_flag(parsed, "trust-policy") { return command_error("audit accepts either --public-key or --trust-policy, not both.", 2) }
    if has_flag(parsed, "trust-policy") {
        loaded := load_trust_policy(flag(parsed, "trust-policy", ""))
        if loaded["ok"] != true { return command_error(loaded["error"], 2) }
        trust_policy = loaded["policy"]
    }
    target := flag(parsed, "target", "audit")
    report := audit_run(path_absolute(env_or("TRIBUNAL_HOME", ".")), config["tribunal"]["storage_dir"], required_run(parsed), flag(parsed, "public-key", ""), has_flag(parsed, "require-signature"), trust_policy, target)
    if has_flag(parsed, "json") { print(to_json_pretty(report)) }
    else {
        status := "fail"
        if report["ok"] { status = "pass" }
        print(status + "\t" + report["runId"] + "\tintegrity=" + to_string(report["integrity"]["ok"]) + "\tcontracts=" + to_string(report["contracts"]["ok"]) + "\ttrust=" + to_string(report["trust"]["ok"]))
    }
    if report["ok"] { return 0 }
    return 3
}

func cmd_seal_provider(parsed, config) {
    loaded := load_signing_provider(flag(parsed, "provider-config", ""))
    if loaded["ok"] != true { return command_error(loaded["error"], 2) }
    result := seal_with_provider(config["tribunal"]["storage_dir"], required_run(parsed), loaded["config"])
    if result["ok"] != true { return command_error(result["error"], 1) }
    output := result
    if has_key(output, "publicKey") == 1 { output["publicKey"] := "[returned separately; not persisted]" }
    print(to_json_pretty(output))
    return 0
}

func cmd_verify_policy(parsed, config) {
    loaded := load_trust_policy(flag(parsed, "trust-policy", ""))
    if loaded["ok"] != true { return command_error(loaded["error"], 2) }
    run_id := required_run(parsed)
    signature_path := artifact_path(config["tribunal"]["storage_dir"], run_id, "signature.json")
    if signature_path == "" || file_exists(signature_path) == false || path_is_symlink(signature_path) || file_size(signature_path) > 4194304 { return command_error("Signature envelope is missing or unsafe.", 3) }
    envelope := null
    try { envelope = parse_json(read_file(signature_path)) } except err { return command_error("Signature envelope is invalid JSON.", 3) }
    trusted := trusted_key(loaded["policy"], dict_get(envelope, "keyId", ""), flag(parsed, "target", "verify"), current_timestamp())
    if trusted["ok"] != true { print(to_json_pretty(trusted)); return 3 }
    result := verify(config["tribunal"]["storage_dir"], run_id, trusted["key"]["publicKeyPath"])
    result["trustPolicy"] := loaded["path"]
    print(to_json_pretty(result))
    if result["ok"] && result["signature"] == "verified" { return 0 }
    return 3
}

func cmd_bundle_export(parsed, config) {
    result := export_bundle(config["tribunal"]["storage_dir"], required_run(parsed), flag(parsed, "output", ""))
    if result["ok"] != true { return command_error(result["error"], 1) }
    print(to_json_pretty(result))
    return 0
}

func cmd_bundle_import(parsed, config) {
    loaded := load_trust_policy(flag(parsed, "trust-policy", ""))
    if loaded["ok"] != true { return command_error(loaded["error"], 2) }
    result := import_bundle(required_run(parsed), config["tribunal"]["storage_dir"], loaded["policy"], flag(parsed, "target", "bundle-import"))
    if result["ok"] != true { return command_error(dict_get(result, "error", "Bundle import failed."), 3) }
    print(to_json_pretty(result))
    return 0
}

func cmd_bundle_encrypt(parsed, config) {
    output := flag(parsed, "output", "")
    recipient := flag(parsed, "recipient-public-key", "")
    if output == "" || recipient == "" { return command_error("bundle-encrypt requires --output and --recipient-public-key.", 2) }
    result := export_encrypted_bundle(config["tribunal"]["storage_dir"], required_run(parsed), output, recipient, flag(parsed, "recovery-public-key", ""))
    if result["ok"] != true { return command_error(result["error"], 1) }
    print(to_json_pretty(result)); return 0
}

func cmd_bundle_decrypt(parsed, config) {
    loaded := load_trust_policy(flag(parsed, "trust-policy", ""))
    if loaded["ok"] != true { return command_error(loaded["error"], 2) }
    private_key := flag(parsed, "recipient-private-key", "")
    if private_key == "" { return command_error("bundle-decrypt requires --recipient-private-key.", 2) }
    result := import_encrypted_bundle(required_run(parsed), config["tribunal"]["storage_dir"], loaded["policy"], flag(parsed, "target", "bundle-import"), private_key)
    if result["ok"] != true { return command_error(dict_get(result, "error", "Encrypted bundle import failed."), 3) }
    print(to_json_pretty(result)); return 0
}

func cmd_bundle_rekey(parsed, config) {
    private_key := flag(parsed, "recipient-private-key", "")
    public_key := flag(parsed, "recipient-public-key", "")
    if private_key == "" || public_key == "" { return command_error("bundle-rekey requires --recipient-private-key and --recipient-public-key.", 2) }
    result := rotate_encrypted_bundle_key(required_run(parsed), private_key, public_key)
    if result["ok"] != true { return command_error(result["error"], 1) }
    print(to_json_pretty(result)); return 0
}

func cmd_store_publish(parsed, config) {
    store := config["artifact_store"]
    result := null
    if store["provider"] == "local-immutable" {
        result = publish_local(config["tribunal"]["storage_dir"], required_run(parsed), store["root"], flag(parsed, "expected-version", ""))
    } else {
        result = publish_http(config["tribunal"]["storage_dir"], required_run(parsed), store, flag(parsed, "expected-version", ""))
    }
    if result["ok"] != true { return command_error(result["error"], 1) }
    print(to_json_pretty(result))
    return 0
}

func cmd_store_pull(parsed, config) {
    loaded := load_trust_policy(flag(parsed, "trust-policy", ""))
    if loaded["ok"] != true { return command_error(loaded["error"], 2) }
    result := null
    if config["artifact_store"]["provider"] == "local-immutable" {
        result = pull_local(config["artifact_store"]["root"], required_run(parsed), flag(parsed, "version", ""), config["tribunal"]["storage_dir"], loaded["policy"], flag(parsed, "target", "store-pull"))
    } else {
        result = pull_http(config["artifact_store"], required_run(parsed), flag(parsed, "version", ""), config["tribunal"]["storage_dir"], loaded["policy"], flag(parsed, "target", "store-pull"))
    }
    if result["ok"] != true { return command_error(dict_get(result, "error", "Artifact-store pull failed."), 3) }
    print(to_json_pretty(result))
    return 0
}

func cmd_telemetry_export(parsed, config) {
    result := export_telemetry(config["tribunal"]["storage_dir"], flag(parsed, "collector", config["telemetry"]["collector"]), flag(parsed, "destination", config["telemetry"]["destination"]))
    print(to_json_pretty(result))
    if result["ok"] { return 0 }
    return 1
}

func cmd_locks_recover(parsed, config) {
    stale := 300000
    if has_flag(parsed, "stale-after-ms") { try { stale = to_int(flag(parsed, "stale-after-ms", "")) } except err { stale = 0 } }
    if stale < 1000 { return command_error("--stale-after-ms must be at least 1000.", 2) }
    result := recover_stale_locks(config["tribunal"]["storage_dir"], stale)
    seal_recovery := recover_seal_transactions(config["tribunal"]["storage_dir"])
    result["sealTransactions"] := dict_get(seal_recovery, "recovered", [])
    if seal_recovery["ok"] != true { result["ok"] := false; result["sealTransactionError"] := seal_recovery["error"] }
    print(to_json_pretty(result))
    if result["ok"] { return 0 }
    return 3
}

func cmd_index(command, parsed, config) {
    result := verify_run_index(config["tribunal"]["storage_dir"])
    if command == "index-rebuild" { result = rebuild_run_index(config["tribunal"]["storage_dir"]); if result["ok"] { result["verification"] := verify_run_index(config["tribunal"]["storage_dir"]) } }
    if command == "index-repair" { result = repair_run_index(config["tribunal"]["storage_dir"]) }
    print(to_json_pretty(result))
    if result["ok"] { return 0 }
    return 3
}

func cmd_delete(parsed, config) {
    result := delete_run(config["tribunal"]["storage_dir"], required_run(parsed), config["authorization"]["identity"], flag(parsed, "reason", ""), has_flag(parsed, "force-expired"))
    if result["ok"] != true { return command_error(result["error"], 1) }
    print(to_json_pretty(result))
    return 0
}

func cmd_auth_check(parsed, config) {
    permission := flag(parsed, "permission", "")
    if permission == "" { return command_error("auth-check requires --permission.", 2) }
    authorization := config["authorization"]
    result := null
    if authorization["mode"] == "local" {
        result = {"ok": authorization["identity"] == "local-operator", "identity": authorization["identity"], "role": "local-administrator", "permission": permission}
    } else {
        loaded := load_access_policy(authorization["policy_path"])
        if loaded["ok"] != true { return command_error(loaded["error"], 2) }
        result = authorize(loaded["policy"], authorization["identity"], permission)
    }
    print(to_json_pretty(result))
    if result["ok"] { return 0 }
    return 3
}

func cmd_dashboard_export(parsed, config) {
    output := flag(parsed, "output", "")
    if output == "" { return command_error("dashboard-export requires --output.", 2) }
    result := export_dashboard(config["tribunal"]["storage_dir"], output)
    print(to_json_pretty(result))
    if result["ok"] { return 0 }
    return 1
}

func cmd_legal_hold(parsed, config) {
    if has_flag(parsed, "enable") == has_flag(parsed, "release") { return command_error("legal-hold requires exactly one of --enable or --release.", 2) }
    result := set_legal_hold(config["tribunal"]["storage_dir"], required_run(parsed), config["authorization"]["identity"], has_flag(parsed, "enable"), flag(parsed, "reason", ""))
    if result["ok"] != true { return command_error(result["error"], 1) }
    print(to_json_pretty(result))
    return 0
}

func cmd_provenance_sign(parsed) {
    sequence := 0
    try { sequence = to_int(flag(parsed, "sequence", "0")) } except err { sequence = 0 }
    result := sign_provenance(required_run(parsed), flag(parsed, "kind", ""), sequence, flag(parsed, "previous", ""), flag(parsed, "private-key", ""), flag(parsed, "public-key", ""), flag(parsed, "output", ""), flag(parsed, "anchor", ""))
    if result["ok"] != true { return command_error(result["error"], 1) }
    print(to_json_pretty(result)); return 0
}

func cmd_provenance_verify(parsed) {
    result := verify_provenance(required_run(parsed), flag(parsed, "provenance", ""), flag(parsed, "public-key", ""), flag(parsed, "anchor", ""))
    print(to_json_pretty(result))
    if result["ok"] { return 0 }
    return 3
}

export func main(argv) {
    command := "help"
    if len(argv) > 0 { command = argv[0] }
    parsed := parse_args(slice_from(argv, 1), ["help", "mock", "live", "offline-fixture", "json", "require-signature", "force-expired", "enable", "release"])
    if command == "help" || command == "--help" || has_flag(parsed, "help") { help(); return 0 }
    if command == "--version" { command = "version" }
    known := ["version", "panels", "seats", "keys", "review", "kill", "resume", "compare", "re-review", "validate", "list", "show", "replay", "seal", "verify", "verify-bulk", "ingest", "export", "doctor", "stats", "contracts", "audit", "seal-provider", "verify-policy", "bundle-export", "bundle-import", "bundle-encrypt", "bundle-decrypt", "bundle-rekey", "store-publish", "store-pull", "telemetry-export", "locks-recover", "index-check", "index-rebuild", "index-repair", "delete", "auth-check", "dashboard-export", "legal-hold", "provenance-sign", "provenance-verify"]
    if array_includes(known, command) == false { return command_error("Unknown command '" + command + "'. Run tribunal help.", 2) }
    cli_error := validate_cli(command, parsed)
    if cli_error != "" { return command_error(cli_error, 2) }
    if array_includes(["review", "kill", "resume", "compare", "re-review", "validate", "show", "replay", "seal", "verify", "ingest", "export", "contracts", "audit", "seal-provider", "verify-policy", "bundle-export", "bundle-import", "bundle-encrypt", "bundle-decrypt", "bundle-rekey", "store-publish", "store-pull", "delete", "legal-hold", "provenance-sign", "provenance-verify"], command) == false {
        usage_error := require_positionals(parsed, 0, command + " does not accept positional arguments.")
        if usage_error != "" { return command_error(usage_error, 2) }
    }
    if array_includes(["validate", "show", "replay", "seal", "verify", "ingest", "export", "contracts", "audit", "seal-provider", "verify-policy", "bundle-export", "bundle-import", "bundle-encrypt", "bundle-decrypt", "bundle-rekey", "store-publish", "store-pull", "delete", "legal-hold", "provenance-sign", "provenance-verify"], command) {
        usage_error := require_positionals(parsed, 1, command + " requires exactly one positional argument.")
        if usage_error != "" { return command_error(usage_error, 2) }
    }
    if command == "version" { print("Tribunal v" + VERSION); return 0 }
    loaded := config_for(parsed)
    if loaded["ok"] != true { return command_error(loaded["error"], 2) }
    config := loaded["config"]
    if command != "auth-check" {
        authorized := authorize_command(config, command)
        if authorized["ok"] != true { return command_error("Authorization denied: " + authorized["error"], 3) }
    }
    if command == "panels" { return cmd_panels(parsed) }
    if command == "seats" { return cmd_seats(parsed) }
    if command == "keys" { return cmd_keys(parsed, config) }
    if command == "review" || command == "kill" { return cmd_review(command, parsed, config) }
    if command == "resume" { return cmd_resume(parsed, config) }
    if command == "compare" { return cmd_compare(parsed, config) }
    if command == "re-review" { return cmd_re_review(parsed, config) }
    if command == "validate" { return cmd_validate(parsed, config) }
    if command == "list" { return cmd_list(parsed, config) }
    if command == "show" { return cmd_show(parsed, config) }
    if command == "replay" { return cmd_replay(parsed, config) }
    if command == "seal" { return cmd_seal(parsed, config) }
    if command == "verify" { return cmd_verify(parsed, config) }
    if command == "verify-bulk" { return cmd_verify_bulk(parsed, config) }
    if command == "ingest" { return cmd_ingest(parsed, config) }
    if command == "export" { return cmd_export(parsed, config) }
    if command == "doctor" { return cmd_doctor(parsed, config) }
    if command == "stats" { return cmd_stats(parsed, config) }
    if command == "contracts" { return cmd_contracts(parsed, config) }
    if command == "audit" { return cmd_audit(parsed, config) }
    if command == "seal-provider" { return cmd_seal_provider(parsed, config) }
    if command == "verify-policy" { return cmd_verify_policy(parsed, config) }
    if command == "bundle-export" { return cmd_bundle_export(parsed, config) }
    if command == "bundle-import" { return cmd_bundle_import(parsed, config) }
    if command == "bundle-encrypt" { return cmd_bundle_encrypt(parsed, config) }
    if command == "bundle-decrypt" { return cmd_bundle_decrypt(parsed, config) }
    if command == "bundle-rekey" { return cmd_bundle_rekey(parsed, config) }
    if command == "store-publish" { return cmd_store_publish(parsed, config) }
    if command == "store-pull" { return cmd_store_pull(parsed, config) }
    if command == "telemetry-export" { return cmd_telemetry_export(parsed, config) }
    if command == "locks-recover" { return cmd_locks_recover(parsed, config) }
    if command == "index-check" || command == "index-rebuild" || command == "index-repair" { return cmd_index(command, parsed, config) }
    if command == "delete" { return cmd_delete(parsed, config) }
    if command == "auth-check" { return cmd_auth_check(parsed, config) }
    if command == "dashboard-export" { return cmd_dashboard_export(parsed, config) }
    if command == "legal-hold" { return cmd_legal_hold(parsed, config) }
    if command == "provenance-sign" { return cmd_provenance_sign(parsed) }
    if command == "provenance-verify" { return cmd_provenance_verify(parsed) }
    return 2
}
