# Tribunal :: immutable artifact-store providers with conditional writes and versions

from src.bundles import export_bundle, import_bundle, validate_bundle_metadata
from src.common import dict_get, ensure_dir, lower_hex, read_json, redact, remove_tree, safe_run_id, utf8_byte_length, write_json
from src.integrity import verify
from src.adversarial import inspect_remote_envelope

func request_once(url, options) {
    response := {"ok": false, "status": 0, "body": "", "headers": {}, "error": "request failed"}
    try {
        result := http_request(url, options)
        match result {
            case Ok(value): {
                response["status"] := dict_get(value, "_status", dict_get(value, "status", 0))
                response["body"] := dict_get(value, "_body", dict_get(value, "body", ""))
                response["headers"] := dict_get(value, "headers", {})
                response["ok"] := response["status"] >= 200 && response["status"] < 300
                response["error"] := ""
            }
            case Err(error): { response["error"] := redact(to_string(error)) }
        }
    } except err { response["error"] := redact(to_string(err)) }
    return response
}

func request(url, options) {
    mut attempt := 1
    mut response := {"ok": false, "status": 0, "body": "", "headers": {}, "error": "request failed", "attempts": 0}
    while attempt <= 3 {
        response = request_once(url, options)
        response["attempts"] := attempt
        if response["ok"] || (response["status"] != 0 && response["status"] != 429 && response["status"] < 500) { return response }
        if attempt < 3 { sleep(100 * attempt) }
        attempt = attempt + 1
    }
    return response
}

func http_store_context(store) {
    if type(store) != "dict" { return {"ok": false, "error": "Unauthenticated HTTP artifact-store calls are not supported."} }
    endpoint := trim(dict_get(store, "endpoint", ""))
    tenant := trim(dict_get(store, "tenant_id", ""))
    region := trim(dict_get(store, "region", ""))
    token_path := trim(dict_get(store, "bearer_token_file", ""))
    if endpoint == "" || tenant == "" || region == "" || safe_run_id(tenant) == false || safe_run_id(region) == false { return {"ok": false, "error": "Authenticated HTTP store endpoint, tenant, and region are required."} }
    if file_exists(token_path) == false || path_is_symlink(token_path) || file_size(token_path) > 1048576 { return {"ok": false, "error": "HTTP store bearer-token file is missing or unsafe."} }
    token := trim(read_file(token_path))
    if token == "" || contains(token, "\n") || contains(token, "\r") { return {"ok": false, "error": "HTTP store bearer token is invalid."} }
    return {"ok": true, "endpoint": endpoint, "headers": {"Authorization": "Bearer " + token, "X-Tribunal-Tenant": tenant, "X-Tribunal-Region": region}, "tenantId": tenant, "region": region}
}

func merge_headers(base, extra) {
    result := base
    for name in keys(extra) { result[name] := extra[name] }
    return result
}

func descriptor_for(metadata, name) {
    for descriptor in dict_get(metadata, "artifactDescriptors", []) { if descriptor["path"] == name { return descriptor } }
    return null
}

func upload_file_request(url, source, headers) {
    mut attempt := 1
    mut last := {"ok": false, "status": 0, "error": "request failed", "attempts": 0}
    while attempt <= 3 {
        try {
            result := http_upload_file(url, source, {"method": "PUT", "headers": headers, "max_response_bytes": 1048576})
            status := dict_get(result, "status", 0)
            succeeded := status >= 200 && status < 300
            last = {"ok": succeeded, "status": status, "error": "", "attempts": attempt, "uploadedBytes": dict_get(result, "uploaded_bytes", 0)}
        } except err { last = {"ok": false, "status": 0, "error": redact(to_string(err)), "attempts": attempt} }
        if last["ok"] || (last["status"] != 0 && last["status"] != 429 && last["status"] < 500) { return last }
        if attempt < 3 { sleep(100 * attempt) }
        attempt = attempt + 1
    }
    return last
}

func local_index(root, run_id) { return join_path(join_path(root, "indexes"), run_id + ".json") }
func local_version(root, run_id, version) { return join_path(join_path(join_path(root, "objects"), run_id), version) }

INDEX_SCHEMA := {
    "type": "object",
    "required": ["schemaVersion", "runId", "currentVersion", "versions"],
    "properties": {
        "schemaVersion": {"const": "1.0.0"},
        "runId": {"type": "string", "minLength": 1, "maxLength": 128},
        "currentVersion": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "versions": {"type": "array", "minItems": 1, "maxItems": 10000, "items": {"type": "object", "required": ["version", "publishedAt", "keyId", "path"], "properties": {"version": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "publishedAt": {"type": "string", "minLength": 1}, "keyId": {"type": "string", "pattern": "^[a-f0-9]{32}$"}, "path": {"type": "string", "minLength": 1}}, "additionalProperties": false}}
    },
    "additionalProperties": false
}

func current_index(root, run_id) {
    path := local_index(root, run_id)
    if file_exists(path) == false { return {"ok": true, "exists": false, "index": null} }
    if path_is_symlink(path) || file_size(path) > 4194304 { return {"ok": false, "error": "Artifact-store index is unsafe or oversized."} }
    index := null
    try { index = read_json(path) } except err { return {"ok": false, "error": "Artifact-store index is invalid JSON."} }
    checked := json_schema_validate(index, INDEX_SCHEMA)
    if checked["valid"] != true || index["runId"] != run_id { return {"ok": false, "error": "Artifact-store index failed validation."} }
    mut current_found := false
    mut seen := {}
    for entry in index["versions"] {
        version := entry["version"]
        if has_key(seen, version) == 1 { return {"ok": false, "error": "Artifact-store index contains a duplicate version."} }
        seen[version] := true
        if version == index["currentVersion"] { current_found = true }
    }
    if current_found == false { return {"ok": false, "error": "Artifact-store current version is absent from its version history."} }
    return {"ok": true, "exists": true, "index": index}
}

export func publish_local(storage_dir, run_id, root, expected_version) {
    if safe_run_id(run_id) == false { return {"ok": false, "error": "Run ID is unsafe."} }
    if expected_version != "" && lower_hex(expected_version, 64) == false { return {"ok": false, "error": "Expected version must be a lowercase SHA-256 digest."} }
    if trim(root) == "" || (file_exists(root) && path_is_symlink(root)) { return {"ok": false, "error": "Artifact-store root is unsafe."} }
    loaded_index := current_index(root, run_id)
    if loaded_index["ok"] != true { return loaded_index }
    existing := loaded_index["index"]
    current := ""
    if type(existing) == "dict" { current = dict_get(existing, "currentVersion", "") }
    if expected_version != current { return {"ok": false, "error": "Conditional write failed: expected version '" + expected_version + "' but current is '" + current + "'."} }
    signature_path := join_path(join_path(storage_dir, run_id), "signature.json")
    if file_exists(signature_path) == false { return {"ok": false, "error": "Immutable publication requires a signed run."} }
    integrity := verify(storage_dir, run_id, "")
    if integrity["ok"] != true { return {"ok": false, "error": "Run integrity must pass before publication.", "verification": integrity} }
    envelope := null
    try { envelope = read_json(signature_path) } except err { return {"ok": false, "error": "Signature envelope is invalid JSON."} }
    version := dict_get(envelope, "manifestSha256", "")
    if version == "" { return {"ok": false, "error": "Signed run has no manifest version."} }
    destination := local_version(root, run_id, version)
    if path_is_dir(destination) { return {"ok": false, "error": "Immutable object version already exists."} }
    ensure_dir(dirname(destination))
    exported := export_bundle(storage_dir, run_id, destination)
    if exported["ok"] != true { return exported }
    versions := []
    if type(existing) == "dict" { versions = dict_get(existing, "versions", []) }
    versions = push(versions, {"version": version, "publishedAt": exported["bundle"]["exportedAt"], "keyId": exported["bundle"]["keyId"], "path": destination})
    index := {"schemaVersion": "1.0.0", "runId": run_id, "currentVersion": version, "versions": versions}
    ensure_dir(dirname(local_index(root, run_id)))
    write_json(local_index(root, run_id), index)
    return {"ok": true, "provider": "local-immutable", "version": version, "index": index}
}

export func pull_local(root, run_id, version, storage_dir, trust_policy, target) {
    if safe_run_id(run_id) == false { return {"ok": false, "error": "Run ID is unsafe."} }
    if version != "" && lower_hex(version, 64) == false { return {"ok": false, "error": "Version must be a lowercase SHA-256 digest."} }
    if trim(root) == "" || (file_exists(root) && path_is_symlink(root)) { return {"ok": false, "error": "Artifact-store root is unsafe."} }
    selected := version
    if selected == "" {
        loaded_index := current_index(root, run_id)
        if loaded_index["ok"] != true { return loaded_index }
        index := loaded_index["index"]
        if type(index) != "dict" { return {"ok": false, "error": "Artifact-store index is missing."} }
        selected = index["currentVersion"]
    }
    if lower_hex(selected, 64) == false { return {"ok": false, "error": "Artifact-store index selected an unsafe version."} }
    source := local_version(root, run_id, selected)
    if path_is_dir(source) == false { return {"ok": false, "error": "Artifact-store version does not exist."} }
    return import_bundle(source, storage_dir, trust_policy, target)
}

export func publish_http(storage_dir, run_id, store, expected_version) {
    if safe_run_id(run_id) == false { return {"ok": false, "error": "Run ID is unsafe."} }
    if expected_version != "" && lower_hex(expected_version, 64) == false { return {"ok": false, "error": "Expected version must be a lowercase SHA-256 digest."} }
    context := http_store_context(store)
    if context["ok"] != true { return context }
    endpoint := context["endpoint"]
    temp := join_path(env_or("TMPDIR", "/tmp"), "tribunal-http-bundle-" + to_string(current_timestamp()) + "-" + to_string(random_int(1000, 9999)))
    exported := export_bundle(storage_dir, run_id, temp)
    if exported["ok"] != true { return exported }
    metadata := exported["bundle"]
    version := metadata["manifestSha256"]
    for name in metadata["artifacts"] {
        source := join_path(join_path(temp, "artifacts"), name)
        uploaded := upload_file_request(endpoint + "/runs/" + run_id + "/versions/" + version + "/artifacts/" + name, source, merge_headers(context["headers"], {"Content-Type": "application/octet-stream", "If-None-Match": "*", "Content-SHA256": sha256_file(source), "Idempotency-Key": version + ":" + name}))
        if uploaded["ok"] != true {
            request(endpoint + "/runs/" + run_id + "/versions/" + version + "/staging", {"method": "DELETE", "_headers": context["headers"], "timeout": 30})
            remove_tree(temp); return {"ok": false, "error": "Remote artifact upload failed for " + name + ": " + uploaded["error"], "status": uploaded["status"], "attempts": uploaded["attempts"]}
        }
    }
    condition_headers := {"Content-Type": "application/json", "Idempotency-Key": metadata["manifestSha256"]}
    if expected_version == "" { condition_headers["If-None-Match"] := "*" } else { condition_headers["If-Match"] := expected_version }
    finalized := request(endpoint + "/runs/" + run_id + "/versions", {
        "method": "POST",
        "_headers": merge_headers(context["headers"], condition_headers),
        "_body": to_json(metadata),
        "timeout": 60
    })
    remove_tree(temp)
    if finalized["ok"] != true {
        request(endpoint + "/runs/" + run_id + "/versions/" + version + "/staging", {"method": "DELETE", "_headers": context["headers"], "timeout": 30})
        return {"ok": false, "error": "Remote artifact-store version finalization failed: " + finalized["error"], "status": finalized["status"], "attempts": finalized["attempts"]}
    }
    return {"ok": true, "provider": "http-immutable", "version": version, "status": finalized["status"], "tenantId": context["tenantId"], "region": context["region"], "attempts": finalized["attempts"]}
}

export func pull_http(store, run_id, version, storage_dir, trust_policy, target) {
    if safe_run_id(run_id) == false { return {"ok": false, "error": "Run ID is unsafe."} }
    if version != "" && lower_hex(version, 64) == false { return {"ok": false, "error": "Version must be a lowercase SHA-256 digest."} }
    context := http_store_context(store)
    if context["ok"] != true { return context }
    endpoint := context["endpoint"]
    selected := version
    suffix := "/runs/" + run_id + "/versions/" + selected
    if selected == "" { suffix = "/runs/" + run_id + "/current" }
    fetched := request(endpoint + suffix, {"method": "GET", "_headers": context["headers"], "timeout": 60})
    if fetched["ok"] != true { return {"ok": false, "error": "Remote artifact-store metadata fetch failed.", "status": fetched["status"]} }
    inspected := inspect_remote_envelope("store", {"elapsedMs": 0, "headers": fetched["headers"], "body": fetched["body"]}, {"timeoutMs": 60000, "maxHeaders": 64, "maxHeaderBytes": 16384, "maxBodyBytes": 4194304})
    if inspected["ok"] != true { return {"ok": false, "error": inspected["error"], "classification": inspected["classification"]} }
    metadata := inspected["value"]
    validated := validate_bundle_metadata(metadata)
    if validated["ok"] != true { return validated }
    if metadata["runId"] != run_id { return {"ok": false, "error": "Remote artifact-store metadata returned a different run ID."} }
    if selected == "" { selected = dict_get(metadata, "manifestSha256", "") }
    if lower_hex(selected, 64) == false || selected != metadata["manifestSha256"] { return {"ok": false, "error": "Remote artifact-store version is inconsistent."} }
    temp := join_path(env_or("TMPDIR", "/tmp"), "tribunal-http-pull-" + to_string(current_timestamp()) + "-" + to_string(random_int(1000, 9999)))
    ensure_dir(join_path(temp, "artifacts"))
    write_json(join_path(temp, "bundle.json"), metadata)
    for name in dict_get(metadata, "artifacts", []) {
        destination := join_path(join_path(temp, "artifacts"), name)
        ensure_dir(dirname(destination))
        descriptor := descriptor_for(metadata, name)
        if type(descriptor) != "dict" { remove_tree(temp); return {"ok": false, "error": "Remote artifact descriptor is missing for " + name + "."} }
        downloaded := null
        try { downloaded = http_download_file(endpoint + "/runs/" + run_id + "/versions/" + selected + "/artifacts/" + name, destination, {"headers": context["headers"], "max_bytes": 67108864, "overwrite": false}) } except err { downloaded = {"status": 0, "error": redact(to_string(err))} }
        if type(downloaded) != "dict" || dict_get(downloaded, "status", 0) < 200 || dict_get(downloaded, "status", 0) >= 300 { remove_tree(temp); return {"ok": false, "error": "Remote artifact download failed for " + name + ".", "status": dict_get(downloaded, "status", 0)} }
        if downloaded["bytes"] != descriptor["bytes"] || downloaded["sha256"] != descriptor["sha256"] { remove_tree(temp); return {"ok": false, "error": "Remote streamed artifact digest failed for " + name + "."} }
    }
    imported := import_bundle(temp, storage_dir, trust_policy, target)
    remove_tree(temp)
    return imported
}
