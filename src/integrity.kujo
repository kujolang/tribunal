# Tribunal :: Kujo-native SHA-256 artifact integrity and RSA signatures

from src.common import dict_get, ensure_dir, iso_now, path_within, write_json, write_text, read_json, remove_tree, safe_relative_path, safe_run_id, read_file_digest
from src.storage import artifacts, artifact_path

MANIFEST_NAME := "artifact-manifest.json"
SIGNATURE_NAME := "signature.json"
MAX_ARTIFACT_BYTES := 67108864
MAX_INTEGRITY_DOCUMENT_BYTES := 4194304
MAX_MANIFEST_ARTIFACTS := 10000
MAX_KEY_BYTES := 1048576

MANIFEST_SCHEMA := {
    "type": "object",
    "required": ["schemaVersion", "runId", "generatedAt", "algorithm", "exclusions", "artifacts"],
    "properties": {
        "schemaVersion": {"const": "1.0.0"},
        "runId": {"type": "string", "minLength": 1, "maxLength": 128},
        "generatedAt": {"type": "string", "minLength": 1},
        "algorithm": {"const": "sha256"},
        "exclusions": {"type": "array", "items": {"type": "string"}},
        "artifacts": {"type": "array", "maxItems": 10000, "items": {"type": "object", "required": ["path", "bytes", "sha256"], "properties": {"path": {"type": "string", "minLength": 1}, "bytes": {"type": "integer", "minimum": 0, "maximum": 67108864}, "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}, "additionalProperties": false}}
    },
    "additionalProperties": false
}

func transaction_dir(storage_dir, run_id) { return join_path(join_path(storage_dir, ".seal-transactions"), run_id) }

export func begin_seal_transaction(storage_dir, run_id) {
    if safe_run_id(run_id) == false { return {"ok": false, "error": "Seal transaction run ID is unsafe."} }
    transaction_root := join_path(storage_dir, ".seal-transactions")
    if file_exists(transaction_root) && path_is_symlink(transaction_root) { return {"ok": false, "error": "Seal transaction root is unsafe."} }
    root := transaction_dir(storage_dir, run_id)
    if path_is_dir(root) { return {"ok": false, "error": "A seal transaction is already active."} }
    ensure_dir(root)
    manifest_path := artifact_path(storage_dir, run_id, MANIFEST_NAME)
    signature_path := artifact_path(storage_dir, run_id, SIGNATURE_NAME)
    had_manifest := file_exists(manifest_path)
    had_signature := file_exists(signature_path)
    if had_manifest { copy_file(manifest_path, join_path(root, MANIFEST_NAME)) }
    if had_signature { copy_file(signature_path, join_path(root, SIGNATURE_NAME)) }
    write_json(join_path(root, "transaction.json"), {"schemaVersion": "1.0.0", "runId": run_id, "startedAt": iso_now(), "hadManifest": had_manifest, "hadSignature": had_signature})
    return {"ok": true, "path": root}
}

export func rollback_seal_transaction(storage_dir, run_id) {
    if safe_run_id(run_id) == false { return {"ok": false, "error": "Seal transaction run ID is unsafe."} }
    root := transaction_dir(storage_dir, run_id)
    marker_path := join_path(root, "transaction.json")
    if file_exists(marker_path) == false { return {"ok": true, "recovered": false} }
    marker := read_json(marker_path)
    manifest_path := artifact_path(storage_dir, run_id, MANIFEST_NAME)
    signature_path := artifact_path(storage_dir, run_id, SIGNATURE_NAME)
    if marker["hadManifest"] { copy_file(join_path(root, MANIFEST_NAME), manifest_path) } else if file_exists(manifest_path) { delete_file(manifest_path) }
    if marker["hadSignature"] { copy_file(join_path(root, SIGNATURE_NAME), signature_path) } else if file_exists(signature_path) { delete_file(signature_path) }
    remove_tree(root)
    return {"ok": true, "recovered": true, "runId": run_id}
}

export func finish_seal_transaction(storage_dir, run_id) {
    root := transaction_dir(storage_dir, run_id)
    if path_is_dir(root) { remove_tree(root) }
    return {"ok": true}
}

export func recover_seal_transactions(storage_dir) {
    root := join_path(storage_dir, ".seal-transactions")
    mut recovered := []
    if path_is_dir(root) == false { return {"ok": true, "recovered": recovered} }
    if path_is_symlink(root) { return {"ok": false, "error": "Seal transaction root is unsafe.", "recovered": recovered} }
    for run_id in list_dir(root) {
        if safe_run_id(run_id) == false || path_is_symlink(join_path(root, run_id)) { continue }
        result := rollback_seal_transaction(storage_dir, run_id)
        if result["recovered"] { recovered = push(recovered, run_id) }
    }
    return {"ok": true, "recovered": recovered}
}

func excluded(name) {
    return name == MANIFEST_NAME || name == SIGNATURE_NAME
}

export func signature_payload_for(schema_version, run_id, manifest_hash, key_id, signed_at) {
    return {
        "schemaVersion": schema_version,
        "runId": run_id,
        "algorithm": "RSA-PKCS1v15-SHA256",
        "manifestSha256": manifest_hash,
        "keyId": key_id,
        "signedAt": signed_at
    }
}

func signature_payload(run_id, manifest_hash, key_id, signed_at) {
    return signature_payload_for("1.1.0", run_id, manifest_hash, key_id, signed_at)
}

export func generate_keys(private_path, public_path, bits) {
    if private_path == "" || public_path == "" { return {"ok": false, "error": "Both private and public key paths are required."} }
    if path_within(private_path, public_path) && path_within(public_path, private_path) { return {"ok": false, "error": "Private and public key paths must differ."} }
    if file_exists(private_path) || path_is_dir(private_path) || file_exists(public_path) || path_is_dir(public_path) { return {"ok": false, "error": "Refusing to overwrite an existing key path."} }
    if bits != 2048 && bits != 4096 { return {"ok": false, "error": "RSA key size must be 2048 or 4096 bits."} }
    pair := rsa_generate_keypair(bits)
    if type(pair) != "dict" || has_key(pair, "private") == 0 || has_key(pair, "public") == 0 {
        return {"ok": false, "error": "Kujo RSA key generation failed."}
    }
    write_text(private_path, pair["private"])
    write_text(public_path, pair["public"])
    return {"ok": true, "algorithm": "RSA-PKCS1v15-SHA256", "bits": bits, "keyId": substring(sha256(pair["public"]), 0, 32), "privateKey": private_path, "publicKey": public_path}
}

func sign_existing_manifest(storage_dir, run_id, private_path, public_path) {
    manifest_path := artifact_path(storage_dir, run_id, MANIFEST_NAME)
    signature_path := artifact_path(storage_dir, run_id, SIGNATURE_NAME)
    manifest := read_json(manifest_path)
    manifest_text := read_file(manifest_path)
    private_key := read_file(private_path)
    public_key := read_file(public_path)
    key_id := substring(sha256(public_key), 0, 32)
    signed_at := iso_now()
    payload := signature_payload(run_id, sha256(manifest_text), key_id, signed_at)
    payload_text := to_json(payload)
    signature_value := null
    try { signature_value = rsa_sign(payload_text, private_key) } except err { signature_value = null }
    if type(signature_value) != "string" { return {"ok": false, "error": "Kujo RSA signing failed."} }
    signature_valid := false
    try { signature_valid = rsa_verify(payload_text, signature_value, public_key) } except err { signature_valid = false }
    if signature_valid != true { return {"ok": false, "error": "Generated signature did not verify with the supplied public key."} }
    envelope := {
        "schemaVersion": "1.1.0", "runId": run_id, "algorithm": "RSA-PKCS1v15-SHA256",
        "manifestSha256": sha256(manifest_text), "keyId": key_id, "signedAt": signed_at,
        "payloadSha256": sha256(payload_text), "signature": signature_value
    }
    transaction := begin_seal_transaction(storage_dir, run_id)
    if transaction["ok"] != true { return transaction }
    try { write_json(signature_path, envelope) } except err { rollback_seal_transaction(storage_dir, run_id); return {"ok": false, "error": "Unable to persist signature envelope."} }
    finish_seal_transaction(storage_dir, run_id)
    return {"ok": true, "manifest": manifest, "signature": envelope}
}

export func seal(storage_dir, run_id, private_path, public_path) {
    manifest_path := artifact_path(storage_dir, run_id, MANIFEST_NAME)
    signature_path := artifact_path(storage_dir, run_id, SIGNATURE_NAME)
    if manifest_path == "" { return {"ok": false, "error": "Unsafe or missing run ID."} }
    if (private_path == "" && public_path != "") || (private_path != "" && public_path == "") { return {"ok": false, "error": "Signed sealing requires both --private-key and --public-key."} }
    if private_path != "" && (file_exists(private_path) == false || file_exists(public_path) == false) { return {"ok": false, "error": "Signing key file is missing."} }
    if private_path != "" && (path_is_symlink(private_path) || path_is_symlink(public_path) || file_size(private_path) > MAX_KEY_BYTES || file_size(public_path) > MAX_KEY_BYTES) { return {"ok": false, "error": "Signing key file is unsafe or exceeds the 1 MiB safety limit."} }
    if file_exists(manifest_path) {
        existing := verify(storage_dir, run_id, "")
        if existing["ok"] != true { return {"ok": false, "error": "Sealed run is immutable; existing evidence must verify before adding or rotating a signature.", "verification": existing} }
        if private_path == "" { return {"ok": true, "manifest": read_json(manifest_path)} }
        return sign_existing_manifest(storage_dir, run_id, private_path, public_path)
    }
    names := artifacts(storage_dir, run_id)
    if len(names) > MAX_MANIFEST_ARTIFACTS { return {"ok": false, "error": "Run contains too many artifacts to seal safely."} }
    mut entries := []
    for name in names {
        if excluded(name) == false {
            if safe_relative_path(name) == false { return {"ok": false, "error": "Unsafe artifact path: " + name} }
            digest := read_file_digest(artifact_path(storage_dir, run_id, name), MAX_ARTIFACT_BYTES)
            if digest["ok"] != true { return digest }
            entries = push(entries, {"path": name, "bytes": digest["bytes"], "sha256": digest["sha256"]})
        }
    }
    manifest := {
        "schemaVersion": "1.0.0",
        "runId": run_id,
        "generatedAt": iso_now(),
        "algorithm": "sha256",
        "exclusions": [MANIFEST_NAME, SIGNATURE_NAME],
        "artifacts": entries
    }
    transaction := begin_seal_transaction(storage_dir, run_id)
    if transaction["ok"] != true { return transaction }
    if file_exists(signature_path) { delete_file(signature_path) }
    write_json(manifest_path, manifest)
    finish_seal_transaction(storage_dir, run_id)
    if private_path == "" && public_path == "" { return {"ok": true, "manifest": manifest} }
    return sign_existing_manifest(storage_dir, run_id, private_path, public_path)
}

export func verify(storage_dir, run_id, public_path) {
    manifest_path := artifact_path(storage_dir, run_id, MANIFEST_NAME)
    mut response := {
        "ok": false,
        "runId": run_id,
        "artifactsChecked": 0,
        "missing": [],
        "unexpected": [],
        "mismatched": [],
        "signature": "absent",
        "errors": []
    }
    if manifest_path == "" || file_exists(manifest_path) == false {
        response["missing"] := [MANIFEST_NAME]
        response["errors"] := ["Integrity manifest is missing."]
        return response
    }
    if path_is_symlink(manifest_path) {
        response["errors"] := ["Integrity manifest must not be a symbolic link."]
        return response
    }
    if file_size(manifest_path) > MAX_INTEGRITY_DOCUMENT_BYTES {
        response["errors"] := ["Integrity manifest exceeds the safety limit."]
        return response
    }
    manifest_text := read_file(manifest_path)
    manifest := null
    try { manifest = parse_json(manifest_text) } except err {
        response["errors"] := ["Integrity manifest is invalid JSON."]
        return response
    }
    checked_manifest := json_schema_validate(manifest, MANIFEST_SCHEMA)
    if checked_manifest["valid"] != true {
        response["errors"] := ["Integrity manifest failed structural validation: " + to_json(checked_manifest["errors"])]
        return response
    }
    if dict_get(manifest, "schemaVersion", "") != "1.0.0" || dict_get(manifest, "runId", "") != run_id || dict_get(manifest, "algorithm", "") != "sha256" {
        response["errors"] := push(response["errors"], "Integrity manifest contract is invalid.")
    }
    mut expected := {}
    for entry in dict_get(manifest, "artifacts", []) {
        name := dict_get(entry, "path", "")
        if safe_relative_path(name) == false {
            response["errors"] := push(response["errors"], "Unsafe artifact path in manifest: " + name)
        } else if has_key(expected, name) == 1 {
            response["errors"] := push(response["errors"], "Duplicate artifact entry: " + name)
        } else {
            expected[name] := true
            path := artifact_path(storage_dir, run_id, name)
            if path == "" || file_exists(path) == false {
                response["missing"] := push(response["missing"], name)
            } else {
                digest := read_file_digest(path, MAX_ARTIFACT_BYTES)
                if digest["ok"] != true {
                    response["errors"] := push(response["errors"], digest["error"])
                } else {
                    response["artifactsChecked"] := response["artifactsChecked"] + 1
                    if digest["sha256"] != dict_get(entry, "sha256", "") || digest["bytes"] != dict_get(entry, "bytes", -1) {
                        response["mismatched"] := push(response["mismatched"], {"path": name, "expectedSha256": dict_get(entry, "sha256", ""), "actualSha256": digest["sha256"], "expectedBytes": dict_get(entry, "bytes", -1), "actualBytes": digest["bytes"]})
                    }
                }
            }
        }
    }
    for name in artifacts(storage_dir, run_id) {
        if excluded(name) == false && has_key(expected, name) == 0 { response["unexpected"] := push(response["unexpected"], name) }
    }
    response["manifestSha256"] := sha256(manifest_text)
    signature_path := artifact_path(storage_dir, run_id, SIGNATURE_NAME)
    if file_exists(signature_path) {
        response["signature"] := "present-unverified"
        envelope := null
        if path_is_symlink(signature_path) || file_size(signature_path) > MAX_INTEGRITY_DOCUMENT_BYTES {
            response["signature"] := "invalid"
            response["errors"] := push(response["errors"], "Signature envelope is unsafe or exceeds the safety limit.")
        } else {
            try { envelope = read_json(signature_path) } except err {
                response["signature"] := "invalid"
                response["errors"] := push(response["errors"], "Signature envelope is invalid JSON.")
            }
        }
        if type(envelope) == "dict" {
            response["keyId"] := dict_get(envelope, "keyId", "")
            schema_version := dict_get(envelope, "schemaVersion", "")
            if (schema_version != "1.0.0" && schema_version != "1.1.0" && schema_version != "1.2.0") || dict_get(envelope, "runId", "") != run_id || dict_get(envelope, "algorithm", "") != "RSA-PKCS1v15-SHA256" || dict_get(envelope, "manifestSha256", "") != sha256(manifest_text) {
                response["signature"] := "invalid"
                response["errors"] := push(response["errors"], "Signature envelope does not match the manifest.")
            } else if public_path != "" {
                if file_exists(public_path) == false || path_is_symlink(public_path) {
                    response["signature"] := "invalid"
                    response["errors"] := push(response["errors"], "Trusted public key is missing.")
                } else {
                    public_key := read_file(public_path)
                    expected_key_id := substring(sha256(public_key), 0, 32)
                    signed_text := manifest_text
                    if schema_version == "1.1.0" || schema_version == "1.2.0" {
                        payload := signature_payload_for(schema_version, run_id, dict_get(envelope, "manifestSha256", ""), dict_get(envelope, "keyId", ""), dict_get(envelope, "signedAt", ""))
                        signed_text = to_json(payload)
                        if dict_get(envelope, "payloadSha256", "") != sha256(signed_text) {
                            response["errors"] := push(response["errors"], "Signature payload digest is invalid.")
                        }
                    }
                    signature_valid := false
                    try { signature_valid = rsa_verify(signed_text, dict_get(envelope, "signature", ""), public_key) } except err { signature_valid = false }
                    valid := len(response["errors"]) == 0 && expected_key_id == dict_get(envelope, "keyId", "") && signature_valid
                    if valid {
                        response["signature"] := "verified"
                    } else {
                        response["signature"] := "invalid"
                        response["errors"] := push(response["errors"], "Signature did not verify with the trusted public key.")
                    }
                }
            }
        }
    } else if public_path != "" {
        response["errors"] := push(response["errors"], "A trusted public key was supplied but signature.json is missing.")
    }
    response["ok"] := len(response["missing"]) == 0 && len(response["unexpected"]) == 0 && len(response["mismatched"]) == 0 && len(response["errors"]) == 0
    return response
}
