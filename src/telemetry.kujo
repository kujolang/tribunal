# Tribunal :: external metrics and audit export without sealed-run mutation

from src.analytics import collect_stats
from src.common import dict_get, ensure_dir, parent_dir, path_within, redact, safe_http_url, write_json
from src.storage import list_runs_page, load_events

func audit_event(event) {
    return {
        "timestamp": dict_get(event, "timestamp", ""),
        "runId": dict_get(event, "runId", ""),
        "stageId": dict_get(event, "stageId", ""),
        "seatId": dict_get(event, "seatId", ""),
        "eventType": dict_get(event, "eventType", ""),
        "summary": redact(dict_get(event, "summary", ""))
    }
}

func secure_http_destination(value) {
    return safe_http_url(value)
}

export func telemetry_payload_page(storage_dir, cursor, limit, metrics) {
    mut audit := []
    bounded_limit := limit
    if bounded_limit < 1 { bounded_limit = 100 }
    if bounded_limit > 500 { bounded_limit = 500 }
    page := list_runs_page(storage_dir, "", "", bounded_limit, cursor)
    if page["cursorFound"] != true { return {"ok": false, "error": "Telemetry cursor was not found."} }
    for manifest in page["items"] {
        for event in load_events(storage_dir, manifest["runId"]) { audit = push(audit, audit_event(event)) }
    }
    resolved_metrics := metrics
    if type(resolved_metrics) != "dict" { resolved_metrics = collect_stats(storage_dir) }
    return {"ok": true, "schemaVersion": "1.0.0", "exportedAt": now_utc(), "metrics": resolved_metrics, "auditEvents": audit, "runsProcessed": len(page["items"]), "pageLimit": bounded_limit, "cursor": cursor, "nextCursor": page["nextCursor"], "hasMore": page["hasMore"]}
}

export func telemetry_payload(storage_dir) {
    payload := telemetry_payload_page(storage_dir, "", 100, null)
    payload["ok"] := null
    return {"schemaVersion": payload["schemaVersion"], "exportedAt": payload["exportedAt"], "metrics": payload["metrics"], "auditEvents": payload["auditEvents"], "runsProcessed": payload["runsProcessed"], "pageLimit": payload["pageLimit"], "cursor": payload["cursor"], "nextCursor": payload["nextCursor"], "hasMore": payload["hasMore"]}
}

export func export_telemetry(storage_dir, collector, destination) {
    if collector == "jsonl" && path_within(storage_dir, destination) { return {"ok": false, "error": "Telemetry destination must be outside Tribunal run storage."} }
    metrics := collect_stats(storage_dir)
    cursor := ""
    payload := telemetry_payload_page(storage_dir, cursor, 100, metrics)
    mut total_events := 0
    mut pages := 0
    if collector == "jsonl" {
        ensure_dir(parent_dir(destination))
        while payload["ok"] {
            append_file(destination, to_json(payload) + "\n")
            pages = pages + 1; total_events = total_events + len(payload["auditEvents"])
            if payload["hasMore"] == false { break }
            cursor = payload["nextCursor"]
            payload = telemetry_payload_page(storage_dir, cursor, 100, metrics)
        }
        receipt := {"ok": payload["ok"], "collector": collector, "destination": path_absolute(destination), "events": total_events, "pages": pages, "pageLimit": 100, "exportedAt": now_utc()}
        write_json(destination + ".receipt.json", receipt)
        return receipt
    }
    if collector == "http" {
        if secure_http_destination(destination) == false || contains(destination, "@") { return {"ok": false, "error": "HTTP telemetry requires HTTPS without embedded credentials (plain HTTP is allowed only for loopback development)."} }
        while payload["ok"] {
            status := 0
            error := ""
            try {
                result := http_request(destination, {"method": "POST", "_headers": {"Content-Type": "application/json", "Idempotency-Key": "telemetry:" + to_string(pages) + ":" + payload["cursor"]}, "_body": to_json(payload), "timeout": 30})
                match result {
                    case Ok(response): { status = dict_get(response, "_status", dict_get(response, "status", 0)) }
                    case Err(request_error): { error = redact(request_error) }
                }
            } except err { error = redact(err) }
            if error != "" { return {"ok": false, "error": "Telemetry collector request failed: " + error, "pagesSent": pages} }
            if status < 200 || status >= 300 { return {"ok": false, "error": "Telemetry collector returned HTTP " + to_string(status) + ".", "pagesSent": pages} }
            pages = pages + 1; total_events = total_events + len(payload["auditEvents"])
            if payload["hasMore"] == false { break }
            cursor = payload["nextCursor"]
            payload = telemetry_payload_page(storage_dir, cursor, 100, metrics)
        }
        return {"ok": true, "collector": collector, "destination": destination, "events": total_events, "pages": pages, "pageLimit": 100, "exportedAt": now_utc()}
    }
    return {"ok": false, "error": "Collector must be jsonl or http."}
}
