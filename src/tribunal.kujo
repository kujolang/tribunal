func emit(storage_dir, run_id, stage, event_type, summary, seat_id, metadata) {
    event := {
        "timestamp": now_utc(),
        "runId": run_id,
        "stageId": stage,
        "eventType": event_type,
        "summary": summary,
        "metadata": metadata
    }
    if seat_id != "" { event["seatId"] := seat_id }
    return append_event(storage_dir, run_id, event)
}

func completed(state, stage) {
    state["stagesCompleted"] := push(state["stagesCompleted"], stage)
    return state
}

func persist_checkpoint(storage_dir, state, stage) {
    checkpoint := {"schemaVersion": "1.0.0", "runId": state["runId"], "sequence": len(state["stagesCompleted"]), "lastCompletedStage": stage, "stagesCompleted": state["stagesCompleted"], "updatedAt": now_utc(), "idempotencyContract": "sha256(stage+seat+input+schema)"}
    save_json(storage_dir, state["runId"], "checkpoint.json", checkpoint)
    return checkpoint
}

func section(content, heading) {
    lines := split(content, "\n")
    mut active := false
    mut values := []
    for line in lines {
        trimmed := trim(line)
        if starts_with(trimmed, "## ") {
            if active { break }
            active = to_lower(trim(substring(trimmed, 3, len(trimmed)))) == to_lower(heading)
        } else if active && trimmed != "" {
            values = push(values, trimmed)
        }
    }
    return join(values, "\n")
}

func list_section(content, heading) {
    raw := section(content, heading)
    mut out := []
    for line in split(raw, "\n") {
        value := trim(line)
        if starts_with(value, "- ") { value = trim(substring(value, 2, len(value))) }
        if value != "" { out = push(out, value) }
    }
    return out
}

func docket_title(content, source) {
    for line in split(content, "\n") {
        trimmed := trim(line)
        if starts_with(trimmed, "# ") { return trim(substring(trimmed, 2, len(trimmed))) }
    }
    return basename(source)
}

func open_docket(config, path) {
    if path == "" || file_exists(path) == false { return {"ok": false, "error": "Missing or unreadable docket file: " + path} }
    size := file_size(path)
    max_bytes := config["limits"]["max_docket_bytes"]
    if size > max_bytes { return {"ok": false, "error": "Docket exceeds the configured " + to_string(max_bytes) + " byte limit."} }
    content := ""
    try { content = read_file(path) } except err { return {"ok": false, "error": "Missing or unreadable docket file: " + path} }
    if trim(content) == "" { return {"ok": false, "error": "Docket is empty."} }
    scan := secret_scan(content, config["security"]["organization_secret_patterns_path"])
    if scan["ok"] != true { return {"ok": false, "error": scan["error"]} }
    if scan["detected"] { return {"ok": false, "error": "Unsafe secret exposure detected in docket."} }
    title := docket_title(content, path)
    scope := section(content, "Scope")
    if scope == "" { scope = "Review the submitted docket without expanding its stated proposal." }
    opened := now_utc()
    hash := sha256(content)
    return {"ok": true, "docket": {"id": substring(hash, 0, 16), "title": title, "sourcePath": path_absolute(path), "content": content, "scope": scope, "nonGoals": list_section(content, "Non-goals"), "openedAt": opened, "contentSha256": hash}}
}

export func validate_docket(config, path) {
    return open_docket(config, path)
}

export func validate_model_output(structured, schema) {
    if type(structured) != "dict" { return "Model returned no structured object." }
    checked := null
    try { checked = json_schema_validate(structured, schema) } except err { return "Model output schema is invalid: " + to_string(err) }
    if checked["valid"] != true { return "Model response failed its output contract: " + to_json(checked["errors"]) }
    return ""
}

func system_prompt(seat_value, stage) {
    return "You are the " + seat_value["name"] + " seat in Tribunal. Authority: " + seat_value["authority"] + " Stay within the explicit " + stage + " contract. Return only valid JSON matching the requested schema."
}

func invoke_checked(config, run_id, stage, seat_value, input, output_schema) {
    system := system_prompt(seat_value, stage)
    request := {"runId": run_id, "stageId": stage, "seatId": seat_value["id"], "idempotencyKey": sha256(stage + ":" + seat_value["id"] + ":" + input + ":" + to_json(output_schema)), "modelPreference": seat_value["defaultModelPreference"], "systemPrompt": system, "input": input, "outputSchema": output_schema, "timeoutMs": config["limits"]["model_timeout_ms"]}
    response := invoke(config, request)
    if dict_get(response, "ok", false) != true {
        error := dict_get(response, "error", {"code": "model_error", "message": "Model invocation failed."})
        return {"ok": false, "error": dict_get(error, "message", "Model invocation failed."), "response": response}
    }
    content := dict_get(response, "content", "")
    if utf8_byte_length(content) > config["limits"]["max_model_output_bytes"] {
        return {"ok": false, "error": "Model output exceeded the configured safety limit.", "response": response}
    }
    scan := secret_scan(content, config["security"]["organization_secret_patterns_path"])
    if scan["ok"] != true || scan["detected"] {
        return {"ok": false, "error": "Potential secret exposure detected in model output.", "response": response}
    }
    structured := dict_get(response, "structured", null)
    if type(structured) != "dict" {
        try { structured = parse_json(response["content"]) } except err { structured = null }
    }
    if type(structured) == "dict" {
        structured_text := to_json(structured)
        if utf8_byte_length(structured_text) > config["limits"]["max_model_output_bytes"] { return {"ok": false, "error": "Structured model output exceeded the configured safety limit.", "response": response} }
        structured_scan := secret_scan(structured_text, config["security"]["organization_secret_patterns_path"])
        if structured_scan["ok"] != true || structured_scan["detected"] { return {"ok": false, "error": "Potential secret exposure detected in structured model output.", "response": response} }
    }
    contract_error := validate_model_output(structured, output_schema)
    if contract_error != "" { return {"ok": false, "error": contract_error, "response": response} }
    metadata := dict_get(response, "metadata", {})
    return {"ok": true, "content": content, "structured": structured, "metadata": metadata}
}

func persist_model_result(storage_dir, run_id, stage, seat_value, result) {
    if result["ok"] == true {
        emit(storage_dir, run_id, stage, "model_invocation_completed", "Model invocation completed.", seat_value["id"], result["metadata"])
    } else {
        response_error := dict_get(dict_get(result, "response", {}), "error", {})
        emit(storage_dir, run_id, stage, "model_invocation_failed", result["error"], seat_value["id"], {"code": dict_get(response_error, "code", "model_error")})
    }
    return result
}

func call_model(config, storage_dir, state, stage, seat_value, input, output_schema) {
    run_id := state["runId"]
    system := system_prompt(seat_value, stage)
    save_text(storage_dir, run_id, "prompts/" + stage + "-" + seat_value["id"] + ".md", "# System\n\n" + system + "\n\n# Input\n\n" + input + "\n")
    emit(storage_dir, run_id, stage, "model_invocation_requested", "Model invocation requested through Kujo AI SDK boundary.", seat_value["id"], {"preference": seat_value["defaultModelPreference"]})
    return persist_model_result(storage_dir, run_id, stage, seat_value, invoke_checked(config, run_id, stage, seat_value, input, output_schema))
}

func invoke_blind_job(job) {
    result := invoke_checked(job["config"], job["runId"], "blind-first-pass", job["seat"], job["input"], job["seat"]["requiredOutputSchema"])
    if result["ok"] != true {
        write_file_atomic(job["cancelFile"], "cancel")
        return error(to_json(result))
    }
    return result
}

func blind_calls(config, storage_dir, state, selected_seats, context) {
    run_id := state["runId"]
    cancel_file := join_path(join_path(storage_dir, run_id), ".blind-cancel")
    if file_exists(cancel_file) { delete_file(cancel_file) }
    mut jobs := []
    for seat_value in selected_seats {
        input := render_seat_prompt(seat_value, context)
        system := system_prompt(seat_value, "blind-first-pass")
        save_text(storage_dir, run_id, "prompts/blind-first-pass-" + seat_value["id"] + ".md", "# System\n\n" + system + "\n\n# Input\n\n" + input + "\n")
        emit(storage_dir, run_id, "blind-first-pass", "model_invocation_requested", "Model invocation requested through Kujo AI SDK boundary.", seat_value["id"], {"preference": seat_value["defaultModelPreference"]})
        jobs = push(jobs, {"config": config, "runId": run_id, "seat": seat_value, "input": input, "cancelFile": cancel_file})
    }
    concurrency := config["execution"]["blind_parallelism"]
    if config["execution"]["provider_max_concurrency"] < concurrency { concurrency = config["execution"]["provider_max_concurrency"] }
    if len(jobs) < concurrency { concurrency = len(jobs) }
    requested_concurrency := concurrency
    runtime_gate := ""
    if config["execution"]["live_parallel_enabled"] != true {
        concurrency = 1
        runtime_gate = "live-parallel-opt-in"
    }
    mut results := []
    mut parallel_error := ""
    try { results = await parallel_map(jobs, invoke_blind_job, concurrency) } except err { parallel_error = redact(to_string(err)) }
    if file_exists(cancel_file) { delete_file(cancel_file) }
    if parallel_error != "" { return {"ok": false, "error": parallel_error, "jobs": jobs, "results": [], "concurrency": concurrency, "requestedConcurrency": requested_concurrency, "runtimeGate": runtime_gate} }
    return {"ok": true, "jobs": jobs, "results": results, "concurrency": concurrency, "requestedConcurrency": requested_concurrency, "runtimeGate": runtime_gate}
}

func add_usage(state, call) {
    state["invocations"] := state["invocations"] + 1
    if call["ok"] != true { state["failures"] := state["failures"] + 1 }
    metadata := dict_get(call, "metadata", dict_get(dict_get(call, "response", {}), "metadata", {}))
    state["totalTokens"] := state["totalTokens"] + dict_get(metadata, "totalTokens", 0)
    return state
}

func procedural_ruling(kill_pass) {
    disposition := "proceed"
    verdict := "The proposal survives the focused Executioner review with required conditions."
    if kill_pass["recommendation"] == "kill" || len(kill_pass["fatalFlaws"]) > 0 {
        disposition = "reject"
        verdict = "The proposal is rejected by the focused Executioner review."
    } else if kill_pass["recommendation"] == "redesign" {
        disposition = "redesign"
        verdict = "The proposal requires redesign before execution."
    }
    return {
        "finalVerdict": verdict,
        "bestArgumentFor": "The proposal can proceed if all survivable risks and required changes are resolved.",
        "bestArgumentAgainst": "The focused review identified unresolved adversarial risk.",
        "panelAgreement": ["The Executioner findings are authoritative for this focused panel."],
        "unresolved": kill_pass["survivableRisks"],
        "requiredChanges": kill_pass["requiredChanges"],
        "confidence": 7,
        "disposition": disposition,
        "generatedAt": now_utc(),
        "metadata": {"provider": "tribunal-procedure", "model": "executioner-only-rule"}
    }
}

func procedural_packet(docket, ruling) {
    return {
        "decision": ruling["finalVerdict"],
        "scope": docket["scope"],
        "nonGoals": docket["nonGoals"],
        "requiredNextActions": ruling["requiredChanges"],
        "suggestedOwnerRole": "technical owner",
        "suggestedModelLevel": "frontier reasoning for follow-up review; local model for bounded execution",
        "acceptanceCriteria": ["All required changes are complete", "Verification and rollback evidence are captured"],
        "escalationTriggers": ["Scope growth", "New fatal flaw", "Missing owner"],
        "evidenceRequired": ["Test output", "Change summary", "Rollback evidence"],
        "stopTheLineConditions": ["Secret exposure", "Unbounded destructive action", "Corrupted evidence"],
        "generatedAt": now_utc()
    }
}

func receipt(state, status, completed_at, record_hash) {
    return {
        "schemaVersion": "1.0.0",
        "runId": state["runId"],
        "status": status,
        "startedAt": state["startedAt"],
        "completedAt": completed_at,
        "durationMs": current_timestamp() - state["startedMs"],
        "panelId": state["panel"]["id"],
        "modelInvocations": state["invocations"],
        "failedInvocations": state["failures"],
        "totalTokens": state["totalTokens"],
        "recordSha256": record_hash,
        "integration": {"runLedger": "compatible-receipt", "modelRuntime": state["modelRuntime"]}
    }
}

func artifact_paths(state) {
    mut paths := ["docket.md", "manifest.json", "checkpoint.json", "context.md", "cross-examination.md", "kill-pass.md", "ruling.md", "decision-packet.md", "policy-checks.json", "record.json", "events.jsonl", "receipt.json", "artifact-manifest.json"]
    for testimony in state["testimonies"] { paths = push(paths, "testimony/" + testimony["seatId"] + ".md") }
    return paths
}

func stop_run(config, state, reason, private_key, public_key) {
    storage_dir := config["tribunal"]["storage_dir"]
    run_id := state["runId"]
    completed_at := now_utc()
    emit(storage_dir, run_id, dict_get(state, "currentStage", "open-docket"), "stop_the_line_triggered", "Tribunal stopped on a fatal condition.", "", {"reason": reason})
    record := {
        "schemaVersion": "1.0.0", "runId": run_id, "status": "stopped", "startedAt": state["startedAt"], "completedAt": completed_at,
        "panel": state["panel"], "seats": state["seats"], "stagesCompleted": state["stagesCompleted"], "testimonies": state["testimonies"],
        "crossExaminations": state["crossExaminations"], "stopReason": reason, "governance": state["governance"], "artifactPaths": ["manifest.json", "checkpoint.json", "events.jsonl", "record.json", "receipt.json", "artifact-manifest.json"]
    }
    if type(dict_get(state, "lineage", null)) == "dict" { record["lineage"] := state["lineage"] }
    if type(dict_get(state, "docket", null)) == "dict" { record["docket"] := state["docket"] }
    if type(dict_get(state, "killPass", null)) == "dict" { record["killPass"] := state["killPass"] }
    if type(dict_get(state, "ruling", null)) == "dict" { record["ruling"] := state["ruling"] }
    if type(dict_get(state, "decisionPacket", null)) == "dict" { record["decisionPacket"] := state["decisionPacket"] }
    save_json(storage_dir, run_id, "record.json", record)
    hash := sha256(read_file(artifact_path(storage_dir, run_id, "record.json")))
    save_json(storage_dir, run_id, "receipt.json", receipt(state, "stopped", completed_at, hash))
    manifest := state["manifest"]
    manifest["status"] := "stopped"
    manifest["completedAt"] := completed_at
    save_json(storage_dir, run_id, "manifest.json", manifest)
    seal(storage_dir, run_id, private_key, public_key)
    release_lock(storage_dir, run_id, state["lockToken"])
    return {"ok": false, "runId": run_id, "runDir": state["runDir"], "error": reason, "record": record}
}

func review_internal(config, docket_path, panel_id, private_key, public_key, lineage) {
    resolved := resolve_panel(config, panel_id)
    if resolved["ok"] != true { return {"ok": false, "error": "Invalid panel config: " + resolved["error"]} }
    selected_panel := resolved["panel"]
    selected_seats := resolved["seats"]
    if len(selected_seats) == 0 { return {"ok": false, "error": "Invalid panel config: panel has no usable seats."} }
    storage_dir := config["tribunal"]["storage_dir"]
    placeholder_title := basename(docket_path)
    if placeholder_title == "" { placeholder_title = "stopped-run" }
    run_id := generate_run_id(storage_dir, placeholder_title)
    if run_id == "" { return {"ok": false, "error": "Run storage is unsafe or unavailable."} }
    actor := config["authorization"]["identity"]
    locked := acquire_lock(storage_dir, run_id, "review:" + actor, 300000)
    if locked["ok"] != true { return {"ok": false, "error": locked["error"]} }
    root := create_run(storage_dir, run_id)
    if root == "" { release_lock(storage_dir, run_id, locked["lock"]["token"]); return {"ok": false, "error": "Run storage is unsafe or unavailable."} }
    started_at := now_utc()
    runtime := "kujo-ai-sdk"
    if config["kujo_ai"]["mock_mode"] == true { runtime = "mock-kujo" }
    state := {
        "runId": run_id, "runDir": root, "startedAt": started_at, "startedMs": current_timestamp(), "panel": selected_panel, "seats": selected_seats,
        "stagesCompleted": [], "testimonies": [], "crossExaminations": [], "invocations": 0, "failures": 0, "totalTokens": 0, "modelRuntime": runtime, "currentStage": "open-docket",
        "lockToken": locked["lock"]["token"], "governance": governance_metadata(config, actor)
    }
    if type(lineage) == "dict" { state["lineage"] := lineage }
    manifest := {"schemaVersion": "1.0.0", "runId": run_id, "status": "running", "openedAt": started_at, "panelId": selected_panel["id"], "seatIds": selected_panel["seatIds"], "panelSource": resolved["source"], "docketSource": docket_path, "mockMode": config["kujo_ai"]["mock_mode"], "blindFirstPassRequired": true, "sdkBoundary": "KujoModelClient", "governance": state["governance"]}
    if has_key(resolved, "provenance") == 1 { manifest["panelConfigProvenance"] := resolved["provenance"] }
    if type(lineage) == "dict" { manifest["lineage"] := lineage }
    state["manifest"] := manifest
    save_json(storage_dir, run_id, "manifest.json", manifest)
    save_text(storage_dir, run_id, "events.jsonl", "")
    emit(storage_dir, run_id, "open-docket", "run_opened", "Tribunal run opened.", "", {"panelId": panel_id})
    opened := open_docket(config, docket_path)
    if opened["ok"] != true { return stop_run(config, state, opened["error"], private_key, public_key) }
    docket := opened["docket"]
    state["docket"] := docket
    save_text(storage_dir, run_id, "docket.md", docket["content"])
    state = completed(state, "open-docket")
    persist_checkpoint(storage_dir, state, "open-docket")

    state["currentStage"] := "validate-scope"
    emit(storage_dir, run_id, "validate-scope", "stage_started", "Scope validation started.", "", {})
    if trim(docket["scope"]) == "" { return stop_run(config, state, "Docket scope is missing.", private_key, public_key) }
    emit(storage_dir, run_id, "validate-scope", "docket_validated", "Docket scope validated.", "", {"contentSha256": docket["contentSha256"]})
    state = completed(state, "validate-scope")
    persist_checkpoint(storage_dir, state, "validate-scope")

    state["currentStage"] := "build-context-pack"
    emit(storage_dir, run_id, "build-context-pack", "stage_started", "Context construction started.", "", {})
    context_result := build_context(config, docket)
    if context_result["ok"] != true { return stop_run(config, state, context_result["error"], private_key, public_key) }
    context := context_result["content"]
    if utf8_byte_length(context) > config["limits"]["max_context_bytes"] { return stop_run(config, state, "Context pack exceeds the configured safety limit.", private_key, public_key) }
    state["context"] := context
    save_text(storage_dir, run_id, "context.md", context)
    emit(storage_dir, run_id, "build-context-pack", "context_pack_created", "Immutable context pack created.", "", {"provider": context_result["provider"], "warnings": context_result["warnings"], "sources": dict_get(context_result, "sources", [])})
    state = completed(state, "build-context-pack")
    persist_checkpoint(storage_dir, state, "build-context-pack")

    state["currentStage"] := "blind-first-pass"
    emit(storage_dir, run_id, "blind-first-pass", "stage_started", "Blind first pass started.", "", {"seatCount": len(selected_seats)})
    # Workers receive only immutable context plus their own seat contract. Results
    # are persisted below in canonical panel order; failed-stage results are discarded.
    blind := blind_calls(config, storage_dir, state, selected_seats, context)
    emit(storage_dir, run_id, "blind-first-pass", "parallel_execution_evaluated", "Blind model calls completed under the runtime-safe concurrency bound.", "", {"requestedConcurrency": blind["requestedConcurrency"], "effectiveConcurrency": blind["concurrency"], "runtimeGate": blind["runtimeGate"], "deterministicPersistenceOrder": true, "providerRateLimitBound": true, "cancelOnFailure": true})
    if blind["ok"] != true { return stop_run(config, state, blind["error"], private_key, public_key) }
    mut blind_index := 0
    for seat_value in selected_seats {
        call := persist_model_result(storage_dir, run_id, "blind-first-pass", seat_value, blind["results"][blind_index])
        blind_index = blind_index + 1
        state = add_usage(state, call)
        if call["ok"] != true { return stop_run(config, state, call["error"], private_key, public_key) }
        testimony := {"seatId": seat_value["id"], "stageId": "blind-first-pass", "capturedAt": now_utc(), "content": call["content"], "structured": call["structured"], "metadata": call["metadata"], "blind": true}
        state["testimonies"] := push(state["testimonies"], testimony)
        save_text(storage_dir, run_id, "testimony/" + seat_value["id"] + ".md", testimony_markdown(seat_value, testimony))
        emit(storage_dir, run_id, "blind-first-pass", "testimony_captured", "Blind testimony captured.", seat_value["id"], {"blind": true})
    }
    state = completed(state, "blind-first-pass")
    persist_checkpoint(storage_dir, state, "blind-first-pass")

    state["currentStage"] := "cross-examination"
    emit(storage_dir, run_id, "cross-examination", "stage_started", "Cross-examination started after all blind testimony was persisted.", "", {})
    transcript := to_json_pretty(state["testimonies"])
    for seat_value in selected_seats {
        input := context + "\n\n# Complete blind testimony record\n\n" + transcript + "\n\nChallenge the strongest opposing claims without changing the docket scope."
        call := call_model(config, storage_dir, state, "cross-examination", seat_value, input, seat_value["requiredOutputSchema"])
        state = add_usage(state, call)
        if call["ok"] != true { return stop_run(config, state, call["error"], private_key, public_key) }
        cross := {"seatId": seat_value["id"], "capturedAt": now_utc(), "content": call["content"], "structured": call["structured"], "metadata": call["metadata"]}
        state["crossExaminations"] := push(state["crossExaminations"], cross)
        emit(storage_dir, run_id, "cross-examination", "cross_examination_captured", "Cross-examination captured.", seat_value["id"], {})
    }
    save_text(storage_dir, run_id, "cross-examination.md", cross_markdown(state["crossExaminations"], index_by_id(selected_seats)))
    state = completed(state, "cross-examination")
    persist_checkpoint(storage_dir, state, "cross-examination")

    state["currentStage"] := "executioner-kill-pass"
    emit(storage_dir, run_id, "executioner-kill-pass", "stage_started", "Executioner kill pass started.", "executioner", {})
    executioner := seat("executioner")
    kill_schema := {"type": "object", "required": ["fatalFlaws", "survivableRisks", "requiredChanges", "recommendation"], "properties": {"fatalFlaws": {"type": "array", "items": {"type": "string"}}, "survivableRisks": {"type": "array", "items": {"type": "string"}}, "requiredChanges": {"type": "array", "items": {"type": "string"}}, "recommendation": {"enum": ["kill", "survive", "redesign"]}}, "additionalProperties": false}
    kill_input := context + "\n\n# Testimony\n\n" + transcript + "\n\n# Cross-examination\n\n" + to_json_pretty(state["crossExaminations"])
    kill_call := call_model(config, storage_dir, state, "executioner-kill-pass", executioner, kill_input, kill_schema)
    state = add_usage(state, kill_call)
    if kill_call["ok"] != true { return stop_run(config, state, kill_call["error"], private_key, public_key) }
    ks := kill_call["structured"]
    kill_pass := {"seatId": "executioner", "capturedAt": now_utc(), "fatalFlaws": dict_get(ks, "fatalFlaws", []), "survivableRisks": dict_get(ks, "survivableRisks", []), "requiredChanges": dict_get(ks, "requiredChanges", []), "recommendation": dict_get(ks, "recommendation", "redesign"), "content": kill_call["content"], "metadata": kill_call["metadata"]}
    state["killPass"] := kill_pass
    save_text(storage_dir, run_id, "kill-pass.md", kill_markdown(kill_pass))
    emit(storage_dir, run_id, "executioner-kill-pass", "kill_pass_captured", "Executioner kill pass captured.", "executioner", {"recommendation": kill_pass["recommendation"]})
    state = completed(state, "executioner-kill-pass")
    persist_checkpoint(storage_dir, state, "executioner-kill-pass")

    state["currentStage"] := "judge-ruling"
    emit(storage_dir, run_id, "judge-ruling", "stage_started", "Judge ruling started.", "judge", {})
    ruling := null
    if selected_panel["id"] == "executioner-only" {
        ruling = procedural_ruling(kill_pass)
    } else {
        judge := seat("judge")
        ruling_schema := {"type": "object", "required": ["finalVerdict", "bestArgumentFor", "bestArgumentAgainst", "panelAgreement", "unresolved", "requiredChanges", "confidence", "disposition"], "properties": {"finalVerdict": {"type": "string", "minLength": 1}, "bestArgumentFor": {"type": "string"}, "bestArgumentAgainst": {"type": "string"}, "panelAgreement": {"type": "array", "items": {"type": "string"}}, "unresolved": {"type": "array", "items": {"type": "string"}}, "requiredChanges": {"type": "array", "items": {"type": "string"}}, "confidence": {"type": "integer", "minimum": 0, "maximum": 10}, "disposition": {"enum": ["proceed", "reject", "redesign"]}}, "additionalProperties": false}
        ruling_input := context + "\n\n# Blind testimony\n\n" + transcript + "\n\n# Cross-examination\n\n" + to_json_pretty(state["crossExaminations"]) + "\n\n# Executioner findings\n\n" + to_json_pretty(kill_pass)
        ruling_call := call_model(config, storage_dir, state, "judge-ruling", judge, ruling_input, ruling_schema)
        state = add_usage(state, ruling_call)
        if ruling_call["ok"] != true { return stop_run(config, state, ruling_call["error"], private_key, public_key) }
        ruling = ruling_call["structured"]
        ruling["generatedAt"] := now_utc()
        ruling["metadata"] := ruling_call["metadata"]
    }
    state["ruling"] := ruling
    save_text(storage_dir, run_id, "ruling.md", ruling_markdown(ruling))
    emit(storage_dir, run_id, "judge-ruling", "ruling_generated", "Tribunal ruling generated.", "judge", {"disposition": ruling["disposition"], "confidence": ruling["confidence"]})
    state = completed(state, "judge-ruling")
    persist_checkpoint(storage_dir, state, "judge-ruling")

    state["currentStage"] := "decision-packet"
    emit(storage_dir, run_id, "decision-packet", "stage_started", "Decision packet generation started.", "judge", {})
    packet := null
    if selected_panel["id"] == "executioner-only" {
        packet = procedural_packet(docket, ruling)
    } else {
        judge := seat("judge")
        packet_schema := {"type": "object", "required": ["decision", "scope", "nonGoals", "requiredNextActions", "suggestedOwnerRole", "suggestedModelLevel", "acceptanceCriteria", "escalationTriggers", "evidenceRequired", "stopTheLineConditions"], "properties": {"decision": {"type": "string", "minLength": 1}, "scope": {"type": "string", "minLength": 1}, "nonGoals": {"type": "array", "items": {"type": "string"}}, "requiredNextActions": {"type": "array", "items": {"type": "string"}}, "suggestedOwnerRole": {"type": "string", "minLength": 1}, "suggestedModelLevel": {"type": "string", "minLength": 1}, "acceptanceCriteria": {"type": "array", "items": {"type": "string"}}, "escalationTriggers": {"type": "array", "items": {"type": "string"}}, "evidenceRequired": {"type": "array", "items": {"type": "string"}}, "stopTheLineConditions": {"type": "array", "items": {"type": "string"}}}, "additionalProperties": false}
        packet_input := "# Docket\n" + docket["content"] + "\n\n# Final ruling\n" + to_json_pretty(ruling)
        packet_call := call_model(config, storage_dir, state, "decision-packet", judge, packet_input, packet_schema)
        state = add_usage(state, packet_call)
        if packet_call["ok"] != true { return stop_run(config, state, packet_call["error"], private_key, public_key) }
        packet = packet_call["structured"]
        packet["generatedAt"] := now_utc()
    }
    state["decisionPacket"] := packet
    contracted := apply_decision_contracts(config, packet, ruling)
    if contracted["ok"] != true { return stop_run(config, state, contracted["error"], private_key, public_key) }
    packet = contracted["packet"]
    state["decisionPacket"] := packet
    state["decisionPolicy"] := contracted["report"]
    save_json(storage_dir, run_id, "policy-checks.json", contracted["report"])
    save_text(storage_dir, run_id, "decision-packet.md", packet_markdown(packet))
    emit(storage_dir, run_id, "decision-packet", "decision_packet_generated", "Agent-readable decision packet generated.", "judge", {})
    state = completed(state, "decision-packet")
    persist_checkpoint(storage_dir, state, "decision-packet")

    state["currentStage"] := "persist-record"
    emit(storage_dir, run_id, "persist-record", "stage_started", "Durable record persistence started.", "", {})
    completed_at := now_utc()
    state = completed(state, "persist-record")
    persist_checkpoint(storage_dir, state, "persist-record")
    record := {"schemaVersion": "1.0.0", "runId": run_id, "status": "completed", "startedAt": started_at, "completedAt": completed_at, "docket": docket, "panel": selected_panel, "seats": selected_seats, "stagesCompleted": state["stagesCompleted"], "testimonies": state["testimonies"], "crossExaminations": state["crossExaminations"], "killPass": kill_pass, "ruling": ruling, "decisionPacket": packet, "decisionPolicy": state["decisionPolicy"], "governance": state["governance"], "artifactPaths": artifact_paths(state)}
    if type(lineage) == "dict" { record["lineage"] := lineage }
    save_json(storage_dir, run_id, "record.json", record)
    record_hash := sha256(read_file(artifact_path(storage_dir, run_id, "record.json")))
    emit(storage_dir, run_id, "persist-record", "record_persisted", "Structured Tribunal record persisted.", "", {"recordSha256": record_hash})
    save_json(storage_dir, run_id, "receipt.json", receipt(state, "completed", completed_at, record_hash))
    emit(storage_dir, run_id, "persist-record", "run_completed", "Tribunal run completed.", "", {})
    manifest["status"] := "completed"
    manifest["completedAt"] := completed_at
    save_json(storage_dir, run_id, "manifest.json", manifest)
    sealed := seal(storage_dir, run_id, private_key, public_key)
    release_lock(storage_dir, run_id, state["lockToken"])
    if sealed["ok"] != true { return {"ok": false, "runId": run_id, "runDir": root, "error": sealed["error"], "record": record} }
    return {"ok": true, "runId": run_id, "runDir": root, "record": record}
}

export func review(config, docket_path, panel_id, private_key, public_key) {
    return review_internal(config, docket_path, panel_id, private_key, public_key, null)
}

export func resume(config, prior_run_id, private_key, public_key) {
    storage_dir := config["tribunal"]["storage_dir"]
    prior_record_path := artifact_path(storage_dir, prior_run_id, "record.json")
    checkpoint_path := artifact_path(storage_dir, prior_run_id, "checkpoint.json")
    prior_docket := artifact_path(storage_dir, prior_run_id, "docket.md")
    if file_exists(prior_record_path) == false || file_exists(checkpoint_path) == false || file_exists(prior_docket) == false { return {"ok": false, "error": "Prior run is not resumable: immutable record, docket, or checkpoint is missing."} }
    prior := parse_json(read_file(prior_record_path))
    checkpoint := parse_json(read_file(checkpoint_path))
    if prior["status"] != "stopped" { return {"ok": false, "error": "Only stopped hearings may be resumed."} }
    integrity := verify(storage_dir, prior_run_id, "")
    if integrity["ok"] != true { return {"ok": false, "error": "Prior hearing integrity failed; resume is forbidden.", "verification": integrity} }
    lineage := {"schemaVersion": "1.0.0", "priorRunId": prior_run_id, "priorRecordSha256": sha256(read_file(prior_record_path)), "priorCheckpointSha256": sha256(read_file(checkpoint_path)), "resumeFromStage": checkpoint["lastCompletedStage"], "resumedAt": now_utc(), "replayPolicy": "full-stage-replay-with-stable-idempotency-keys"}
    return review_internal(config, prior_docket, prior["panel"]["id"], private_key, public_key, lineage)
}
