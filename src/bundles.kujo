# Tribunal :: signed evidence bundle export and import

from src.common import dict_get, ensure_dir, path_within, read_json, relative_files, remove_tree, safe_relative_path, safe_run_id, write_json
from src.integrity import signature_payload_for, verify
from src.policy import trusted_key
from src.storage import artifact_path, index_run_manifest, run_dir

MAX_BUNDLE_ARTIFACTS := 10000
MAX_BUNDLE_ARTIFACT_BYTES := 67108864
MAX_BUNDLE_BYTES := 1073741824
MAX_BUNDLE_METADATA_BYTES := 4194304
STREAM_CHUNK_BYTES := 1048576

BUNDLE_SCHEMA := {
    "type": "object",
    "required": ["schemaVersion", "runId", "exportedAt", "manifestSha256", "keyId", "artifactCount", "artifacts"],
    "properties": {
        "schemaVersion": {"const": "1.0.0"},
        "runId": {"type": "string", "minLength": 1, "maxLength": 128},
        "exportedAt": {"type": "string", "minLength": 1},
        "manifestSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "keyId": {"type": "string", "pattern": "^[a-f0-9]{32}$"},
        "artifactCount": {"type": "integer", "minimum": 1, "maximum": 10000},
        "artifacts": {"type": "array", "minItems": 1, "maxItems": 10000, "items": {"type": "string"}}
        ,"artifactDescriptors": {"type": "array", "maxItems": 10000, "items": {"type": "object", "required": ["path", "bytes", "sha256", "chunkBytes", "chunks"], "properties": {"path": {"type": "string"}, "bytes": {"type": "integer", "minimum": 0, "maximum": 67108864}, "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "chunkBytes": {"const": 1048576}, "chunks": {"type": "integer", "minimum": 1, "maximum": 64}}, "additionalProperties": false}}
    },
    "additionalProperties": false
}

export func validate_bundle_metadata(metadata) {
    checked := json_schema_validate(metadata, BUNDLE_SCHEMA)
    if checked["valid"] != true { return {"ok": false, "error": "Bundle metadata failed validation.", "details": checked["errors"]} }
    if safe_run_id(metadata["runId"]) == false { return {"ok": false, "error": "Bundle run ID is unsafe."} }
    if metadata["artifactCount"] != len(metadata["artifacts"]) { return {"ok": false, "error": "Bundle artifact count does not match its inventory."} }
    if has_key(metadata, "artifactDescriptors") == 1 && len(metadata["artifactDescriptors"]) != metadata["artifactCount"] { return {"ok": false, "error": "Bundle descriptor count does not match its inventory."} }
    mut seen := {}
    for name in metadata["artifacts"] {
        if safe_relative_path(name) == false { return {"ok": false, "error": "Unsafe bundle artifact path: " + name} }
        if has_key(seen, name) == 1 { return {"ok": false, "error": "Duplicate bundle artifact path: " + name} }
        seen[name] := true
    }
    return {"ok": true}
}

func stream_copy(source, target, size) {
    write_file(target, "")
    mut offset := 0
    while offset < size {
        count := STREAM_CHUNK_BYTES
        if size - offset < count { count = size - offset }
        chunk := io_read_at(source, offset, count)
        if len(chunk) != count { return false }
        io_append_bytes(target, chunk)
        offset = offset + count
    }
    return file_size(target) == size
}

func copy_relative(source_root, destination_root, names) {
    if type(names) != "array" || len(names) == 0 || len(names) > MAX_BUNDLE_ARTIFACTS { return {"ok": false, "error": "Bundle artifact inventory is outside safety limits."} }
    mut total_bytes := 0
    mut seen := {}
    for name in names {
        if safe_relative_path(name) == false { return {"ok": false, "error": "Unsafe bundle artifact path: " + name} }
        if has_key(seen, name) == 1 { return {"ok": false, "error": "Duplicate bundle artifact path: " + name} }
        seen[name] := true
        source := join_path(source_root, name)
        if file_exists(source) == false || path_is_dir(source) || path_is_symlink(source) { return {"ok": false, "error": "Bundle artifact is missing or unsafe: " + name} }
        size := file_size(source)
        if size < 0 || size > MAX_BUNDLE_ARTIFACT_BYTES { return {"ok": false, "error": "Bundle artifact exceeds the per-file safety limit: " + name} }
        total_bytes = total_bytes + size
        if total_bytes > MAX_BUNDLE_BYTES { return {"ok": false, "error": "Bundle exceeds the aggregate safety limit."} }
        target := join_path(destination_root, name)
        ensure_dir(dirname(target))
        if stream_copy(source, target, size) == false { return {"ok": false, "error": "Bundle artifact streaming copy failed: " + name} }
    }
    return {"ok": true, "bytes": total_bytes, "artifacts": len(names)}
}

export func export_bundle(storage_dir, run_id, destination) {
    if trim(destination) == "" { return {"ok": false, "error": "Bundle destination is required."} }
    if path_within(storage_dir, destination) { return {"ok": false, "error": "Bundle destination must be outside Tribunal run storage."} }
    run_root := run_dir(storage_dir, run_id)
    if run_root == "" || path_is_dir(run_root) == false { return {"ok": false, "error": "Run does not exist."} }
    signature := artifact_path(storage_dir, run_id, "signature.json")
    if file_exists(signature) == false { return {"ok": false, "error": "Only signed runs can be exported as trusted bundles."} }
    integrity := verify(storage_dir, run_id, "")
    if integrity["ok"] != true { return {"ok": false, "error": "Run integrity must pass before bundle export.", "verification": integrity} }
    if file_exists(destination) || path_is_dir(destination) { return {"ok": false, "error": "Bundle destination already exists."} }
    ensure_dir(destination)
    artifacts_root := join_path(destination, "artifacts")
    ensure_dir(artifacts_root)
    names := relative_files(run_root, "")
    if len(names) == 0 || len(names) > MAX_BUNDLE_ARTIFACTS { remove_tree(destination); return {"ok": false, "error": "Run artifact inventory is outside bundle safety limits."} }
    copied := copy_relative(run_root, artifacts_root, names)
    if copied["ok"] != true { remove_tree(destination); return copied }
    envelope := read_json(signature)
    bundle := {
        "schemaVersion": "1.0.0",
        "runId": run_id,
        "exportedAt": now_utc(),
        "manifestSha256": dict_get(envelope, "manifestSha256", ""),
        "keyId": dict_get(envelope, "keyId", ""),
        "artifactCount": len(names),
        "artifacts": names,
        "artifactDescriptors": []
    }
    mut descriptors := []
    for name in names {
        source := join_path(run_root, name); bytes := file_size(source); chunks := to_int((bytes + STREAM_CHUNK_BYTES - 1) / STREAM_CHUNK_BYTES)
        if chunks < 1 { chunks = 1 }
        descriptors = push(descriptors, {"path": name, "bytes": bytes, "sha256": sha256_file(source), "chunkBytes": STREAM_CHUNK_BYTES, "chunks": chunks})
    }
    bundle["artifactDescriptors"] := descriptors
    write_json(join_path(destination, "bundle.json"), bundle)
    return {"ok": true, "bundle": bundle, "path": path_absolute(destination)}
}

export func import_bundle(bundle_path, storage_dir, trust_policy, target) {
    if trim(bundle_path) == "" || path_is_dir(bundle_path) == false { return {"ok": false, "error": "Bundle path is missing or unsafe."} }
    if path_is_symlink(bundle_path) { return {"ok": false, "error": "Bundle path is unsafe."} }
    metadata_path := join_path(bundle_path, "bundle.json")
    artifacts_root := join_path(bundle_path, "artifacts")
    if file_exists(metadata_path) == false || path_is_symlink(metadata_path) || file_size(metadata_path) > MAX_BUNDLE_METADATA_BYTES || path_is_dir(artifacts_root) == false || path_is_symlink(artifacts_root) { return {"ok": false, "error": "Bundle structure is incomplete or unsafe."} }
    metadata := null
    try { metadata = read_json(metadata_path) } except err { return {"ok": false, "error": "Bundle metadata is invalid."} }
    checked_metadata := validate_bundle_metadata(metadata)
    if checked_metadata["ok"] != true { return checked_metadata }
    run_id := dict_get(metadata, "runId", "")
    destination := run_dir(storage_dir, run_id)
    if destination == "" || path_is_dir(destination) { return {"ok": false, "error": "Bundle run ID is unsafe or already exists."} }
    trusted := trusted_key(trust_policy, dict_get(metadata, "keyId", ""), target, current_timestamp())
    if trusted["ok"] != true { return trusted }
    ensure_dir(destination)
    copied := copy_relative(artifacts_root, destination, dict_get(metadata, "artifacts", []))
    if copied["ok"] != true { remove_tree(destination); return copied }
    checked := verify(storage_dir, run_id, trusted["key"]["publicKeyPath"])
    if checked["ok"] != true || checked["signature"] != "verified" || checked["manifestSha256"] != metadata["manifestSha256"] {
        remove_tree(destination)
        return {"ok": false, "error": "Imported bundle failed trusted verification.", "verification": checked}
    }
    indexed := index_run_manifest(storage_dir, run_id)
    if indexed["ok"] != true { remove_tree(destination); return {"ok": false, "error": "Imported bundle could not update the run index."} }
    return {"ok": true, "runId": run_id, "path": destination, "verification": checked}
}

ENCRYPTED_BUNDLE_SCHEMA := {
    "type": "object",
    "required": ["schemaVersion", "runId", "createdAt", "cipher", "keyWrap", "manifestSha256", "signingKeyId", "wrappedKeys", "artifactCount", "artifacts", "legalHold"],
    "properties": {
        "schemaVersion": {"enum": ["1.0.0", "1.1.0"]},
        "runId": {"type": "string", "minLength": 1, "maxLength": 128},
        "createdAt": {"type": "string", "minLength": 1},
        "cipher": {"const": "AES-256-GCM"},
        "format": {"enum": ["whole-value", "KUJOAEAD1"]},
        "keyWrap": {"const": "RSA-OAEP"},
        "manifestSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "signingKeyId": {"type": "string", "pattern": "^[a-f0-9]{32}$"},
        "wrappedKeys": {"type": "array", "minItems": 1, "maxItems": 16, "items": {"type": "object", "required": ["recipientKeyId", "purpose", "encryptedKey"], "properties": {"recipientKeyId": {"type": "string", "pattern": "^[a-f0-9]{32}$"}, "purpose": {"enum": ["primary", "recovery"]}, "encryptedKey": {"type": "string", "minLength": 40, "maxLength": 1048576}}, "additionalProperties": false}},
        "artifactCount": {"type": "integer", "minimum": 1, "maximum": 10000},
        "artifacts": {"type": "array", "minItems": 1, "maxItems": 10000, "items": {"type": "object", "required": ["path", "bytes", "plaintextSha256", "ciphertextSha256"], "properties": {"path": {"type": "string", "minLength": 1}, "bytes": {"type": "integer", "minimum": 0, "maximum": 67108864}, "plaintextSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "ciphertextSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}, "additionalProperties": false}},
        "legalHold": {"type": "boolean"}
    },
    "additionalProperties": false
}

func recipient_wrap(public_path, purpose, data_key) {
    if file_exists(public_path) == false || path_is_symlink(public_path) || file_size(public_path) > 1048576 { return {"ok": false, "error": "Recipient public key is missing or unsafe."} }
    public_key := read_file(public_path)
    if contains(public_key, "PUBLIC KEY") == 0 || contains(public_key, "PRIVATE KEY") == 1 { return {"ok": false, "error": "Recipient key is not a public key."} }
    wrapped := null
    try { wrapped = rsa_encrypt(data_key, public_key) } except err { wrapped = null }
    if type(wrapped) != "string" { return {"ok": false, "error": "Unable to wrap evidence data key."} }
    return {"ok": true, "entry": {"recipientKeyId": substring(sha256(public_key), 0, 32), "purpose": purpose, "encryptedKey": wrapped}}
}

export func export_encrypted_bundle(storage_dir, run_id, destination, recipient_public_path, recovery_public_path) {
    if trim(destination) == "" || file_exists(destination) || path_is_dir(destination) { return {"ok": false, "error": "Encrypted bundle destination must be new."} }
    temp := join_path(env_or("TMPDIR", "/tmp"), "tribunal-encrypted-export-" + uuid_v4())
    exported := export_bundle(storage_dir, run_id, temp)
    if exported["ok"] != true { return exported }
    data_key := sha256(uuid_v4() + ":" + uuid_v4() + ":" + to_string(current_timestamp()))
    primary := recipient_wrap(recipient_public_path, "primary", data_key)
    if primary["ok"] != true { remove_tree(temp); return primary }
    wrapped_keys := [primary["entry"]]
    if trim(recovery_public_path) != "" {
        recovery := recipient_wrap(recovery_public_path, "recovery", data_key)
        if recovery["ok"] != true { remove_tree(temp); return recovery }
        if recovery["entry"]["recipientKeyId"] == primary["entry"]["recipientKeyId"] { remove_tree(temp); return {"ok": false, "error": "Recovery recipient must use a distinct key."} }
        wrapped_keys = push(wrapped_keys, recovery["entry"])
    }
    ensure_dir(join_path(destination, "artifacts"))
    ensure_dir(join_path(destination, "integrity"))
    mut entries := []
    for name in exported["bundle"]["artifacts"] {
        source := join_path(join_path(temp, "artifacts"), name)
        target := join_path(join_path(destination, "artifacts"), name + ".enc")
        ensure_dir(dirname(target))
        encrypted := aes_encrypt_file_stream(source, target, data_key, 1048576)
        if type(encrypted) != "dict" || encrypted["ok"] != true { remove_tree(temp); remove_tree(destination); return {"ok": false, "error": "Streaming encryption failed for " + name} }
        entries = push(entries, {"path": name, "bytes": encrypted["bytes_in"], "plaintextSha256": encrypted["plaintext_sha256"], "ciphertextSha256": sha256_file(target)})
    }
    copy_file(join_path(join_path(temp, "artifacts"), "artifact-manifest.json"), join_path(join_path(destination, "integrity"), "artifact-manifest.json"))
    copy_file(join_path(join_path(temp, "artifacts"), "signature.json"), join_path(join_path(destination, "integrity"), "signature.json"))
    legal_hold := false
    record_path := join_path(join_path(temp, "artifacts"), "record.json")
    if file_exists(record_path) {
        record := read_json(record_path)
        legal_hold = dict_get(dict_get(record, "governance", {}), "legalHold", false)
    }
    envelope := {"schemaVersion": "1.1.0", "runId": run_id, "createdAt": now_utc(), "cipher": "AES-256-GCM", "format": "KUJOAEAD1", "keyWrap": "RSA-OAEP", "manifestSha256": exported["bundle"]["manifestSha256"], "signingKeyId": exported["bundle"]["keyId"], "wrappedKeys": wrapped_keys, "artifactCount": len(entries), "artifacts": entries, "legalHold": legal_hold}
    write_json(join_path(destination, "bundle.json"), exported["bundle"])
    write_json(join_path(destination, "envelope.json"), envelope)
    remove_tree(temp)
    return {"ok": true, "path": path_absolute(destination), "envelope": envelope}
}

export func verify_encrypted_bundle_integrity(bundle_path, signing_public_path) {
    envelope_path := join_path(bundle_path, "envelope.json")
    manifest_path := join_path(join_path(bundle_path, "integrity"), "artifact-manifest.json")
    signature_path := join_path(join_path(bundle_path, "integrity"), "signature.json")
    if file_exists(envelope_path) == false || file_exists(manifest_path) == false || file_exists(signature_path) == false || file_exists(signing_public_path) == false { return {"ok": false, "error": "Encrypted bundle integrity evidence is incomplete."} }
    envelope := read_json(envelope_path)
    contract := json_schema_validate(envelope, ENCRYPTED_BUNDLE_SCHEMA)
    if contract["valid"] != true || envelope["artifactCount"] != len(envelope["artifacts"]) { return {"ok": false, "error": "Encrypted bundle envelope failed validation."} }
    manifest_text := read_file(manifest_path)
    signature := read_json(signature_path)
    public_key := read_file(signing_public_path)
    if sha256(manifest_text) != envelope["manifestSha256"] || dict_get(signature, "manifestSha256", "") != envelope["manifestSha256"] || dict_get(signature, "keyId", "") != envelope["signingKeyId"] || substring(sha256(public_key), 0, 32) != envelope["signingKeyId"] { return {"ok": false, "error": "Encrypted bundle signed manifest binding is invalid."} }
    payload := signature_payload_for(signature["schemaVersion"], envelope["runId"], envelope["manifestSha256"], envelope["signingKeyId"], signature["signedAt"])
    signature_ok := false
    try { signature_ok = rsa_verify(to_json(payload), signature["signature"], public_key) } except err { signature_ok = false }
    if signature_ok != true { return {"ok": false, "error": "Encrypted bundle manifest signature is invalid."} }
    for entry in envelope["artifacts"] {
        if safe_relative_path(entry["path"]) == false { return {"ok": false, "error": "Encrypted bundle contains an unsafe artifact path."} }
        cipher_path := join_path(join_path(bundle_path, "artifacts"), entry["path"] + ".enc")
        if file_exists(cipher_path) == false || path_is_symlink(cipher_path) || sha256_file(cipher_path) != entry["ciphertextSha256"] { return {"ok": false, "error": "Encrypted artifact integrity failed: " + entry["path"]} }
    }
    return {"ok": true, "runId": envelope["runId"], "manifestSha256": envelope["manifestSha256"], "signature": "verified", "confidentiality": "not-required-for-integrity-check", "legalHold": envelope["legalHold"]}
}

func unwrap_data_key(wrapped_keys, recipient_private_path) {
    if file_exists(recipient_private_path) == false || path_is_symlink(recipient_private_path) || file_size(recipient_private_path) > 1048576 { return {"ok": false, "error": "Recipient private key is missing or unsafe."} }
    private_key := read_file(recipient_private_path)
    for wrapped in wrapped_keys {
        value := null
        try { value = rsa_decrypt(wrapped["encryptedKey"], private_key) } except err { value = null }
        if type(value) == "string" && len(value) == 64 { return {"ok": true, "dataKey": value, "recipientKeyId": wrapped["recipientKeyId"], "purpose": wrapped["purpose"]} }
    }
    return {"ok": false, "error": "No envelope key can be recovered with the supplied recipient key."}
}

export func import_encrypted_bundle(bundle_path, storage_dir, trust_policy, target, recipient_private_path) {
    envelope_path := join_path(bundle_path, "envelope.json")
    if file_exists(envelope_path) == false || path_is_symlink(envelope_path) || file_size(envelope_path) > MAX_BUNDLE_METADATA_BYTES { return {"ok": false, "error": "Encrypted bundle envelope is missing or unsafe."} }
    envelope := read_json(envelope_path)
    contract := json_schema_validate(envelope, ENCRYPTED_BUNDLE_SCHEMA)
    if contract["valid"] != true { return {"ok": false, "error": "Encrypted bundle envelope failed validation."} }
    unwrapped := unwrap_data_key(envelope["wrappedKeys"], recipient_private_path)
    if unwrapped["ok"] != true { return unwrapped }
    temp := join_path(env_or("TMPDIR", "/tmp"), "tribunal-encrypted-import-" + uuid_v4())
    ensure_dir(join_path(temp, "artifacts"))
    copy_file(join_path(bundle_path, "bundle.json"), join_path(temp, "bundle.json"))
    for entry in envelope["artifacts"] {
        if safe_relative_path(entry["path"]) == false { remove_tree(temp); return {"ok": false, "error": "Encrypted bundle contains an unsafe artifact path."} }
        cipher_path := join_path(join_path(bundle_path, "artifacts"), entry["path"] + ".enc")
        if file_exists(cipher_path) == false || sha256_file(cipher_path) != entry["ciphertextSha256"] { remove_tree(temp); return {"ok": false, "error": "Encrypted artifact integrity failed: " + entry["path"]} }
        target_path := join_path(join_path(temp, "artifacts"), entry["path"])
        ensure_dir(dirname(target_path))
        if dict_get(envelope, "format", "whole-value") == "KUJOAEAD1" {
            decrypted := aes_decrypt_file_stream(cipher_path, target_path, unwrapped["dataKey"])
            if type(decrypted) != "dict" || decrypted["ok"] != true || decrypted["plaintext_sha256"] != entry["plaintextSha256"] || decrypted["bytes_out"] != entry["bytes"] { remove_tree(temp); return {"ok": false, "error": "Encrypted artifact authentication failed: " + entry["path"]} }
        } else {
            plaintext := null
            try { plaintext = aes_decrypt(read_file(cipher_path), unwrapped["dataKey"]) } except err { plaintext = null }
            if type(plaintext) != "string" || sha256(plaintext) != entry["plaintextSha256"] || len(decode_base64(encode_base64(plaintext))) != entry["bytes"] { remove_tree(temp); return {"ok": false, "error": "Encrypted artifact authentication failed: " + entry["path"]} }
            write_file(target_path, plaintext)
        }
    }
    imported := import_bundle(temp, storage_dir, trust_policy, target)
    remove_tree(temp)
    if imported["ok"] == true { imported["encryptionRecipientKeyId"] := unwrapped["recipientKeyId"]; imported["recoveryPurpose"] := unwrapped["purpose"] }
    return imported
}

export func rotate_encrypted_bundle_key(bundle_path, current_private_path, new_public_path) {
    envelope_path := join_path(bundle_path, "envelope.json")
    if file_exists(envelope_path) == false || path_is_symlink(envelope_path) { return {"ok": false, "error": "Encrypted bundle envelope is missing or unsafe."} }
    envelope := read_json(envelope_path)
    unwrapped := unwrap_data_key(envelope["wrappedKeys"], current_private_path)
    if unwrapped["ok"] != true { return unwrapped }
    next := recipient_wrap(new_public_path, "primary", unwrapped["dataKey"])
    if next["ok"] != true { return next }
    mut retained := []
    for entry in envelope["wrappedKeys"] { if entry["purpose"] == "recovery" { retained = push(retained, entry) } }
    envelope["wrappedKeys"] := push(retained, next["entry"])
    envelope["createdAt"] := now_utc()
    write_json(envelope_path, envelope)
    return {"ok": true, "recipientKeyId": next["entry"]["recipientKeyId"], "ciphertextUnchanged": true}
}
