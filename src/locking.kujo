# Tribunal :: atomic per-run lock directories and crash recovery

from src.common import dict_get, ensure_dir, read_json, safe_run_id, write_json

func locks_root(storage_dir) { return join_path(storage_dir, ".locks") }
func lock_dir(storage_dir, run_id) { return join_path(locks_root(storage_dir), run_id + ".lock") }
func owner_path(storage_dir, run_id) { return join_path(lock_dir(storage_dir, run_id), "owner.json") }

func remove_lock(storage_dir, run_id) {
    path := lock_dir(storage_dir, run_id)
    if path_is_dir(path) == false { return {"ok": true, "removed": false} }
    if path_is_symlink(path) { return {"ok": false, "error": "Run lock path is unsafe."} }
    for name in list_dir(path) { if name != "owner.json" { return {"ok": false, "error": "Run lock contains unexpected state and requires operator reconciliation."} } }
    owner := owner_path(storage_dir, run_id)
    if file_exists(owner) { delete_file(owner) }
    try { os_rmdir(path) } except err { return {"ok": false, "error": "Unable to remove run lock directory."} }
    return {"ok": true, "removed": true}
}

export func acquire_lock(storage_dir, run_id, owner, stale_after_ms) {
    started_ms := current_timestamp()
    if safe_run_id(run_id) == false || owner == "" { return {"ok": false, "error": "Safe run ID and lock owner are required."} }
    if (file_exists(storage_dir) && path_is_symlink(storage_dir)) || (file_exists(locks_root(storage_dir)) && path_is_symlink(locks_root(storage_dir))) { return {"ok": false, "error": "Lock storage must not be a symbolic link."} }
    ensure_dir(storage_dir)
    ensure_dir(locks_root(storage_dir))
    path := lock_dir(storage_dir, run_id)
    if (file_exists(path) || path_is_dir(path)) && path_is_symlink(path) { return {"ok": false, "error": "Run lock path is unsafe."} }
    if path_is_dir(path) {
        existing := null
        try { existing = read_json(owner_path(storage_dir, run_id)) } except err { existing = null }
        acquired_ms := dict_get(existing, "acquiredAtMs", 0)
        stale := stale_after_ms > 0 && acquired_ms > 0 && current_timestamp() - acquired_ms > stale_after_ms
        return {"ok": false, "error": "Run is locked. Stale locks require explicit operator recovery.", "lock": existing, "stale": stale, "metrics": {"waitMs": current_timestamp() - started_ms, "contended": true}}
    }
    try { create_dir(path) } except err { return {"ok": false, "error": "Unable to acquire atomic run lock: " + to_string(err)} }
    token := sha256(run_id + ":" + owner + ":" + to_string(current_timestamp()) + ":" + to_string(random_int(1000, 9999)))
    lock := {"schemaVersion": "1.0.0", "runId": run_id, "owner": owner, "token": token, "acquiredAt": now_utc(), "acquiredAtMs": current_timestamp()}
    try { write_json(owner_path(storage_dir, run_id), lock) } except err { remove_lock(storage_dir, run_id); return {"ok": false, "error": "Unable to persist lock ownership."} }
    return {"ok": true, "lock": lock, "metrics": {"waitMs": current_timestamp() - started_ms, "contended": false}}
}

export func release_lock(storage_dir, run_id, token) {
    if path_is_dir(lock_dir(storage_dir, run_id)) == false { return {"ok": true, "released": false} }
    existing := null
    try { existing = read_json(owner_path(storage_dir, run_id)) } except err { return {"ok": false, "error": "Lock owner record is unreadable."} }
    if dict_get(existing, "token", "") != token { return {"ok": false, "error": "Lock token does not match the current owner."} }
    removed := remove_lock(storage_dir, run_id)
    if removed["ok"] != true { return removed }
    return {"ok": true, "released": true}
}

export func recover_stale_locks(storage_dir, stale_after_ms) {
    started_ms := current_timestamp()
    root := locks_root(storage_dir)
    mut recovered := []
    if stale_after_ms < 1000 { return {"ok": false, "error": "Stale-lock threshold must be at least 1000 ms.", "recovered": recovered, "recoveryMs": current_timestamp() - started_ms} }
    if path_is_dir(root) == false { return {"ok": true, "recovered": recovered, "recoveryMs": current_timestamp() - started_ms} }
    if path_is_symlink(root) { return {"ok": false, "error": "Lock root is unsafe.", "recovered": recovered} }
    for name in list_dir(root) {
        if ends_with(name, ".lock") {
            run_id := substring(name, 0, len(name) - 5)
            if safe_run_id(run_id) == false || path_is_symlink(lock_dir(storage_dir, run_id)) { continue }
            existing := null
            try { existing = read_json(owner_path(storage_dir, run_id)) } except err { existing = null }
            acquired_ms := dict_get(existing, "acquiredAtMs", 0)
            if acquired_ms == 0 || current_timestamp() - acquired_ms > stale_after_ms {
                removed := remove_lock(storage_dir, run_id)
                if removed["ok"] != true { return {"ok": false, "error": removed["error"], "runId": run_id, "recovered": recovered, "recoveryMs": current_timestamp() - started_ms} }
                recovered = push(recovered, run_id)
            }
        }
    }
    return {"ok": true, "recovered": recovered, "recoveryMs": current_timestamp() - started_ms}
}
