# Tribunal :: common Kujo-native helpers

export func truthy(value) {
    return value == true || value == 1
}

export func dict_get(value, key, fallback) {
    if type(value) == "dict" && truthy(has_key(value, key)) {
        return value[key]
    }
    return fallback
}

export func iso_now() {
    return format_date(now(), "YYYY-MM-DDTHH:mm:ssZ")
}

export func today_utc() {
    return format_date(now(), "YYYY-MM-DD")
}

export func slug(text) {
    lowered := to_lower(to_string(text))
    allowed := "abcdefghijklmnopqrstuvwxyz0123456789"
    mut out := ""
    mut dashed := true
    mut i := 0
    while i < len(lowered) {
        ch := substring(lowered, i, i + 1)
        if truthy(contains(allowed, ch)) {
            out = out + ch
            dashed = false
        } else if dashed == false {
            out = out + "-"
            dashed = true
        }
        i = i + 1
    }
    while len(out) > 0 && substring(out, len(out) - 1, len(out)) == "-" {
        out = substring(out, 0, len(out) - 1)
    }
    if out == "" { return "tribunal" }
    return out
}

export func parent_dir(path) {
    mut i := len(path) - 1
    while i >= 0 {
        if substring(path, i, i + 1) == "/" {
            if i == 0 { return "/" }
            return substring(path, 0, i)
        }
        i = i - 1
    }
    return "."
}

export func ensure_dir(path) {
    if path == "" || path == "." { return path }
    parts := split(path, "/")
    mut current := ""
    if starts_with(path, "/") { current = "/" }
    mut i := 0
    while i < len(parts) {
        part := parts[i]
        if part != "" && part != "." {
            if current == "/" {
                current = "/" + part
            } else if current == "" {
                current = part
            } else {
                current = current + "/" + part
            }
            if path_is_dir(current) == false { create_dir(current) }
        }
        i = i + 1
    }
    return path
}

export func write_text(path, content) {
    ensure_dir(parent_dir(path))
    tmp := path + ".tmp-" + to_string(current_timestamp()) + "-" + to_string(random_int(1000, 9999))
    if file_exists(tmp) { delete_file(tmp) }
    write_file(tmp, content)
    rename_file(tmp, path)
    return path
}

export func write_json(path, value) {
    return write_text(path, to_json_pretty(value) + "\n")
}

export func read_json(path) {
    return parse_json(read_file(path))
}

export func safe_run_id(id) {
    if type(id) != "string" || id == "" || len(id) > 128 || starts_with(id, ".") { return false }
    allowed := "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789._-"
    mut i := 0
    while i < len(id) {
        if truthy(contains(allowed, substring(id, i, i + 1))) == false { return false }
        i = i + 1
    }
    return true
}

export func safe_relative_path(path) {
    if type(path) != "string" || path == "" || len(path) > 1024 || starts_with(path, "/") || truthy(contains(path, "\\")) { return false }
    allowed := "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789._-"
    for part in split(path, "/") {
        if part == "" || part == "." || part == ".." || len(part) > 128 { return false }
        mut i := 0
        while i < len(part) {
            if truthy(contains(allowed, substring(part, i, i + 1))) == false { return false }
            i = i + 1
        }
    }
    return true
}

func normalized_absolute(path) {
    raw := path
    if starts_with(raw, "/") == false { raw = os_getcwd() + "/" + raw }
    mut parts := []
    for part in split(raw, "/") {
        if part == "" || part == "." { continue }
        if part == ".." {
            if len(parts) > 0 {
                mut shorter := []
                mut i := 0
                while i < len(parts) - 1 { shorter = push(shorter, parts[i]); i = i + 1 }
                parts = shorter
            }
        } else {
            parts = push(parts, part)
        }
    }
    return "/" + join(parts, "/")
}

export func path_within(root, candidate) {
    if type(root) != "string" || trim(root) == "" || type(candidate) != "string" || trim(candidate) == "" { return false }
    resolved_root := normalized_absolute(root)
    resolved_candidate := normalized_absolute(candidate)
    return resolved_candidate == resolved_root || starts_with(resolved_candidate, resolved_root + "/")
}

export func lower_hex(value, expected_length) {
    if type(value) != "string" || len(value) != expected_length { return false }
    mut i := 0
    while i < len(value) {
        if truthy(contains("0123456789abcdef", substring(value, i, i + 1))) == false { return false }
        i = i + 1
    }
    return true
}

export func parse_args(tokens, bool_flags) {
    mut positionals := []
    mut flags := {}
    mut errors := []
    mut i := 0
    while i < len(tokens) {
        token := tokens[i]
        if starts_with(token, "--") {
            key := substring(token, 2, len(token))
            if key == "" {
                errors = push(errors, "Invalid empty option '--'.")
                i = i + 1
                continue
            }
            if truthy(has_key(flags, key)) {
                errors = push(errors, "Option '--" + key + "' was supplied more than once.")
            }
            if array_includes(bool_flags, key) {
                flags[key] := true
            } else if i + 1 < len(tokens) && starts_with(tokens[i + 1], "--") == false {
                flags[key] := tokens[i + 1]
                i = i + 1
            } else {
                flags[key] := ""
                errors = push(errors, "Option '--" + key + "' requires a value.")
            }
        } else {
            positionals = push(positionals, token)
        }
        i = i + 1
    }
    return {"positionals": positionals, "flags": flags, "errors": errors}
}

export func flag(parsed, name, fallback) {
    flags := dict_get(parsed, "flags", {})
    if truthy(has_key(flags, name)) { return flags[name] }
    return fallback
}

export func has_flag(parsed, name) {
    return truthy(has_key(dict_get(parsed, "flags", {}), name))
}

export func positional(parsed, index, fallback) {
    values := dict_get(parsed, "positionals", [])
    if index >= 0 && index < len(values) { return values[index] }
    return fallback
}

export func slice_from(values, start) {
    mut out := []
    mut i := start
    while i < len(values) {
        out = push(out, values[i])
        i = i + 1
    }
    return out
}

export func append_all(target, values) {
    mut out := target
    for value in values { out = push(out, value) }
    return out
}

export func array_includes(values, candidate) {
    for value in values {
        if value == candidate { return true }
    }
    return false
}

export func index_by_id(values) {
    mut out := {}
    for value in values { out[value["id"]] := value }
    return out
}

export func redact(text) {
    value := to_string(text)
    value = regex_replace(value, "(?i)(api[_-]?key|authorization|token|password)([\\s:=\\\"']+)[^\\s,}\\\"']+", "$1$2[REDACTED]")
    value = regex_replace(value, "sk-[A-Za-z0-9_-]{8}[A-Za-z0-9_-]+", "sk-[REDACTED]")
    value = regex_replace(value, "-----BEGIN [A-Z ]*PRIVATE KEY-----", "[REDACTED PRIVATE KEY]")
    value = regex_replace(value, "AKIA[0-9A-Z]{16}", "AKIA[REDACTED]")
    value = regex_replace(value, "github_pat_[A-Za-z0-9_]{20,}", "github_pat_[REDACTED]")
    value = regex_replace(value, "gh[pousr]_[A-Za-z0-9]{20,}", "gh_[REDACTED]")
    value = regex_replace(value, "xox[baprs]-[A-Za-z0-9-]{10,}", "xox-[REDACTED]")
    return value
}

export func contains_secret(text) {
    value := to_string(text)
    patterns := [
        "(?i)(api[_-]?key|access[_-]?token|auth[_-]?token|password|client[_-]?secret)\\s*[:=]\\s*[\\\"']?[^\\s,}\\\"']{6,}",
        "(?i)authorization\\s*:\\s*(bearer|basic)\\s+[^\\s]+",
        "-----BEGIN [A-Z ]*PRIVATE KEY-----",
        "AKIA[0-9A-Z]{16}",
        "github_pat_[A-Za-z0-9_]{20,}",
        "gh[pousr]_[A-Za-z0-9]{20,}",
        "xox[baprs]-[A-Za-z0-9-]{10,}",
        "sk-[A-Za-z0-9_-]{20,}"
    ]
    for pattern in patterns {
        if len(regex_find_all(value, pattern)) > 0 { return true }
    }
    return false
}

export func safe_process_env(extra) {
    mut values := {}
    for name in ["PATH", "HOME", "TMPDIR", "LANG", "LC_ALL", "TZ"] {
        value := env_or(name, "")
        if value != "" { values[name] := value }
    }
    if type(extra) == "dict" {
        for key in keys(extra) { values[key] := extra[key] }
    }
    return values
}

export func utf8_byte_length(text) {
    return len(decode_base64(encode_base64(to_string(text))))
}

export func read_file_digest(path, max_bytes) {
    if file_exists(path) == false { return {"ok": false, "error": "File does not exist: " + path} }
    if path_is_symlink(path) { return {"ok": false, "error": "Symbolic links are not allowed in sealed artifacts: " + path} }
    size := file_size(path)
    if size < 0 { return {"ok": false, "error": "Unable to determine file size: " + path} }
    if size > max_bytes { return {"ok": false, "error": "Artifact exceeds the " + to_string(max_bytes) + " byte safety limit: " + path} }
    bytes := io_read_bytes(path, size)
    return {"ok": true, "bytes": size, "sha256": sha256(bytes)}
}

export func relative_files(root, relative) {
    base := root
    if relative != "" { base = join_path(root, relative) }
    if path_is_dir(base) == false { return [] }
    names := sort(list_dir(base))
    mut out := []
    for name in names {
        child_relative := name
        if relative != "" { child_relative = relative + "/" + name }
        child := join_path(root, child_relative)
        if path_is_symlink(child) {
            out = push(out, child_relative)
        } else if path_is_dir(child) {
            out = append_all(out, relative_files(root, child_relative))
        } else {
            out = push(out, child_relative)
        }
    }
    return out
}

export func remove_tree(path) {
    if (file_exists(path) || path_is_dir(path)) && path_is_symlink(path) {
        delete_file(path)
        return
    }
    if path_is_dir(path) == false { return }
    for name in list_dir(path) {
        child := join_path(path, name)
        if path_is_symlink(child) {
            delete_file(child)
        } else if path_is_dir(child) {
            remove_tree(child)
        } else if file_exists(child) {
            delete_file(child)
        }
    }
    os_rmdir(path)
}

export func last_json_line(output) {
    lines := split(trim(to_string(output)), "\n")
    mut i := len(lines) - 1
    while i >= 0 {
        candidate := lines[i]
        if starts_with(candidate, "{") {
            mut json_lines := []
            mut j := i
            while j < len(lines) {
                json_lines = push(json_lines, lines[j])
                j = j + 1
            }
            return join(json_lines, "\n")
        }
        i = i - 1
    }
    return ""
}

export func result(ok, data, error) {
    return {"ok": ok, "data": data, "error": error}
}
