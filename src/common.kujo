# Tribunal :: common Kujo-native helpers

export func truthy(value) {
    return value == true || value == 1
}

export func dict_get(value, key, fallback) {
    if type(value) == "dict" && truthy(has_key(value, key)) {
        return value[key]
    }
    return fallback
}

export func slug(text) {
    lowered := to_lower(to_string(text))
    allowed := "abcdefghijklmnopqrstuvwxyz0123456789"
    mut out := ""
    mut dashed := true
    mut i := 0
    while i < len(lowered) {
        ch := substring(lowered, i, i + 1)
        if truthy(contains(allowed, ch)) {
            out = out + ch
            dashed = false
        } else if dashed == false {
            out = out + "-"
            dashed = true
        }
        i = i + 1
    }
    while len(out) > 0 && substring(out, len(out) - 1, len(out)) == "-" {
        out = substring(out, 0, len(out) - 1)
    }
    if out == "" { return "tribunal" }
    return out
}

export func parent_dir(path) {
    mut i := len(path) - 1
    while i >= 0 {
        if substring(path, i, i + 1) == "/" {
            if i == 0 { return "/" }
            return substring(path, 0, i)
        }
        i = i - 1
    }
    return "."
}

export func ensure_dir(path) {
    if path == "" || path == "." { return path }
    parts := split(path, "/")
    mut current := ""
    if starts_with(path, "/") { current = "/" }
    mut i := 0
    while i < len(parts) {
        part := parts[i]
        if part != "" && part != "." {
            if current == "/" {
                current = "/" + part
            } else if current == "" {
                current = part
            } else {
                current = current + "/" + part
            }
            if path_is_dir(current) == false { create_dir(current) }
        }
        i = i + 1
    }
    return path
}

export func write_text(path, content) {
    ensure_dir(parent_dir(path))
    write_file_atomic(path, content, true)
    return path
}

export func write_json(path, value) {
    return write_text(path, to_json_pretty(value) + "\n")
}

export func read_json(path) {
    return parse_json(read_file(path))
}

export func safe_existing_file(path, max_bytes, label) {
    if type(path) != "string" || trim(path) == "" || file_exists(path) == false {
        return {"ok": false, "error": label + " is missing."}
    }
    if path_is_symlink(path) || path_is_dir(path) {
        return {"ok": false, "error": label + " is unsafe."}
    }
    if file_size(path) > max_bytes {
        return {"ok": false, "error": label + " exceeds the safety limit."}
    }
    return {"ok": true, "path": path}
}

export func safe_run_id(id) {
    if type(id) != "string" || id == "" || len(id) > 128 || starts_with(id, ".") { return false }
    allowed := "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789._-"
    mut i := 0
    while i < len(id) {
        if truthy(contains(allowed, substring(id, i, i + 1))) == false { return false }
        i = i + 1
    }
    return true
}

export func safe_relative_path(path) {
    if type(path) != "string" || path == "" || len(path) > 1024 || starts_with(path, "/") || truthy(contains(path, "\\")) { return false }
    allowed := "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789._-"
    for part in split(path, "/") {
        if part == "" || part == "." || part == ".." || len(part) > 128 { return false }
        mut i := 0
        while i < len(part) {
            if truthy(contains(allowed, substring(part, i, i + 1))) == false { return false }
            i = i + 1
        }
    }
    return true
}

func normalized_absolute(path) {
    raw := path
    if starts_with(raw, "/") == false { raw = os_getcwd() + "/" + raw }
    mut parts := []
    for part in split(raw, "/") {
        if part == "" || part == "." { continue }
        if part == ".." {
            if len(parts) > 0 {
                mut shorter := []
                mut i := 0
                while i < len(parts) - 1 { shorter = push(shorter, parts[i]); i = i + 1 }
                parts = shorter
            }
        } else {
            parts = push(parts, part)
        }
    }
    return "/" + join(parts, "/")
}

export func path_within(root, candidate) {
    if type(root) != "string" || trim(root) == "" || type(candidate) != "string" || trim(candidate) == "" { return false }
    resolved_root := normalized_absolute(root)
    resolved_candidate := normalized_absolute(candidate)
    return resolved_root == "/" || resolved_candidate == resolved_root || starts_with(resolved_candidate, resolved_root + "/")
}

export func external_path_outside(root, candidate) {
    if type(root) != "string" || trim(root) == "" || type(candidate) != "string" || trim(candidate) == "" || path_within(root, candidate) { return false }
    if file_exists(root) == false && path_is_dir(root) == false { return true }
    mut existing := candidate
    while file_exists(existing) == false && path_is_dir(existing) == false {
        parent := parent_dir(existing)
        if parent == existing { return false }
        existing = parent
    }
    canonical_root := path_absolute(root)
    canonical_existing := path_absolute(existing)
    return path_within(canonical_root, canonical_existing) == false
}

export func safe_http_url(value) {
    if type(value) != "string" || trim(value) != value || contains(value, " ") || contains(value, "\n") || contains(value, "\r") || contains(value, "\t") || contains(value, "\\") || contains(value, "\"") || contains(value, "'") || contains(value, "@") || contains(value, "?") || contains(value, "#") { return false }
    if starts_with(value, "https://") && len(value) > 8 && substring(value, 8, 9) != "/" { return true }
    return value == "http://localhost" || starts_with(value, "http://localhost:") || starts_with(value, "http://localhost/") ||
        value == "http://127.0.0.1" || starts_with(value, "http://127.0.0.1:") || starts_with(value, "http://127.0.0.1/") ||
        value == "http://[::1]" || starts_with(value, "http://[::1]:") || starts_with(value, "http://[::1]/")
}

func symlink_ancestor(root, path) {
    lexical_root := normalized_absolute(root); absolute := normalized_absolute(path)
    if absolute != lexical_root && starts_with(absolute, lexical_root + "/") == false { return "" }
    relative := ""
    if len(absolute) > len(lexical_root) { relative = substring(absolute, len(lexical_root) + 1, len(absolute)) }
    mut current := lexical_root
    for part in split(relative, "/") {
        if part == "" { continue }
        current = join_path(current, part)
        if file_exists(current) || path_is_dir(current) { if path_is_symlink(current) { return current } }
    }
    return ""
}

export func inspect_path_boundary(root, candidate, require_same_mount) {
    if type(root) != "string" || type(candidate) != "string" || file_exists(root) == false || file_exists(candidate) == false { return {"ok": false, "error": "Boundary paths must exist before canonical inspection."} }
    if path_is_symlink(root) { return {"ok": false, "error": "Boundary root must not be a symbolic link.", "symlink": root} }
    ancestor := symlink_ancestor(root, candidate)
    if ancestor != "" { return {"ok": false, "error": "Path has a symbolic-link ancestor.", "symlink": ancestor} }
    canonical_root := path_absolute(root); canonical_candidate := path_absolute(candidate)
    if canonical_candidate != canonical_root && starts_with(canonical_candidate, canonical_root + "/") == false { return {"ok": false, "error": "Canonical path escapes its allowed root."} }
    mount_policy := "not-requested"
    if require_same_mount {
        root_metadata := io_file_metadata(canonical_root)
        candidate_metadata := io_file_metadata(canonical_candidate)
        root_device := dict_get(root_metadata, "device_id", "")
        candidate_device := dict_get(candidate_metadata, "device_id", "")
        if root_device == "" || candidate_device == "" { return {"ok": false, "error": "Filesystem device identity is unavailable; same-mount enforcement is fail-closed.", "runtimeGate": "filesystem-device-id"} }
        if root_device != candidate_device { return {"ok": false, "error": "Canonical path crosses a filesystem device boundary.", "rootDeviceId": root_device, "candidateDeviceId": candidate_device} }
        mount_policy = "same-device:" + root_device
    }
    return {"ok": true, "canonicalRoot": canonical_root, "canonicalPath": canonical_candidate, "symlinkAncestors": false, "casePolicy": "canonical-exact", "unicodePolicy": "artifact-components-ascii-only", "mountPolicy": mount_policy}
}

export func safe_join_existing(root, relative) {
    if safe_relative_path(relative) == false { return {"ok": false, "error": "Relative path uses unsupported case, Unicode, or traversal syntax."} }
    candidate := join_path(root, relative)
    checked := inspect_path_boundary(root, candidate, false)
    if checked["ok"] != true { return checked }
    checked["path"] := checked["canonicalPath"]
    return checked
}

export func lower_hex(value, expected_length) {
    if type(value) != "string" || len(value) != expected_length { return false }
    mut i := 0
    while i < len(value) {
        if truthy(contains("0123456789abcdef", substring(value, i, i + 1))) == false { return false }
        i = i + 1
    }
    return true
}

export func parse_args(tokens, bool_flags) {
    mut positionals := []
    mut flags := {}
    mut errors := []
    mut i := 0
    while i < len(tokens) {
        token := tokens[i]
        if starts_with(token, "--") {
            key := substring(token, 2, len(token))
            if key == "" {
                errors = push(errors, "Invalid empty option '--'.")
                i = i + 1
                continue
            }
            if truthy(has_key(flags, key)) {
                errors = push(errors, "Option '--" + key + "' was supplied more than once.")
            }
            if array_includes(bool_flags, key) {
                flags[key] := true
            } else if i + 1 < len(tokens) && starts_with(tokens[i + 1], "--") == false {
                flags[key] := tokens[i + 1]
                i = i + 1
            } else {
                flags[key] := ""
                errors = push(errors, "Option '--" + key + "' requires a value.")
            }
        } else {
            positionals = push(positionals, token)
        }
        i = i + 1
    }
    return {"positionals": positionals, "flags": flags, "errors": errors}
}

export func flag(parsed, name, fallback) {
    flags := dict_get(parsed, "flags", {})
    if truthy(has_key(flags, name)) { return flags[name] }
    return fallback
}

export func has_flag(parsed, name) {
    return truthy(has_key(dict_get(parsed, "flags", {}), name))
}

export func positional(parsed, index, fallback) {
    values := dict_get(parsed, "positionals", [])
    if index >= 0 && index < len(values) { return values[index] }
    return fallback
}

export func slice_from(values, start) {
    mut out := []
    mut i := start
    while i < len(values) {
        out = push(out, values[i])
        i = i + 1
    }
    return out
}

export func append_all(target, values) {
    mut out := target
    for value in values { out = push(out, value) }
    return out
}

export func array_includes(values, candidate) {
    for value in values {
        if value == candidate { return true }
    }
    return false
}

export func index_by_id(values) {
    mut out := {}
    for value in values { out[value["id"]] := value }
    return out
}

export func redact(text) {
    value := to_string(text)
    # Remove the credential before the general assignment redactor can consume
    # only the authentication scheme and leave its value visible.
    value = regex_replace(value, "(?i)(authorization[\\s:=\\\"']+)(bearer|basic)\\s+[^\\s,}\\\"']+", "$1[REDACTED]")
    value = regex_replace(value, "(?i)(api[_-]?key|authorization|token|password)([\\s:=\\\"']+)[^\\s,}\\\"']+", "$1$2[REDACTED]")
    value = regex_replace(value, "sk-[A-Za-z0-9_-]{8}[A-Za-z0-9_-]+", "sk-[REDACTED]")
    value = regex_replace(value, "-----BEGIN [A-Z ]*PRIVATE KEY-----", "[REDACTED PRIVATE KEY]")
    value = regex_replace(value, "AKIA[0-9A-Z]{16}", "AKIA[REDACTED]")
    value = regex_replace(value, "github_pat_[A-Za-z0-9_]{20,}", "github_pat_[REDACTED]")
    value = regex_replace(value, "gh[pousr]_[A-Za-z0-9]{20,}", "gh_[REDACTED]")
    value = regex_replace(value, "xox[baprs]-[A-Za-z0-9-]{10,}", "xox-[REDACTED]")
    return value
}

export func contains_secret(text) {
    value := to_string(text)
    patterns := [
        "(?i)(api[_-]?key|access[_-]?token|auth[_-]?token|password|client[_-]?secret)\\s*[:=]\\s*[\\\"']?[^\\s,}\\\"']{6,}",
        "(?i)authorization\\s*:\\s*(bearer|basic)\\s+[^\\s]+",
        "-----BEGIN [A-Z ]*PRIVATE KEY-----",
        "AKIA[0-9A-Z]{16}",
        "github_pat_[A-Za-z0-9_]{20,}",
        "gh[pousr]_[A-Za-z0-9]{20,}",
        "xox[baprs]-[A-Za-z0-9-]{10,}",
        "sk-[A-Za-z0-9_-]{20,}"
    ]
    for pattern in patterns {
        if len(regex_find_all(value, pattern)) > 0 { return true }
    }
    return false
}

func entropy_candidate(value) {
    if len(value) < 24 || len(value) > 512 { return false }
    # Hyphenated identifiers and prose slugs are high-diversity but routinely
    # public; known hyphenated token families remain covered by fixed patterns.
    if contains(value, "-") { return false }
    mut seen := ""; mut upper := false; mut lower := false; mut digit := false; mut symbol := false
    mut i := 0
    while i < len(value) {
        ch := substring(value, i, i + 1)
        if contains(seen, ch) == 0 { seen = seen + ch }
        if contains("ABCDEFGHIJKLMNOPQRSTUVWXYZ", ch) { upper = true }
        if contains("abcdefghijklmnopqrstuvwxyz", ch) { lower = true }
        if contains("0123456789", ch) { digit = true }
        if contains("+/_=", ch) { symbol = true }
        i = i + 1
    }
    classes := 0
    for present in [upper, lower, digit, symbol] { if present { classes = classes + 1 } }
    return classes >= 3 && len(seen) * 100 / len(value) >= 35
}

export func secret_scan(text, organization_patterns_path) {
    value := to_string(text)
    mut detections := []
    if contains_secret(value) { detections = push(detections, {"kind": "built-in-pattern"}) }
    for candidate in regex_find_all(value, "([A-Za-z0-9]{8,}[+/_][A-Za-z0-9+/_=]{8,512}|[A-Za-z0-9]{24,510}={1,2})") {
        if entropy_candidate(candidate) { detections = push(detections, {"kind": "high-entropy-token", "length": len(candidate), "sha256Prefix": substring(sha256(candidate), 0, 12)}) }
    }
    if trim(organization_patterns_path) != "" {
        if file_exists(organization_patterns_path) == false || path_is_symlink(organization_patterns_path) || file_size(organization_patterns_path) > 1048576 { return {"ok": false, "error": "Organization secret-pattern file is missing or unsafe.", "detections": []} }
        patterns := null
        try { patterns = parse_json(read_file(organization_patterns_path)) } except err { return {"ok": false, "error": "Organization secret-pattern file is invalid JSON.", "detections": []} }
        if type(patterns) != "dict" || type(dict_get(patterns, "patterns", null)) != "array" || len(patterns["patterns"]) > 64 { return {"ok": false, "error": "Organization secret-pattern contract is invalid.", "detections": []} }
        for entry in patterns["patterns"] {
            if type(entry) != "dict" || type(dict_get(entry, "id", null)) != "string" || type(dict_get(entry, "regex", null)) != "string" || len(entry["regex"]) > 512 { return {"ok": false, "error": "Organization secret pattern is invalid.", "detections": []} }
            matches := regex_find_all(value, entry["regex"])
            if len(matches) > 0 { detections = push(detections, {"kind": "organization-pattern", "id": entry["id"], "count": len(matches)}) }
        }
    }
    return {"ok": true, "detected": len(detections) > 0, "detections": detections, "matchedValuesReturned": false}
}

export func safe_process_env(extra) {
    mut values := {}
    for name in ["PATH", "HOME", "TMPDIR", "LANG", "LC_ALL", "TZ"] {
        value := env_or(name, "")
        if value != "" { values[name] := value }
    }
    if type(extra) == "dict" {
        for key in keys(extra) { values[key] := extra[key] }
    }
    return values
}

export func utf8_byte_length(text) {
    return len(decode_base64(encode_base64(to_string(text))))
}

export func read_file_digest(path, max_bytes) {
    if file_exists(path) == false { return {"ok": false, "error": "File does not exist: " + path} }
    if path_is_symlink(path) { return {"ok": false, "error": "Symbolic links are not allowed in sealed artifacts: " + path} }
    size := file_size(path)
    if size < 0 { return {"ok": false, "error": "Unable to determine file size: " + path} }
    if size > max_bytes { return {"ok": false, "error": "Artifact exceeds the " + to_string(max_bytes) + " byte safety limit: " + path} }
    digest := null
    try { digest = sha256_file(path) } except err { digest = null }
    if lower_hex(digest, 64) == false || file_size(path) != size {
        return {"ok": false, "error": "Artifact could not be hashed completely or changed size: " + path}
    }
    return {"ok": true, "bytes": size, "sha256": digest}
}

export func relative_files(root, relative) {
    base := root
    if relative != "" { base = join_path(root, relative) }
    if path_is_dir(base) == false { return [] }
    names := sort(list_dir(base))
    mut out := []
    for name in names {
        child_relative := name
        if relative != "" { child_relative = relative + "/" + name }
        child := join_path(root, child_relative)
        if path_is_symlink(child) {
            out = push(out, child_relative)
        } else if path_is_dir(child) {
            out = append_all(out, relative_files(root, child_relative))
        } else {
            out = push(out, child_relative)
        }
    }
    return out
}

# The pinned runtime rejects delete_file on directory symlinks on Linux.
# Unlink only this argv path; never recurse through the symlink target.
func unlink_tree_symlink(path) {
    destination := path
    if starts_with(destination, "/") == false { destination = join_path(os_getcwd(), destination) }
    removed := spawn_process(["/bin/rm", "--", destination], {"inherit_env": false, "timeout_ms": 10000, "max_output_bytes": 4096})
    if removed.success != true { throw("Unable to unlink cleanup symlink.") }
}

export func remove_tree(path) {
    mut linked := false
    try { linked = path_is_symlink(path) } except err { if file_exists(path) { throw(err) } }
    if linked {
        unlink_tree_symlink(path)
        return
    }
    if path_is_dir(path) == false { return }
    for name in list_dir(path) {
        child := join_path(path, name)
        if path_is_symlink(child) {
            unlink_tree_symlink(child)
        } else if path_is_dir(child) {
            remove_tree(child)
        } else if file_exists(child) {
            delete_file(child)
        }
    }
    os_rmdir(path)
}

export func last_json_line(output) {
    lines := split(trim(to_string(output)), "\n")
    mut i := len(lines) - 1
    while i >= 0 {
        candidate := lines[i]
        if starts_with(candidate, "{") {
            mut json_lines := []
            mut j := i
            while j < len(lines) {
                json_lines = push(json_lines, lines[j])
                j = j + 1
            }
            return join(json_lines, "\n")
        }
        i = i - 1
    }
    return ""
}

export func result(ok, data, error) {
    return {"ok": ok, "data": data, "error": error}
}

# Kujo create_dir is recursive/idempotent, so it cannot claim ownership. The
# supported POSIX hosts supply mkdir without -p, which atomically rejects an
# existing destination. Use a fixed executable and pass the path as one argv.
export func claim_directory(path) {
    if file_exists("/bin/mkdir") == false { throw("Exclusive directory claims require /bin/mkdir on a supported POSIX host.") }
    destination := path
    if starts_with(destination, "/") == false { destination = join_path(os_getcwd(), destination) }
    claimed := spawn_process(["/bin/mkdir", destination], {"inherit_env": false, "timeout_ms": 10000, "max_output_bytes": 4096})
    return claimed.success == true
}
