# Tribunal Kujo-native offline and real-local-integration test suite.

from src.common import array_includes, inspect_path_boundary, remove_tree, ensure_dir, dict_get, safe_relative_path, parse_args, contains_secret, safe_process_env, secret_scan, utf8_byte_length
from src.config import default_config, validate_config, load_config
from src.catalog import STAGES, PANELS, SEATS
from src.tribunal import review, resume, validate_docket
from src.storage import load_record, load_events, artifact_path, create_run, list_runs_filtered
from src.integrity import generate_keys, verify
from src.integrations import ingest_runledger, ingest_casefile
from src.model import invoke
from src.analytics import collect_stats
from src.provenance import sign_provenance
from src.compare import compare_rulings, re_review
from src.lib import API_VERSION, list_hearings, verify_hearing

mut passed := 0
mut failed := 0

func check(condition, name) {
    if condition == true {
        passed = passed + 1
    } else {
        failed = failed + 1
        print("  FAIL: " + name)
    }
}

async func bounded_runtime_worker(job) {
    marker := join_path(job["activeRoot"], to_string(job["id"]) + ".active")
    write_file(marker, "active")
    deadline := current_timestamp() + 1000
    while len(list_dir(job["activeRoot"])) < job["expectedConcurrency"] && current_timestamp() < deadline { await async_sleep(10) }
    active := len(list_dir(job["activeRoot"]))
    await async_sleep(job["delayMs"])
    delete_file(marker)
    return {"id": job["id"], "active": active}
}

async func cancellable_runtime_worker(job) {
    if job["fail"] {
        await async_sleep(100)
        write_file_atomic(job["cancelFile"], "cancel")
        return error("intentional-provider-failure")
    }
    spawn_process([KUJO_BIN, "run", job["worker"], "--interpreter"], {"inherit_env": false, "env": {"TRIBUNAL_CANCELLATION_RECEIPT": job["receipt"]}, "cancel_file": job["cancelFile"], "timeout_ms": 10000, "max_output_bytes": 1048576})
    return {"ok": true}
}

async func sdk_parallel_worker(job) { return invoke(job["config"], job["request"]) }

func contains_text(path, text) {
    if file_exists(path) == false { return false }
    return contains(read_file(path), text) == 1
}

ROOT := join_path(env_or("TMPDIR", "/tmp"), "tribunal-kujo-tests-" + to_string(current_timestamp()))
DOCKET := join_path(ROOT, "docket.md")
KUJO_BIN := env_or("KUJO_BIN", join_path(env_or("TRIBUNAL_HOME", "."), "../kujo/target/release/kujo"))
HOME := path_absolute(env_or("TRIBUNAL_HOME", "."))

func base_config(storage) {
    config := default_config()
    tribunal := config["tribunal"]
    tribunal["storage_dir"] := storage
    config["tribunal"] := tribunal
    ai := config["kujo_ai"]
    ai["kujo_bin"] := KUJO_BIN
    config["kujo_ai"] := ai
    context := config["context"]
    context["kujo_bin"] := KUJO_BIN
    config["context"] := context
    return config
}

func setup() {
    ensure_dir(ROOT)
    write_file(DOCKET, "# Kujo Tribunal test\n\n## Scope\n\nProve the complete Kujo-native decision workflow.\n\n## Non-goals\n\n- Network access\n- Provider credentials\n")
}

func test_catalog_and_config() {
    check(len(STAGES) == 9, "nine explicit Tribunal stages")
    check(has_key(PANELS, "executioner-only") == 1, "executioner-only panel exists")
    check(has_key(PANELS, "fast-two-model") == 1, "fast-two-model panel exists")
    check(has_key(PANELS, "strategic-five") == 1, "strategic-five panel exists")
    for id in ["judge", "executioner", "builder", "operator", "market-lens"] {
        check(has_key(SEATS, id) == 1, "seat exists: " + id)
        check(type(SEATS[id]["defaultModelPreference"]) == "dict", "provider-neutral preference: " + id)
    }
    check(validate_config(default_config()) == "", "default config is valid")
    invalid := default_config()
    invalid["unexpected"] := true
    check(validate_config(invalid) != "", "unknown top-level config is rejected")
    invalid = default_config()
    invalid_tribunal := invalid["tribunal"]
    invalid_tribunal["stop_the_line_enabled"] := false
    invalid["tribunal"] := invalid_tribunal
    check(validate_config(invalid) != "", "stop-the-line invariant cannot be disabled")
    invalid = default_config()
    invalid_limits := invalid["limits"]
    invalid_limits["max_docket_bytes"] := 12
    invalid["limits"] := invalid_limits
    check(validate_config(invalid) != "", "unsafe docket limit is rejected")
    invalid = default_config()
    invalid_execution := invalid["execution"]
    invalid_execution["provider_max_concurrency"] := invalid_execution["blind_parallelism"] + 1
    invalid["execution"] := invalid_execution
    check(validate_config(invalid) != "", "provider concurrency cannot exceed the blind worker bound")
    check(safe_relative_path("testimony/judge.md"), "safe artifact path is accepted")
    check(safe_relative_path("../private.pem") == false && safe_relative_path("a/../b") == false, "artifact traversal is rejected")
    parsed := parse_args(["--json", "--json", "--limit"], ["json"])
    check(len(parsed["errors"]) == 2, "duplicate and missing CLI options are reported")
    check(contains_secret("Authorization: Bearer example-secret-token"), "bearer credentials are detected")
    check(contains_secret("github_pat_abcdefghijklmnopqrstuvwxyz") , "GitHub credentials are detected")
    entropy := secret_scan("credential=AbCDefgh+/ijkLMN0123456789AB", "")
    false_positive := secret_scan("sha256=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef", "")
    organization := secret_scan("value=TRIBUNAL_INTERNAL_ABCDEF0123456789ABCDEF01", join_path(HOME, "examples/secret-patterns.json"))
    check(entropy["detected"] == true && entropy["detections"][0]["kind"] != "plaintext-value", "entropy-aware secret detection records only non-secret evidence")
    check(false_positive["detected"] == false, "entropy detector avoids hexadecimal digest false positives")
    check(organization["detected"] == true && organization["matchedValuesReturned"] == false, "organization secret patterns detect without returning values")
    env_values := safe_process_env({"TRIBUNAL_TEST": "yes"})
    check(env_values["TRIBUNAL_TEST"] == "yes" && has_key(env_values, "OPENAI_API_KEY") == 0, "subprocess environment is allowlisted")
    check(utf8_byte_length("é") == 2, "resource accounting uses UTF-8 bytes")
    invalid_path := join_path(ROOT, "invalid-config.json")
    write_file(invalid_path, "{\"limits\":\"unbounded\"}")
    check(load_config(invalid_path)["ok"] == false, "non-object config sections are rejected")
    exclusive_storage := join_path(ROOT, "exclusive-runs")
    check(create_run(exclusive_storage, "exclusive-run") != "" && create_run(exclusive_storage, "exclusive-run") == "", "run creation is atomic and refuses an existing run directory")
    boundary_file := join_path(ROOT, "boundary.txt"); write_file(boundary_file, "bounded")
    check(inspect_path_boundary(ROOT, boundary_file, false)["ok"] == true, "canonical filesystem boundary accepts an in-root regular file")
    symlink_root := join_path(ROOT, "boundary-link")
    spawn_process(["ln", "-s", ROOT, symlink_root], {"inherit_env": false, "timeout_ms": 10000, "max_output_bytes": 1048576})
    check(inspect_path_boundary(symlink_root, boundary_file, false)["ok"] == false, "canonical filesystem boundary rejects a symbolic-link root")
    spawn_process(["unlink", symlink_root], {"inherit_env": false, "timeout_ms": 10000, "max_output_bytes": 1048576})
    same_mount := inspect_path_boundary(ROOT, boundary_file, true)
    check(same_mount["ok"] == true && starts_with(same_mount["mountPolicy"], "same-device:"), "mount-boundary enforcement verifies runtime device IDs")
    check(safe_relative_path("unicode-é.md") == false && safe_relative_path("Case/File.md") == true, "Unicode normalization is rejected and case is preserved explicitly")
}

func test_full_mock_review() {
    storage := join_path(ROOT, "mock-runs")
    result := review(base_config(storage), DOCKET, "strategic-five", "", "")
    check(result["ok"] == true, "strategic-five mock review succeeds")
    if result["ok"] != true { return }
    run_id := result["runId"]
    record := load_record(storage, run_id)
    check(record["status"] == "completed", "record is completed")
    check(len(record["stagesCompleted"]) == 9, "all stages completed")
    check(len(record["testimonies"]) == 5, "all five blind testimonies captured")
    for testimony in record["testimonies"] { check(testimony["blind"] == true, "testimony remains explicitly blind") }
    check(len(record["crossExaminations"]) == 5, "all five cross-examinations captured")
    for name in ["docket.md", "manifest.json", "context.md", "cross-examination.md", "kill-pass.md", "ruling.md", "decision-packet.md", "record.json", "events.jsonl", "receipt.json", "artifact-manifest.json"] {
        check(file_exists(artifact_path(storage, run_id, name)), "artifact exists: " + name)
    }
    for testimony in record["testimonies"] {
        prompt := artifact_path(storage, run_id, "prompts/blind-first-pass-" + testimony["seatId"] + ".md")
        check(contains_text(prompt, "No other seat testimony is available"), "blind prompt excludes peers: " + testimony["seatId"])
        check(contains_text(prompt, "Complete blind testimony record") == false, "blind prompt has no peer transcript: " + testimony["seatId"])
    }
    check(contains_text(artifact_path(storage, run_id, "ruling.md"), "## Final verdict"), "ruling contract is human-readable")
    check(contains_text(artifact_path(storage, run_id, "decision-packet.md"), "## Evidence required before marking complete"), "decision packet is agent-readable")
    events := load_events(storage, run_id)
    check(len(events) > 20, "event stream captures stage and model evidence")
    mut blind_completed := []
    mut parallel_evidence := null
    for event in events {
        if event["stageId"] == "blind-first-pass" && event["eventType"] == "model_invocation_completed" { blind_completed = push(blind_completed, event["seatId"]) }
        if event["eventType"] == "parallel_execution_evaluated" { parallel_evidence = event["metadata"] }
    }
    check(to_json(blind_completed) == to_json(record["panel"]["seatIds"]), "blind results persist in deterministic panel order")
    check(type(parallel_evidence) == "dict" && parallel_evidence["effectiveConcurrency"] == 2 && parallel_evidence["runtimeGate"] == "" && parallel_evidence["providerRateLimitBound"] == true && parallel_evidence["cancelOnFailure"] == true, "parallel evaluation is isolated, provider-bounded, and runtime-enabled")
    checked := verify(storage, run_id, "")
    check(checked["ok"] == true && checked["artifactsChecked"] > 20, "artifact manifest covers complete run")
}

func test_signed_custom_panel() {
    private_key := join_path(ROOT, "panel-private.pem")
    public_key := join_path(ROOT, "panel-public.pem")
    check(generate_keys(private_key, public_key, 2048)["ok"] == true, "custom panel provenance keys generated")
    catalog := join_path(HOME, "examples/panel-catalog.json")
    provenance := join_path(ROOT, "panel-catalog.provenance.json")
    anchor := join_path(ROOT, "panel-catalog.anchor.json")
    signed := sign_provenance(catalog, "panel-catalog", 1, "", private_key, public_key, provenance, anchor)
    check(signed["ok"] == true, "custom panel catalog provenance is signed and anchored")
    config := base_config(join_path(ROOT, "custom-panel-runs"))
    panel_settings := config["panels"]
    panel_settings["catalog_path"] := catalog
    panel_settings["provenance_path"] := provenance
    panel_settings["public_key_path"] := public_key
    panel_settings["anchor_path"] := anchor
    config["panels"] := panel_settings
    result := review(config, DOCKET, "reliability-one", "", "")
    check(result["ok"] == true, "signed custom panel review succeeds")
    if result["ok"] == true {
        record := load_record(config["tribunal"]["storage_dir"], result["runId"])
        check(record["panel"]["id"] == "reliability-one" && record["testimonies"][0]["seatId"] == "reliability-reviewer", "custom panel and seat persist deterministically")
        prompt := artifact_path(config["tribunal"]["storage_dir"], result["runId"], "prompts/blind-first-pass-reliability-reviewer.md")
        check(contains_text(prompt, "No other seat testimony is available") && contains_text(prompt, "Complete blind testimony record") == false, "custom prompt template preserves blind permission boundary")
    }
}

func test_resumable_hearing() {
    storage := join_path(ROOT, "resume-runs")
    failing := base_config(storage)
    context := failing["context"]
    context["provider"] := "packwrite"
    context["packwrite_path"] := join_path(ROOT, "missing-packwrite")
    failing["context"] := context
    stopped := review(failing, DOCKET, "executioner-only", "", "")
    check(stopped["ok"] == false && stopped["record"]["status"] == "stopped", "interrupted hearing seals a stopped record")
    resumed := resume(base_config(storage), stopped["runId"], "", "")
    check(resumed["ok"] == true, "stopped hearing resumes into a new immutable run")
    if resumed["ok"] == true {
        record := resumed["record"]
        check(record["lineage"]["priorRunId"] == stopped["runId"] && len(record["lineage"]["priorRecordSha256"]) == 64, "resumed hearing binds immutable lineage")
        checkpoint := parse_json(read_file(artifact_path(storage, resumed["runId"], "checkpoint.json")))
        check(checkpoint["sequence"] == 9 && checkpoint["idempotencyContract"] == "sha256(stage+seat+input+schema)", "resumed hearing reaches explicit final checkpoint")
    }
}

func test_compare_and_re_review() {
    storage := join_path(ROOT, "compare-runs")
    base := review(base_config(storage), DOCKET, "executioner-only", "", "")
    check(base["ok"] == true, "comparison base ruling succeeds")
    if base["ok"] != true { return }
    base_record := artifact_path(storage, base["runId"], "record.json")
    base_digest := sha256(read_file(base_record))
    rereview := re_review(base_config(storage), base["runId"], DOCKET, "fast-two-model", "", "", join_path(ROOT, "rereview-comparison"))
    check(rereview["ok"] == true, "re-review creates a new sealed ruling and comparison")
    if rereview["ok"] == true {
        comparison := rereview["comparison"]["comparison"]
        check(comparison["baseRunId"] == base["runId"] && comparison["candidateRunId"] == rereview["runId"] && comparison["sourcesUnchanged"] == true, "comparison binds both immutable source records")
        check(json_schema_validate(comparison, parse_json(read_file(join_path(HOME, "schemas/ruling-comparison.schema.json"))))["valid"] == true, "ruling comparison satisfies its public schema")
        check(sha256(read_file(base_record)) == base_digest, "re-review never rewrites the base sealed record")
    }
}

func test_library_api() {
    storage := join_path(ROOT, "library-runs")
    reviewed := review(base_config(storage), DOCKET, "executioner-only", "", "")
    if reviewed["ok"] != true { check(false, "library fixture review succeeds"); return }
    listed := list_hearings(storage, "completed", "executioner-only", 10, "")
    checked := verify_hearing(storage, reviewed["runId"], "")
    schema := parse_json(read_file(join_path(HOME, "schemas/library-result.schema.json")))
    check(API_VERSION == "1.0.0" && listed["apiVersion"] == API_VERSION && listed["ok"] == true, "stable Kujo library API returns versioned envelopes")
    check(json_schema_validate(listed, schema)["valid"] == true && json_schema_validate(checked, schema)["valid"] == true, "library list and verify envelopes satisfy the public schema")
}

func test_context_plugin_contract() {
    private_key := join_path(ROOT, "connector-private.pem"); public_key := join_path(ROOT, "connector-public.pem")
    check(generate_keys(private_key, public_key, 2048)["ok"] == true, "context connector provenance keys generated")
    manifest_path := join_path(ROOT, "connector.json")
    write_file(manifest_path, to_json_pretty({"schemaVersion": "1.0.0", "id": "offline-evidence", "adapterPath": join_path(HOME, "tests/fixtures/context_connector.kujo"), "allowedRoots": [ROOT], "timeoutMs": 10000, "maxOutputBytes": 65536}) + "\n")
    provenance := join_path(ROOT, "connector.provenance.json"); anchor := join_path(ROOT, "connector.anchor.json")
    check(sign_provenance(manifest_path, "connector-catalog", 1, "", private_key, public_key, provenance, anchor)["ok"] == true, "context connector manifest is signed and externally anchored")
    config := base_config(join_path(ROOT, "connector-runs"))
    context := config["context"]
    context["provider"] := "plugin"; context["plugin_manifest_path"] := manifest_path; context["plugin_provenance_path"] := provenance; context["plugin_public_key_path"] := public_key; context["plugin_anchor_path"] := anchor
    config["context"] := context
    result := review(config, DOCKET, "executioner-only", "", "")
    check(result["ok"] == true, "provider-neutral context plugin review succeeds without ambient credentials")
    if result["ok"] == true {
        content := read_file(artifact_path(config["tribunal"]["storage_dir"], result["runId"], "context.md"))
        events := load_events(config["tribunal"]["storage_dir"], result["runId"])
        mut provenance_ok := false
        for event in events { if event["eventType"] == "context_pack_created" && len(event["metadata"]["sources"]) == 1 && starts_with(event["metadata"]["sources"][0]["uri"], "docket-sha256:") { provenance_ok = true } }
        check(contains(content, "Source digest:") == 1 && provenance_ok && contains_secret(content) == false, "connector output carries source provenance and remains redacted")
    }
    failing_manifest_path := join_path(ROOT, "failing-connector.json")
    write_file(failing_manifest_path, to_json_pretty({"schemaVersion": "1.0.0", "id": "nonzero-evidence", "adapterPath": join_path(HOME, "tests/fixtures/nonzero_context_connector.kujo"), "allowedRoots": [ROOT], "timeoutMs": 10000, "maxOutputBytes": 65536}) + "\n")
    failing_provenance := join_path(ROOT, "failing-connector.provenance.json"); failing_anchor := join_path(ROOT, "failing-connector.anchor.json")
    check(sign_provenance(failing_manifest_path, "connector-catalog", 1, "", private_key, public_key, failing_provenance, failing_anchor)["ok"] == true, "failing context connector manifest is signed and externally anchored")
    failing_config := base_config(join_path(ROOT, "failing-connector-runs")); failing_context := failing_config["context"]; failing_context["provider"] := "plugin"; failing_context["plugin_manifest_path"] := failing_manifest_path; failing_context["plugin_provenance_path"] := failing_provenance; failing_context["plugin_public_key_path"] := public_key; failing_context["plugin_anchor_path"] := failing_anchor; failing_config["context"] := failing_context
    check(review(failing_config, DOCKET, "executioner-only", "", "")["ok"] == false, "context connector subprocess failure cannot be accepted as evidence")
}

func test_packet_template_and_policy() {
    private_key := join_path(ROOT, "policy-private.pem"); public_key := join_path(ROOT, "policy-public.pem")
    check(generate_keys(private_key, public_key, 2048)["ok"] == true, "organization policy provenance keys generated")
    policy_path := join_path(HOME, "examples/organization-policy.json")
    provenance := join_path(ROOT, "organization-policy.provenance.json"); anchor := join_path(ROOT, "organization-policy.anchor.json")
    check(sign_provenance(policy_path, "organization-policy", 1, "", private_key, public_key, provenance, anchor)["ok"] == true, "organization policy is signed and externally anchored")
    config := base_config(join_path(ROOT, "policy-runs"))
    settings := config["decision_packet"]
    settings["template_path"] := join_path(HOME, "examples/decision-template.json")
    settings["policy_path"] := policy_path; settings["policy_provenance_path"] := provenance; settings["policy_public_key_path"] := public_key; settings["policy_anchor_path"] := anchor
    config["decision_packet"] := settings
    result := review(config, DOCKET, "executioner-only", "", "")
    check(result["ok"] == true, "portable packet template passes explicit organization policy")
    if result["ok"] == true {
        record := result["record"]
        check(record["decisionPolicy"]["compliant"] == true && record["decisionPolicy"]["modelBehaviorModified"] == false, "organization checks are explicit and never hidden model behavior")
        check(array_includes(record["decisionPacket"]["evidenceRequired"], "Rollback drill receipt"), "portable template deterministically adds required evidence")
    }
}

func test_signing_and_tamper() {
    storage := join_path(ROOT, "signed-runs")
    private_key := join_path(ROOT, "private.pem")
    public_key := join_path(ROOT, "public.pem")
    keys := generate_keys(private_key, public_key, 2048)
    private_metadata := io_file_metadata(private_key)
    check(keys["ok"] == true && keys["permissionVerified"] == true && private_metadata["mode"] == 384, "Kujo RSA keys are atomically generated with verified 0600 permissions")
    check(generate_keys(private_key, public_key, 2048)["ok"] == false, "key generation refuses overwrite")
    result := review(base_config(storage), DOCKET, "executioner-only", private_key, public_key)
    check(result["ok"] == true, "signed executioner review succeeds")
    if result["ok"] != true { return }
    run_id := result["runId"]
    checked := verify(storage, run_id, public_key)
    check(checked["ok"] == true && checked["signature"] == "verified", "trusted signature verifies")
    signature_path := artifact_path(storage, run_id, "signature.json")
    signature := parse_json(read_file(signature_path))
    original_signed_at := signature["signedAt"]
    signature["signedAt"] := "2020-01-01T00:00:00Z"
    write_file(signature_path, to_json_pretty(signature) + "\n", true)
    envelope_tampered := verify(storage, run_id, public_key)
    check(envelope_tampered["ok"] == false && envelope_tampered["signature"] == "invalid", "signed envelope metadata tampering is detected")
    signature["signedAt"] := original_signed_at
    write_file(signature_path, to_json_pretty(signature) + "\n", true)
    wrong_pair := generate_keys(join_path(ROOT, "wrong-private.pem"), join_path(ROOT, "wrong-public.pem"), 2048)
    check(wrong_pair["ok"] == true, "wrong test key generated")
    wrong := verify(storage, run_id, join_path(ROOT, "wrong-public.pem"))
    check(wrong["ok"] == false && wrong["signature"] == "invalid", "wrong trusted key is rejected")
    ruling_path := artifact_path(storage, run_id, "ruling.md")
    original := read_file(ruling_path)
    write_file(ruling_path, "tampered\n", true)
    tampered := verify(storage, run_id, public_key)
    check(tampered["ok"] == false && len(tampered["mismatched"]) == 1, "artifact tampering is detected")
    write_file(ruling_path, original, true)

    ledger := join_path(ROOT, "ledger")
    runledger := ingest_runledger(storage, run_id, {"public_key": public_key, "kujo_bin": KUJO_BIN, "runledger_path": join_path(HOME, "../runledger/runledger.kujo"), "ledger": ledger})
    check(runledger["ok"] == true, "signed run ingests through real RunLedger Kujo CLI")
    if runledger["ok"] == true { check(file_exists(runledger["receipt"]["targetPath"]), "RunLedger record exists") }
    repeated_runledger := ingest_runledger(storage, run_id, {"public_key": public_key, "kujo_bin": KUJO_BIN, "runledger_path": join_path(HOME, "../runledger/runledger.kujo"), "ledger": ledger})
    check(repeated_runledger["ok"] == true && repeated_runledger["receipt"]["targetId"] == runledger["receipt"]["targetId"], "RunLedger ingestion is idempotent")
    case_root := join_path(ROOT, "casefiles")
    casefile := ingest_casefile(storage, run_id, {"public_key": public_key, "kujo_bin": KUJO_BIN, "casefile_path": join_path(HOME, "../casefile/casefile.kujo"), "output_dir": case_root})
    if casefile["ok"] != true { print("  CaseFile detail: " + dict_get(casefile, "error", "unknown")) }
    check(casefile["ok"] == true, "signed run ingests through real CaseFile Kujo CLI")
    if casefile["ok"] == true {
        check(file_exists(join_path(casefile["receipt"]["targetPath"], "tribunal-ingestion.json")), "CaseFile ingestion receipt exists")
        check(file_exists(join_path(join_path(casefile["receipt"]["targetPath"], "tribunal-evidence"), "signature.json")), "CaseFile preserves signed evidence")
    }
    repeated_casefile := ingest_casefile(storage, run_id, {"public_key": public_key, "kujo_bin": KUJO_BIN, "casefile_path": join_path(HOME, "../casefile/casefile.kujo"), "output_dir": case_root})
    check(repeated_casefile["ok"] == true && repeated_casefile["receipt"]["targetId"] == casefile["receipt"]["targetId"], "CaseFile ingestion is idempotent")
}

func test_stop_the_line() {
    storage := join_path(ROOT, "stopped-runs")
    result := review(base_config(storage), join_path(ROOT, "missing.md"), "fast-two-model", "", "")
    check(result["ok"] == false && has_key(result, "runId") == 1, "missing docket stops with a durable run")
    if has_key(result, "runId") == 1 {
        record := load_record(storage, result["runId"])
        check(record["status"] == "stopped", "missing docket writes stopped record")
        check(file_exists(artifact_path(storage, result["runId"], "receipt.json")), "stopped run writes receipt")
        check(verify(storage, result["runId"], "")["ok"] == true, "stopped run is integrity-verifiable")
    }
    mismatch_a := generate_keys(join_path(ROOT, "stop-private-a.pem"), join_path(ROOT, "stop-public-a.pem"), 2048)
    mismatch_b := generate_keys(join_path(ROOT, "stop-private-b.pem"), join_path(ROOT, "stop-public-b.pem"), 2048)
    seal_failure := review(base_config(join_path(ROOT, "stop-seal-failure-runs")), join_path(ROOT, "still-missing.md"), "executioner-only", mismatch_a["privateKey"], mismatch_b["publicKey"])
    check(mismatch_a["ok"] == true && mismatch_b["ok"] == true && dict_get(seal_failure, "sealingFailed", false) == true && contains(seal_failure["error"], "sealing failed") == 1, "stopped hearing reports a sealing failure instead of claiming durable sealed evidence")
    secret_docket := join_path(ROOT, "secret.md")
    write_file(secret_docket, "# Unsafe\n\n## Scope\n\napi_key=super-secret-value\n")
    secret := review(base_config(storage), secret_docket, "executioner-only", "", "")
    check(secret["ok"] == false, "secret exposure stops the line")
    if has_key(secret, "runId") == 1 {
        record := load_record(storage, secret["runId"])
        check(contains(dict_get(record, "stopReason", ""), "secret exposure") == 1, "secret stop reason is recorded without secret value")
    }
}

func test_packwrite_and_sdk_bridge() {
    storage := join_path(ROOT, "packwrite-runs")
    config := base_config(storage)
    context := config["context"]
    context["provider"] := "packwrite"
    context["packwrite_path"] := join_path(HOME, "../packwrite")
    config["context"] := context
    result := review(config, DOCKET, "executioner-only", "", "")
    check(result["ok"] == true, "real PackWrite Kujo context bridge succeeds")
    if result["ok"] == true { check(contains_text(artifact_path(storage, result["runId"], "context.md"), "Repository context"), "PackWrite repository context is appended") }

    sdk_config := base_config(join_path(ROOT, "sdk-runs"))
    ai := sdk_config["kujo_ai"]
    ai["mock_mode"] := false
    ai["offline_fixture"] := true
    ai["sdk_path"] := join_path(HOME, "../ai-sdk")
    sdk_config["kujo_ai"] := ai
    response := invoke(sdk_config, {"runId": "sdk-contract", "stageId": "blind-first-pass", "seatId": "executioner", "modelPreference": SEATS["executioner"]["defaultModelPreference"], "systemPrompt": "Return structured output.", "input": "SDK bridge contract", "outputSchema": {"type": "object"}, "timeoutMs": 60000})
    check(response["ok"] == true, "real Kujo AI SDK offline fixture succeeds")
    check(response["metadata"]["provider"] == "openai", "SDK provider metadata is preserved")
    check(response["metadata"]["resolutionSource"] == "provider_class", "SDK-owned model resolution provenance is preserved")
    execution := sdk_config["execution"]
    execution["live_parallel_enabled"] := true
    execution["blind_parallelism"] := 2
    execution["provider_max_concurrency"] := 2
    sdk_config["execution"] := execution
    request_one := {"runId": "sdk-parallel", "stageId": "blind-first-pass", "seatId": "executioner", "modelPreference": SEATS["executioner"]["defaultModelPreference"], "systemPrompt": "Return structured output.", "input": "SDK parallel one", "outputSchema": {"type": "object"}, "timeoutMs": 60000}
    request_two := {"runId": "sdk-parallel", "stageId": "blind-first-pass", "seatId": "builder", "modelPreference": SEATS["builder"]["defaultModelPreference"], "systemPrompt": "Return structured output.", "input": "SDK parallel two", "outputSchema": {"type": "object"}, "timeoutMs": 60000}
    parallel_responses := await parallel_map([{"config": sdk_config, "request": request_one}, {"config": sdk_config, "request": request_two}], sdk_parallel_worker, 2)
    check(parallel_responses[0]["ok"] == true && parallel_responses[1]["ok"] == true, "live SDK offline fixtures pass bounded parallel execution with per-process cwd isolation")
}

func test_blind_cancellation_wiring() {
    source := read_file(join_path(HOME, "src/tribunal.kujo"))
    check(contains(source, "invoke_checked(job[\"config\"], job[\"runId\"], \"blind-first-pass\", job[\"seat\"], job[\"input\"], job[\"seat\"][\"requiredOutputSchema\"], job[\"cancelFile\"])") == 1, "blind workers forward the shared cancellation file to live provider subprocesses")
}

func test_limits_and_analytics() {
    storage := join_path(ROOT, "limit-runs")
    oversized := join_path(ROOT, "oversized.md")
    mut content := "# Oversized\n\n## Scope\n\n"
    mut i := 0
    while i < 1100 { content = content + "x"; i = i + 1 }
    write_file(oversized, content)
    config := base_config(storage)
    limits := config["limits"]
    limits["max_docket_bytes"] := 1024
    config["limits"] := limits
    checked := validate_docket(config, oversized)
    check(checked["ok"] == false, "oversized docket is rejected before model execution")
    result := review(base_config(storage), DOCKET, "executioner-only", "", "")
    check(result["ok"] == true, "analytics fixture review succeeds")
    stats := collect_stats(storage)
    check(stats["runs"] == 1 && stats["completed"] == 1 && stats["modelInvocations"] > 0, "local aggregate analytics summarize run receipts")
    filtered := list_runs_filtered(storage, "completed", "executioner-only", 1)
    check(len(filtered) == 1, "run list supports status, panel, and limit filters")
}

func test_parallel_runtime_contract() {
    active_root := join_path(ROOT, "parallel-active"); ensure_dir(active_root)
    jobs := [
        {"id": 1, "activeRoot": active_root, "delayMs": 180, "expectedConcurrency": 2},
        {"id": 2, "activeRoot": active_root, "delayMs": 140, "expectedConcurrency": 2},
        {"id": 3, "activeRoot": active_root, "delayMs": 20, "expectedConcurrency": 2},
        {"id": 4, "activeRoot": active_root, "delayMs": 10, "expectedConcurrency": 2}
    ]
    ordered := await parallel_map(jobs, bounded_runtime_worker, 2)
    mut max_active := 0
    for result in ordered { if result["active"] > max_active { max_active = result["active"] } }
    check(ordered[0]["id"] == 1 && ordered[1]["id"] == 2 && ordered[2]["id"] == 3 && ordered[3]["id"] == 4, "parallel_map preserves stable input order across out-of-order completion")
    check(max_active == 2 && len(list_dir(active_root)) == 0, "parallel_map enforces the provider concurrency bound with isolated worker cleanup")

    cancel_file := join_path(ROOT, "parallel-cancel")
    receipt := join_path(ROOT, "cancelled-worker-receipt")
    worker := join_path(HOME, "tests/fixtures/cancellable_worker.kujo")
    cancel_jobs := [
        {"fail": false, "cancelFile": cancel_file, "receipt": receipt, "worker": worker},
        {"fail": true, "cancelFile": cancel_file, "receipt": receipt, "worker": worker}
    ]
    started := current_timestamp(); rejected := false
    try { await parallel_map(cancel_jobs, cancellable_runtime_worker, 2) } except err { rejected = contains(to_string(err), "intentional-provider-failure") == 1 }
    sleep(300)
    check(rejected && current_timestamp() - started < 3000 && file_exists(receipt) == false, "parallel provider failure cancels in-flight process work and rejects the batch")
}

setup()
test_catalog_and_config()
test_full_mock_review()
test_signed_custom_panel()
test_resumable_hearing()
test_compare_and_re_review()
test_library_api()
test_context_plugin_contract()
test_packet_template_and_policy()
test_signing_and_tamper()
test_stop_the_line()
test_packwrite_and_sdk_bridge()
test_blind_cancellation_wiring()
test_limits_and_analytics()
test_parallel_runtime_contract()
remove_tree(ROOT)

print("")
print("Tribunal Kujo tests: " + to_string(passed) + " passed, " + to_string(failed) + " failed")
if failed > 0 { exit(1) }
exit(0)
