# Kujo-only malicious server corpus. Start manually on an isolated loopback host.
port := to_int(env_or("TRIBUNAL_ADVERSARIAL_PORT", "18081"))
server := http_server(port)
server = server.route("GET", "/slow", func(req) { sleep(70000); return json_response(200, {"ok": true}) })
server = server.route("GET", "/truncated", func(req) { return http_response(200, "{\"schemaVersion\":\"1.0.0\"") })
server = server.route("GET", "/duplicate", func(req) { return http_response(200, "{\"schemaVersion\":\"1.0.0\",\"schemaVersion\":\"9.9.9\"}") })
server = server.route("GET", "/bomb", func(req) { response := http_response(200, repeat("A", 8388608)); return set_header(response, "Content-Encoding", "gzip") })
server = server.route("GET", "/headers", func(req) { response := json_response(200, {"ok": true}); return set_header(response, "X-Oversized", repeat("H", 65536)) })
server = server.route("GET", "/provider", func(req) { return http_response(200, "{\"ok\":true,\"content\":\"sk-AAAAAAAAAAAAAAAAAAAAAAAAAAAA\"}") })
server = server.route("GET", "/context-plugin", func(req) { return http_response(200, "{\"ok\":true,\"content\":\"truncated\"") })
server = server.route("GET", "/store", func(req) { return http_response(200, "{\"runId\":\"safe\",\"runId\":\"escape\"}") })
server = server.route("POST", "/telemetry", func(req) { return set_header(http_response(429, "rate limited"), "Retry-After", "999999") })
print("Tribunal malicious fixture server listening on loopback port " + to_string(port))
server.listen()
