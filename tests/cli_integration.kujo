# Tribunal real Kujo CLI integration suite.

from src.common import ensure_dir, remove_tree

mut passed := 0
mut failed := 0

func check(condition, name) {
    if condition == true { passed = passed + 1 } else { failed = failed + 1; print("  FAIL: " + name) }
}

func proc_success(proc) {
    if type(proc) == "dict" { return has_key(proc, "success") == 1 && proc["success"] == true }
    try { return proc.success == true } except err { return false }
}

func proc_stdout(proc) {
    if type(proc) == "dict" { if has_key(proc, "stdout") == 1 { return to_string(proc["stdout"]) }; return "" }
    try { return to_string(proc.stdout) } except err { return "" }
}

func proc_stderr(proc) {
    if type(proc) == "dict" { if has_key(proc, "stderr") == 1 { return to_string(proc["stderr"]) }; return "" }
    try { return to_string(proc.stderr) } except err { return "" }
}

HOME := path_absolute(env_or("TRIBUNAL_HOME", "."))
KUJO_BIN := path_absolute(env_or("KUJO_BIN", join_path(HOME, "../kujo/target/release/kujo")))
ROOT := join_path(env_or("TMPDIR", "/tmp"), "tribunal-cli-tests-" + to_string(current_timestamp()))
STORAGE := join_path(ROOT, "runs")
DOCKET := join_path(ROOT, "docket.md")

func cli(arguments) {
    mut argv := [KUJO_BIN, "run", join_path(HOME, "tribunal.kujo")]
    for value in arguments { argv = push(argv, value) }
    return spawn_process(argv, {"inherit_env": true, "env": {"TRIBUNAL_HOME": HOME, "KUJO_BIN": KUJO_BIN}, "timeout_ms": 120000, "max_output_bytes": 1024 * 1024 * 8})
}

ensure_dir(ROOT)
write_file(DOCKET, "# CLI integration\n\n## Scope\n\nProve every user-facing Kujo command.\n")

help := cli(["help"])
check(proc_success(help) && contains(proc_stdout(help), "tribunal review") == 1, "help exposes command contract")
launcher := spawn_process([join_path(HOME, "bin/tribunal"), "version"], {"inherit_env": true, "env": {"KUJO_BIN": KUJO_BIN}, "timeout_ms": 60000, "max_output_bytes": 1048576})
check(proc_success(launcher) && contains(proc_stdout(launcher), "Tribunal v1.0.0") == 1, "launcher honors the documented KUJO_BIN runtime path")
check(proc_success(cli(["panels"])), "panels command succeeds")
check(proc_success(cli(["seats"])), "seats command succeeds")
check(proc_success(cli(["panels", "--json"])), "panels supports JSON output")
check(proc_success(cli(["doctor", "--json"])), "doctor validates the local Kujo installation")
check(proc_success(cli(["auth-check", "--permission", "runs.read", "--json"])), "authorization boundary reports local operator access")
check(proc_success(cli(["validate", DOCKET, "--json"])), "validate checks a docket without opening a run")
check(proc_success(cli(["list", "--unknown"] )) == false, "unknown options are rejected")
check(proc_success(cli(["list", "--json", "--json"] )) == false, "duplicate options are rejected")

review := cli(["review", DOCKET, "--panel", "fast-two-model", "--storage-dir", STORAGE])
check(proc_success(review), "review command succeeds")
run_id := ""
if proc_success(review) { run_id = split(trim(proc_stdout(review)), "\n")[0] }
check(run_id != "", "review returns a run ID")
candidate := cli(["review", DOCKET, "--panel", "executioner-only", "--storage-dir", STORAGE])
candidate_id := ""
if proc_success(candidate) { candidate_id = split(trim(proc_stdout(candidate)), "\n")[0] }
comparison_prefix := join_path(ROOT, "cli-comparison")
check(candidate_id != "" && proc_success(cli(["compare", run_id, candidate_id, "--storage-dir", STORAGE, "--output", comparison_prefix])) && file_exists(comparison_prefix + ".json"), "compare command creates an external immutable ruling comparison")
rereview_prefix := join_path(ROOT, "cli-rereview")
check(proc_success(cli(["re-review", run_id, DOCKET, "--panel", "executioner-only", "--storage-dir", STORAGE, "--output", rereview_prefix])) && file_exists(rereview_prefix + ".json"), "re-review command creates a new hearing and comparison")
check(proc_success(cli(["resume", run_id, "--storage-dir", STORAGE])) == false, "resume command rejects a completed hearing")
check(proc_success(cli(["list", "--storage-dir", STORAGE])), "list command succeeds")
check(proc_success(cli(["list", "--storage-dir", STORAGE, "--status", "completed", "--panel", "fast-two-model", "--limit", "1", "--json"])), "list filters and JSON output succeed")
check(proc_success(cli(["list", "--storage-dir", STORAGE, "--cursor", "missing-run", "--json"])) == false, "list rejects an unknown cursor")
check(proc_success(cli(["show", run_id, "--storage-dir", STORAGE])), "show command succeeds")
check(proc_success(cli(["show", run_id, "--storage-dir", STORAGE, "--json"])), "show supports JSON output")
check(proc_success(cli(["stats", "--storage-dir", STORAGE, "--json"])), "stats summarizes local runs")
check(proc_success(cli(["contracts", run_id, "--storage-dir", STORAGE, "--json"])), "complete contract validation succeeds")
telemetry_path := join_path(ROOT, "telemetry.jsonl")
check(proc_success(cli(["telemetry-export", "--storage-dir", STORAGE, "--collector", "jsonl", "--destination", telemetry_path, "--json"])), "telemetry export command succeeds")
dashboard_path := join_path(ROOT, "dashboard.html")
check(proc_success(cli(["dashboard-export", "--storage-dir", STORAGE, "--output", dashboard_path, "--json"])) && file_exists(dashboard_path), "offline dashboard export command succeeds")
check(proc_success(cli(["locks-recover", "--storage-dir", STORAGE, "--stale-after-ms", "1000", "--json"])), "stale-lock recovery command succeeds")
check(proc_success(cli(["index-check", "--storage-dir", STORAGE, "--json"])), "persistent run-index verification command succeeds")
check(proc_success(cli(["index-rebuild", "--storage-dir", STORAGE, "--json"])), "persistent run-index rebuild command succeeds")
check(proc_success(cli(["index-repair", "--storage-dir", STORAGE, "--json"])), "persistent run-index crash-repair command succeeds")
check(proc_success(cli(["verify-bulk", "--storage-dir", STORAGE, "--limit", "1", "--json"])), "bulk verification command processes a bounded cursor page")
check(proc_success(cli(["legal-hold", run_id, "--storage-dir", STORAGE, "--enable", "--reason", "CLI test hold"])), "legal-hold command applies external hold")
check(proc_success(cli(["legal-hold", run_id, "--storage-dir", STORAGE, "--release", "--reason", "CLI test release"])), "legal-hold command releases external hold with history")
check(proc_success(cli(["list", "--storage-dir", STORAGE, "--access-policy", join_path(HOME, "examples/access-policy.json"), "--identity", "audit-reader", "--json"])), "policy-authorized auditor can list runs")
check(proc_success(cli(["auth-check", "--access-policy", join_path(HOME, "examples/access-policy.json"), "--identity", "audit-reader", "--permission", "runs.read", "--json"])), "policy identity can inspect its own requested permission")
check(proc_success(cli(["keys", "--access-policy", join_path(HOME, "examples/access-policy.json"), "--identity", "audit-reader", "--private-key", join_path(ROOT, "denied.pem"), "--public-key", join_path(ROOT, "denied.pub")])) == false, "policy denies auditor key generation")
check(proc_success(cli(["keys", "--storage-dir", STORAGE, "--private-key", join_path(STORAGE, "unsafe-private.pem"), "--public-key", join_path(STORAGE, "unsafe-public.pem")])) == false, "key generation refuses outputs inside run storage")
check(proc_success(cli(["replay", run_id, "--storage-dir", STORAGE])), "replay command verifies and succeeds")
check(proc_success(cli(["replay", run_id, "--storage-dir", STORAGE, "--require-signature"])) == false, "strict replay rejects unsigned evidence")
check(proc_success(cli(["export", run_id, "--format", "json", "--storage-dir", STORAGE])), "JSON export succeeds")
check(proc_success(cli(["export", run_id, "--format", "jsonl", "--storage-dir", STORAGE])), "JSONL export succeeds")

private_key := join_path(ROOT, "private.pem")
public_key := join_path(ROOT, "public.pem")
key_result := cli(["keys", "--private-key", private_key, "--public-key", public_key, "--bits", "2048"])
check(proc_success(key_result) && contains(proc_stdout(key_result), "\"bits\": 2048") == 1, "keys command accepts an explicit secure key size")
check(proc_success(cli(["keys", "--private-key", join_path(ROOT, "bad-private.pem"), "--public-key", join_path(ROOT, "bad-public.pem"), "--bits", "1024"])) == false, "keys rejects weak RSA key sizes")
signed := cli(["review", DOCKET, "--panel", "executioner-only", "--storage-dir", STORAGE, "--private-key", private_key, "--public-key", public_key])
check(proc_success(signed), "signed review command succeeds")
signed_id := ""
if proc_success(signed) { signed_id = split(trim(proc_stdout(signed)), "\n")[0] }
verified := cli(["verify", signed_id, "--storage-dir", STORAGE, "--public-key", public_key])
check(proc_success(verified) && contains(proc_stdout(verified), "\"signature\": \"verified\"") == 1, "verify command trusts the generated public key")
check(proc_success(cli(["verify", signed_id, "--storage-dir", STORAGE, "--public-key", public_key, "--require-signature"])), "strict verification accepts trusted signed evidence")
check(proc_success(cli(["audit", signed_id, "--storage-dir", STORAGE, "--public-key", public_key, "--require-signature", "--json"])), "one-command audit verifies integrity, signature, and contracts")
provider_key_root := join_path(ROOT, "provider-key")
ensure_dir(provider_key_root)
provider_private := join_path(provider_key_root, "private.pem")
provider_public := join_path(provider_key_root, "public.pem")
provider_keys := cli(["keys", "--private-key", provider_private, "--public-key", provider_public, "--bits", "2048"])
check(proc_success(provider_keys), "external provider fixture key is created")
provider_config := join_path(ROOT, "provider.json")
write_file(provider_config, to_json_pretty({"schemaVersion": "1.0.0", "provider": "cli-hsm-fixture", "command": join_path(HOME, "tests/fixtures/external_signer.kujo"), "keyReference": provider_key_root, "kujoBin": KUJO_BIN, "timeoutMs": 60000}) + "\n")
externally_sealed := cli(["seal-provider", signed_id, "--storage-dir", STORAGE, "--provider-config", provider_config])
check(proc_success(externally_sealed), "external signing-provider command succeeds")
provider_key_result := parse_json(proc_stdout(provider_keys))
trust_path := join_path(ROOT, "trust.json")
write_file(trust_path, to_json_pretty({"schemaVersion": "1.0.0", "defaultDeny": true, "keys": [{"keyId": provider_key_result["keyId"], "status": "active", "algorithm": "RSA-PKCS1v15-SHA256", "publicKeyPath": provider_public, "signerRef": "cli-fixture", "validFrom": 0, "validUntil": current_timestamp() + 86400000, "rotatesTo": "", "revokedAt": 0, "revocationReason": "", "allowedTargets": ["verify", "audit", "bundle-import"]}]}) + "\n")
check(proc_success(cli(["verify-policy", signed_id, "--storage-dir", STORAGE, "--trust-policy", trust_path, "--target", "verify"])), "trust-policy verification command succeeds")
check(proc_success(cli(["audit", signed_id, "--storage-dir", STORAGE, "--trust-policy", trust_path, "--target", "audit", "--require-signature", "--json"])), "audit accepts a lifecycle trust policy")
bundle_path := join_path(ROOT, "cli-bundle")
check(proc_success(cli(["bundle-export", signed_id, "--storage-dir", STORAGE, "--output", bundle_path])), "signed bundle export command succeeds")
archive_path := join_path(ROOT, "cli-bundle.zip")
archive_proc := spawn_process([KUJO_BIN, "run", join_path(HOME, "scripts/archive_bundle.kujo"), bundle_path, archive_path], {"inherit_env": true, "timeout_ms": 60000, "max_output_bytes": 1048576})
check(proc_success(archive_proc) && file_exists(archive_path), "Kujo release bundle archive succeeds")
archive_extract := join_path(ROOT, "archive-extract")
extracted := unzip(archive_path, archive_extract)
mut bundle_metadata_found := false
for path in extracted { if basename(path) == "bundle.json" { bundle_metadata_found = true } }
check(len(extracted) > 5 && bundle_metadata_found, "Kujo release archive contains portable bundle evidence")
import_storage := join_path(ROOT, "imported")
check(proc_success(cli(["bundle-import", bundle_path, "--storage-dir", import_storage, "--trust-policy", trust_path, "--target", "bundle-import"])), "signed bundle import command succeeds")
release_output := join_path(ROOT, "release-evidence")
release_proc := spawn_process([KUJO_BIN, "run", join_path(HOME, "scripts/release_evidence.kujo")], {"inherit_env": true, "env": {"TRIBUNAL_HOME": HOME, "KUJO_BIN": KUJO_BIN, "TRIBUNAL_SIGNING_PROVIDER_CONFIG": provider_config, "TRIBUNAL_RELEASE_OUTPUT": release_output}, "timeout_ms": 120000, "max_output_bytes": 1048576})
if proc_success(release_proc) == false { print("  Release detail: " + proc_stderr(release_proc) + proc_stdout(release_proc)) }
check(proc_success(release_proc) && file_exists(join_path(release_output, "release-receipt.json")) && file_exists(join_path(release_output, "tribunal-v1.0.0-signed-evidence.zip")), "Kujo-only release evidence orchestration succeeds")

write_file(join_path(join_path(STORAGE, run_id), "ruling.md"), "tampered\n", true)
check(proc_success(cli(["replay", run_id, "--storage-dir", STORAGE])) == false, "replay rejects tampering")

remove_tree(ROOT)
print("")
print("Tribunal CLI integration: " + to_string(passed) + " passed, " + to_string(failed) + " failed")
if failed > 0 { exit(1) }
exit(0)
