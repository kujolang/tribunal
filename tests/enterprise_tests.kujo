# Tribunal enterprise trust, storage, governance, telemetry, and contract suite.

from src.common import dict_get, ensure_dir, last_json_line, remove_tree, write_json
from src.config import default_config, validate_config
from src.tribunal import review
from src.integrity import begin_seal_transaction, generate_keys, recover_seal_transactions, verify, verify_runs_page
from src.signing_provider import load_signing_provider, seal_with_provider
from src.policy import authorize, load_access_policy, load_trust_policy, trusted_key
from src.locking import acquire_lock, release_lock, recover_stale_locks
from src.governance import delete_run, deletion_eligibility, set_legal_hold
from src.telemetry import export_telemetry, telemetry_payload_page
from src.contracts import validate_run_contracts
from src.bundles import export_bundle, export_encrypted_bundle, import_bundle, import_encrypted_bundle, rotate_encrypted_bundle_key, verify_encrypted_bundle_integrity
from src.artifact_store import publish_http, publish_local, pull_local
from src.storage import list_runs_page, repair_run_index, run_index_path, verify_run_index
from src.dashboard import export_dashboard
from src.audit import audit_run
from src.algorithms import algorithm_gate, algorithm_registry, migration_readiness
from src.provenance import sign_provenance, verify_provenance
from src.analytics import collect_stats_page

mut passed := 0
mut failed := 0

func check(condition, name) {
    if condition == true { passed = passed + 1 }
    else { failed = failed + 1; print("  FAIL: " + name) }
}

HOME := path_absolute(env_or("TRIBUNAL_HOME", "."))
KUJO_BIN := path_absolute(env_or("KUJO_BIN", join_path(HOME, "../kujo/target/release/kujo")))
ROOT := join_path(env_or("TMPDIR", "/tmp"), "tribunal-enterprise-tests-" + to_string(current_timestamp()))
DOCKET := join_path(ROOT, "docket.md")

func config_for(storage) {
    config := default_config()
    tribunal := config["tribunal"]
    tribunal["storage_dir"] := storage
    config["tribunal"] := tribunal
    ai := config["kujo_ai"]
    ai["kujo_bin"] := KUJO_BIN
    config["kujo_ai"] := ai
    return config
}

func make_signed(storage, key_root) {
    result := review(config_for(storage), DOCKET, "executioner-only", "", "")
    if result["ok"] != true { return result }
    ensure_dir(key_root)
    generated := generate_keys(join_path(key_root, "private.pem"), join_path(key_root, "public.pem"), 2048)
    if generated["ok"] != true { return generated }
    provider := {"schemaVersion": "1.0.0", "provider": "offline-hsm-fixture", "command": join_path(HOME, "tests/fixtures/external_signer.kujo"), "keyReference": key_root, "kujoBin": KUJO_BIN, "timeoutMs": 60000}
    sealed := seal_with_provider(storage, result["runId"], provider)
    if sealed["ok"] != true { return sealed }
    result["keyId"] := sealed["signature"]["keyId"]
    result["publicKey"] := join_path(key_root, "public.pem")
    result["providerEvidence"] := sealed["providerEvidence"]
    return result
}

ensure_dir(ROOT)
write_file(DOCKET, "# Enterprise fixture\n\n## Scope\n\nExercise trust and durable operations.\n")
release_workflow := read_file(join_path(HOME, ".github/workflows/release.yml"))
check(contains(release_workflow, "scripts/release_evidence.kujo") == 1 && contains(release_workflow, "env.TRIBUNAL_SIGNING_PROVIDER_CONFIG != ''") == 1 && contains(release_workflow, "signed_evidence") == 1 && contains(release_workflow, "actions/upload-artifact") == 1, "CI release makes externally signed evidence optional without weakening reproducible package publication")
registry := algorithm_registry()
check(json_schema_validate(registry, parse_json(read_file(join_path(HOME, "schemas/algorithm-registry.schema.json"))))["valid"] == true, "algorithm-agility registry satisfies its executable contract")
check(algorithm_gate("RSA-PKCS1v15-SHA256", "verify", "1.0.0", false)["ok"] == true && algorithm_gate("RSA-PKCS1v15-SHA256", "verify", "1.2.0", false)["ok"] == true, "legacy signature envelopes remain backward-compatible")
readiness := migration_readiness()
check(algorithm_gate("RSA-PSS-SHA256", "sign", "2.0.0", true)["ok"] == false && algorithm_gate("Ed25519", "verify", "2.0.0", true)["ok"] == false && len(readiness["runtimeBlocked"]) == 2, "future algorithms fail closed until Kujo runtime support exists")
check(json_schema_validate(parse_json(read_file(join_path(HOME, "docs/certification/vault-transit-reference.json"))), parse_json(read_file(join_path(HOME, "schemas/kms-conformance-report.schema.json"))))["valid"] == true, "Vault Transit reference certification satisfies its evidence contract")
check(json_schema_validate(parse_json(read_file(join_path(HOME, "docs/certification/http-store-reference.json"))), parse_json(read_file(join_path(HOME, "schemas/http-store-conformance-report.schema.json"))))["valid"] == true, "authenticated HTTP-store reference certification satisfies its evidence contract")

provenance_keys := join_path(ROOT, "provenance-keys"); ensure_dir(provenance_keys)
provenance_key := generate_keys(join_path(provenance_keys, "private.pem"), join_path(provenance_keys, "public.pem"), 2048)
for kind in ["access-policy", "trust-policy", "governance-registry", "deletion-tombstone", "artifact-store-index"] {
    document := join_path(ROOT, kind + ".json"); write_json(document, {"kind": kind, "revision": 1})
    provenance_path := join_path(ROOT, kind + ".provenance.json")
    anchor_path := join_path(ROOT, kind + ".anchor.json")
    signed_provenance := sign_provenance(document, kind, 1, "", provenance_key["privateKey"], provenance_key["publicKey"], provenance_path, anchor_path)
    check(signed_provenance["ok"] == true && verify_provenance(document, provenance_path, provenance_key["publicKey"], anchor_path)["rollbackProtected"] == true, kind + " has signed externally anchored provenance")
}
rollback_document := join_path(ROOT, "access-policy.json")
rollback_provenance := join_path(ROOT, "access-policy.provenance.json")
rollback_anchor := join_path(ROOT, "access-policy.anchor.json")
write_json(rollback_document, {"kind": "access-policy", "revision": 2})
next_provenance := join_path(ROOT, "access-policy.provenance.2.json")
next_anchor := join_path(ROOT, "access-policy.anchor.2.json")
signed_next := sign_provenance(rollback_document, "access-policy", 2, rollback_provenance, provenance_key["privateKey"], provenance_key["publicKey"], next_provenance, next_anchor)
check(signed_next["ok"] == true && verify_provenance(rollback_document, rollback_provenance, provenance_key["publicKey"], next_anchor)["ok"] == false, "external anchor rejects a signed policy rollback")
check(sign_provenance(rollback_document, "access-policy", 3, next_provenance, provenance_key["privateKey"], provenance_key["publicKey"], "", join_path(ROOT, "missing-output.anchor.json"))["ok"] == false, "provenance signing rejects missing output paths without partial writes")
tampered_prior := join_path(ROOT, "tampered-prior.json"); tampered_prior_value := parse_json(read_file(next_provenance)); tampered_prior_value["signature"] := repeat("a", 64); write_json(tampered_prior, tampered_prior_value)
check(sign_provenance(rollback_document, "access-policy", 3, tampered_prior, provenance_key["privateKey"], provenance_key["publicKey"], join_path(ROOT, "tampered-next.json"), join_path(ROOT, "tampered-next.anchor.json"))["ok"] == false, "provenance chains reject an unverified prior signature")
colliding_output := join_path(ROOT, "colliding-provenance.json")
check(sign_provenance(rollback_document, "access-policy", 1, "", provenance_key["privateKey"], provenance_key["publicKey"], colliding_output, colliding_output)["ok"] == false && file_exists(colliding_output) == false, "provenance output and anchor paths must be distinct and leave no partial file")
aliased_output := join_path(ROOT, "colliding-aliased-provenance.json")
aliased_anchor := ROOT + "/./colliding-aliased-provenance.json"
check(sign_provenance(rollback_document, "access-policy", 1, "", provenance_key["privateKey"], provenance_key["publicKey"], aliased_output, aliased_anchor)["ok"] == false && file_exists(aliased_output) == false, "provenance output and anchor reject equivalent path aliases without leaving partial state")

vault_config_path := join_path(ROOT, "vault-signing-provider.json")
write_json(vault_config_path, {"schemaVersion": "1.0.0", "provider": "vault-transit", "protocol": "vault-transit-jwt-v1", "command": join_path(HOME, "src/bridges/vault_transit_signing_adapter.kujo"), "keyReference": "tribunal-signing", "kujoBin": KUJO_BIN, "timeoutMs": 60000, "endpoint": "https://vault.example.test", "jwtRole": "tribunal", "jwtAuthPath": "jwt", "transitPath": "transit", "namespace": "", "audience": "tribunal", "maxAttempts": 2, "baseDelayMs": 10})
check(load_signing_provider(vault_config_path)["ok"] == true, "Vault Transit provider contract accepts workload-identity configuration")
unsafe_vault_path := join_path(ROOT, "unsafe-vault-signing-provider.json")
unsafe_vault := parse_json(read_file(vault_config_path)); unsafe_vault["endpoint"] := "http://vault.example.test"; write_json(unsafe_vault_path, unsafe_vault)
check(load_signing_provider(unsafe_vault_path)["ok"] == false, "Vault Transit provider rejects cleartext non-loopback transport")
malformed_vault_path := join_path(ROOT, "malformed-vault-signing-provider.json")
malformed_vault := parse_json(read_file(vault_config_path)); malformed_vault["endpoint"] := "https://vault.example.test\\attacker"; write_json(malformed_vault_path, malformed_vault)
check(load_signing_provider(malformed_vault_path)["ok"] == false, "Vault Transit provider rejects malformed HTTPS base URLs")

fake_token_path := join_path(ROOT, "workload.jwt")
fake_token := "fixture.header.payload.signature-that-must-never-leak"
write_file(fake_token_path, fake_token)
adapter_request := {"schemaVersion": "1.0.0", "operation": "sign", "algorithm": "RSA-PKCS1v15-SHA256", "runId": "kms-denial", "manifestSha256": repeat("a", 64), "signedAt": "2026-01-01T00:00:00Z", "keyReference": "tribunal-signing", "protocol": "vault-transit-jwt-v1", "endpoint": "http://127.0.0.1:9", "jwtRole": "tribunal", "jwtAuthPath": "jwt", "transitPath": "transit", "namespace": "", "audience": "tribunal", "maxAttempts": 2, "baseDelayMs": 10}
adapter_proc := spawn_process([KUJO_BIN, "run", join_path(HOME, "src/bridges/vault_transit_signing_adapter.kujo"), "--interpreter"], {"inherit_env": false, "env": {"TRIBUNAL_HOME": HOME, "TRIBUNAL_SIGNING_REQUEST": to_json(adapter_request), "TRIBUNAL_WORKLOAD_IDENTITY_TOKEN_FILE": fake_token_path}, "timeout_ms": 10000, "max_output_bytes": 1048576})
adapter_output := to_string(adapter_proc.stdout)
adapter_denial := parse_json(last_json_line(adapter_output))
check(adapter_proc.success == false && adapter_denial["attempts"] == 2, "Vault Transit adapter performs bounded retry and returns denial evidence")
check(contains(adapter_output, fake_token) == 0 && contains(adapter_output, "PRIVATE KEY") == 0, "Vault Transit adapter never exports workload credentials or private key material")

access := {
    "schemaVersion": "1.0.0", "defaultDeny": true,
    "identities": {"reader": {"roles": ["read"], "disabled": false}, "disabled": {"roles": ["read"], "disabled": true}},
    "roles": {"read": {"permissions": ["runs.read"]}}
}
check(authorize(access, "reader", "runs.read")["ok"] == true, "policy grants an explicit permission")
check(authorize(access, "reader", "runs.delete")["ok"] == false, "policy is default-deny")
check(authorize(access, "disabled", "runs.read")["ok"] == false, "disabled identity is rejected")
access_path := join_path(ROOT, "access.json"); write_json(access_path, access)
check(load_access_policy(access_path)["ok"] == true, "access policy loader validates nested identity and role structure")
malformed_access := access; malformed_roles := malformed_access["roles"]; malformed_role := malformed_roles["read"]; malformed_role["permissions"] := "*"; malformed_roles["read"] := malformed_role; malformed_access["roles"] := malformed_roles; malformed_path := join_path(ROOT, "malformed-access.json"); write_json(malformed_path, malformed_access)
check(load_access_policy(malformed_path)["ok"] == false, "malformed permission string cannot bypass policy schema")

lock_storage := join_path(ROOT, "lock-runs")
first_lock := acquire_lock(lock_storage, "run-lock", "worker-a", 60000)
check(first_lock["ok"] == true, "atomic run lock is acquired")
check(acquire_lock(lock_storage, "run-lock", "worker-b", 60000)["ok"] == false, "concurrent run lock is rejected")
check(release_lock(lock_storage, "run-lock", "wrong")["ok"] == false, "lock ownership token is enforced")
check(release_lock(lock_storage, "run-lock", first_lock["lock"]["token"])["released"] == true, "run lock is released")
nonsteal := acquire_lock(lock_storage, "nonsteal-run", "live-worker", 1000)
nonsteal_owner := join_path(join_path(join_path(lock_storage, ".locks"), "nonsteal-run.lock"), "owner.json")
nonsteal_value := parse_json(read_file(nonsteal_owner)); nonsteal_value["acquiredAtMs"] := 1; write_json(nonsteal_owner, nonsteal_value)
contender := acquire_lock(lock_storage, "nonsteal-run", "contender", 1000)
check(contender["ok"] == false && contender["stale"] == true && release_lock(lock_storage, "nonsteal-run", nonsteal["lock"]["token"])["released"] == true, "lock acquisition never steals a stale-looking live lock without explicit recovery")
stale := acquire_lock(lock_storage, "stale-run", "crashed-worker", 60000)
stale_owner := join_path(join_path(join_path(lock_storage, ".locks"), "stale-run.lock"), "owner.json")
stale_value := parse_json(read_file(stale_owner)); stale_value["acquiredAtMs"] := 1; write_json(stale_owner, stale_value)
check(len(recover_stale_locks(lock_storage, 1000)["recovered"]) == 1, "crash recovery removes stale locks")
corrupt_lock := acquire_lock(lock_storage, "corrupt-stale-run", "crashed-worker", 60000)
corrupt_lock_dir := join_path(join_path(lock_storage, ".locks"), "corrupt-stale-run.lock"); corrupt_owner := join_path(corrupt_lock_dir, "owner.json"); corrupt_owner_value := parse_json(read_file(corrupt_owner)); corrupt_owner_value["acquiredAtMs"] := 1; write_json(corrupt_owner, corrupt_owner_value); write_file(join_path(corrupt_lock_dir, "unexpected-state"), "preserve")
corrupt_recovery := recover_stale_locks(lock_storage, 1000)
check(corrupt_lock["ok"] == true && corrupt_recovery["ok"] == false && path_is_dir(corrupt_lock_dir), "stale-lock recovery fails closed and preserves an unexpected lock directory for reconciliation")

storage := join_path(ROOT, "source-runs")
signed := make_signed(storage, join_path(ROOT, "provider-key"))
check(signed["ok"] == true, "external signing-provider seals without Tribunal reading private material")
if signed["ok"] == true {
    run_id := signed["runId"]
    envelope := parse_json(read_file(join_path(join_path(storage, run_id), "signature.json")))
    check(envelope["schemaVersion"] == "1.2.0" && envelope["signingProvider"] == "offline-hsm-fixture", "external signer provenance is bound into v1.2 envelope")
    check(signed["providerEvidence"]["attempts"] == 1 && signed["providerEvidence"]["keyVersion"] == "fixture-v1", "external signer returns bounded retry, key-version, and audit evidence")
    checked := verify(storage, run_id, signed["publicKey"])
    check(checked["ok"] == true && checked["signature"] == "verified", "external provider signature verifies")
    leaky_provider := {"schemaVersion": "1.0.0", "provider": "compromised-fixture", "command": join_path(HOME, "tests/fixtures/leaky_signer.kujo"), "keyReference": join_path(ROOT, "provider-key"), "kujoBin": KUJO_BIN, "timeoutMs": 60000}
    check(seal_with_provider(storage, run_id, leaky_provider)["ok"] == false && verify(storage, run_id, signed["publicKey"])["ok"] == true, "private-material response is rejected without replacing prior trusted signature")
    nonzero_provider := {"schemaVersion": "1.0.0", "provider": "nonzero-fixture", "command": join_path(HOME, "tests/fixtures/nonzero_signer.kujo"), "keyReference": join_path(ROOT, "provider-key"), "kujoBin": KUJO_BIN, "timeoutMs": 60000}
    check(seal_with_provider(storage, run_id, nonzero_provider)["ok"] == false && verify(storage, run_id, signed["publicKey"])["ok"] == true, "signing-provider subprocess failure cannot be reported as a successful seal")
    rotation_root := join_path(ROOT, "provider-key-rotated")
    ensure_dir(rotation_root)
    generated_rotation := generate_keys(join_path(rotation_root, "private.pem"), join_path(rotation_root, "public.pem"), 2048)
    rotation_provider := {"schemaVersion": "1.0.0", "provider": "offline-hsm-fixture", "command": join_path(HOME, "tests/fixtures/external_signer.kujo"), "keyReference": rotation_root, "kujoBin": KUJO_BIN, "timeoutMs": 60000}
    rotated := seal_with_provider(storage, run_id, rotation_provider)
    check(generated_rotation["ok"] == true && rotated["ok"] == true && rotated["signature"]["keyId"] != signed["keyId"] && verify(storage, run_id, join_path(rotation_root, "public.pem"))["signature"] == "verified" && verify(storage, run_id, signed["publicKey"])["ok"] == false, "signing-provider rotation replaces only the signature and preserves immutable evidence")
    signed["keyId"] := rotated["signature"]["keyId"]
    signed["publicKey"] := join_path(rotation_root, "public.pem")
    transaction := begin_seal_transaction(storage, run_id)
    write_file(join_path(join_path(storage, run_id), "artifact-manifest.json"), "{}\n", true)
    write_file(join_path(join_path(storage, run_id), "signature.json"), "{}\n", true)
    recovered_seals := recover_seal_transactions(storage)
    check(transaction["ok"] == true && len(recovered_seals["recovered"]) == 1 && verify(storage, run_id, signed["publicKey"])["ok"] == true, "interrupted sealing transaction restores prior trusted evidence")
    trust := {"schemaVersion": "1.0.0", "defaultDeny": true, "keys": [{"keyId": signed["keyId"], "status": "active", "algorithm": "RSA-PKCS1v15-SHA256", "publicKeyPath": signed["publicKey"], "signerRef": "fixture", "validFrom": 0, "validUntil": current_timestamp() + 86400000, "rotatesTo": "", "revokedAt": 0, "revocationReason": "", "allowedTargets": ["bundle-import", "store-pull", "verify"]}]}
    trust_path := join_path(ROOT, "trust.json"); write_json(trust_path, trust)
    loaded_trust := load_trust_policy(trust_path)
    check(loaded_trust["ok"] == true, "trust policy loader validates lifecycle and key fingerprint inputs")
    invalid_rotation := trust; invalid_rotation_keys := invalid_rotation["keys"]; invalid_rotation_key := invalid_rotation_keys[0]; invalid_rotation_key["status"] := "rotating"; invalid_rotation_key["rotatesTo"] := "11111111111111111111111111111111"; invalid_rotation_keys[0] := invalid_rotation_key; invalid_rotation["keys"] := invalid_rotation_keys; invalid_rotation_path := join_path(ROOT, "invalid-rotation-trust.json"); write_json(invalid_rotation_path, invalid_rotation)
    check(load_trust_policy(invalid_rotation_path)["ok"] == false, "trust policy rejects a rotating key whose successor is absent")
    check(trusted_key(trust, signed["keyId"], "verify", current_timestamp())["ok"] == true, "active trusted key and target are accepted")
    check(trusted_key(trust, signed["keyId"], "runledger", current_timestamp())["ok"] == false, "trusted key target restriction is enforced")
    rotating := trust; rotating_keys := rotating["keys"]; rotating_key := rotating_keys[0]; rotating_key["status"] := "rotating"; rotating_key["rotatesTo"] := "11111111111111111111111111111111"; rotating_keys[0] := rotating_key; rotating["keys"] := rotating_keys
    check(trusted_key(rotating, signed["keyId"], "verify", current_timestamp())["ok"] == true, "rotating predecessor remains trusted during overlap window")
    revoked := trust; keys := revoked["keys"]; key := keys[0]; key["status"] := "revoked"; key["revokedAt"] := current_timestamp(); key["revocationReason"] := "test"; keys[0] := key; revoked["keys"] := keys
    check(trusted_key(revoked, signed["keyId"], "verify", current_timestamp())["ok"] == false, "revoked signing key is rejected")

    contracts := validate_run_contracts(HOME, storage, run_id)
    check(contracts["ok"] == true && contracts["validated"] > 10, "complete JSON Schema engine validates emitted contracts")
    audit := audit_run(HOME, storage, run_id, signed["publicKey"], true, null, "audit")
    check(audit["ok"] == true && audit["integrity"]["signature"] == "verified" && audit["contracts"]["ok"] == true, "one-command audit combines integrity, signature, and contract evidence")

    telemetry_path := join_path(ROOT, "collector/telemetry.jsonl")
    telemetry := export_telemetry(storage, "jsonl", telemetry_path)
    check(telemetry["ok"] == true && telemetry["events"] > 0 && file_exists(telemetry_path), "structured metrics and audit events export externally")
    check(export_telemetry(storage, "http", "http://collector.example.test/events")["ok"] == false, "telemetry CLI overrides cannot downgrade remote transport security")
    check(file_exists(join_path(join_path(storage, run_id), "telemetry.jsonl")) == false, "telemetry export does not mutate sealed runs")
    telemetry_symlink_target := join_path(ROOT, "telemetry-symlink-target.jsonl"); write_file(telemetry_symlink_target, ""); telemetry_symlink := join_path(ROOT, "telemetry-symlink.jsonl"); spawn_process(["ln", "-s", telemetry_symlink_target, telemetry_symlink], {"inherit_env": false, "timeout_ms": 10000, "max_output_bytes": 1048576})
    check(export_telemetry(storage, "jsonl", telemetry_symlink)["ok"] == false, "telemetry export rejects a symbolic-link destination")
    dashboard_path := join_path(ROOT, "dashboard/index.html")
    dashboard := export_dashboard(storage, dashboard_path)
    check(dashboard["ok"] == true && contains(read_file(dashboard_path), "Content-Security-Policy") == 1, "offline read-only dashboard exports with restrictive CSP")
    check(export_dashboard(storage, dashboard_path)["ok"] == false, "dashboard export refuses to overwrite an existing report")
    check(export_dashboard(storage, join_path(join_path(storage, run_id), "dashboard.html"))["ok"] == false && export_telemetry(storage, "jsonl", join_path(join_path(storage, run_id), "telemetry.jsonl"))["ok"] == false, "external projections refuse to mutate sealed run storage")
    output_alias := join_path(ROOT, "run-output-alias"); spawn_process(["ln", "-s", join_path(storage, run_id), output_alias], {"inherit_env": false, "timeout_ms": 10000, "max_output_bytes": 1048576})
    aliased_telemetry := join_path(output_alias, "aliased-telemetry.jsonl"); aliased_export := export_telemetry(storage, "jsonl", aliased_telemetry); aliased_mutation := file_exists(join_path(join_path(storage, run_id), "aliased-telemetry.jsonl"))
    if file_exists(aliased_telemetry) { delete_file(aliased_telemetry) }; if file_exists(aliased_telemetry + ".receipt.json") { delete_file(aliased_telemetry + ".receipt.json") }; spawn_process(["unlink", output_alias], {"inherit_env": false, "timeout_ms": 10000, "max_output_bytes": 1048576})
    check(aliased_export["ok"] == false && aliased_mutation == false, "external telemetry rejects a symlink-parent alias into sealed run storage")
    output_alias = join_path(ROOT, "run-output-alias"); spawn_process(["ln", "-s", join_path(storage, run_id), output_alias], {"inherit_env": false, "timeout_ms": 10000, "max_output_bytes": 1048576})
    aliased_dashboard := join_path(output_alias, "aliased-dashboard.html"); aliased_bundle := join_path(output_alias, "aliased-bundle"); dashboard_alias_result := export_dashboard(storage, aliased_dashboard); bundle_alias_result := export_bundle(storage, run_id, aliased_bundle); dashboard_alias_mutation := file_exists(join_path(join_path(storage, run_id), "aliased-dashboard.html")); bundle_alias_mutation := path_is_dir(join_path(join_path(storage, run_id), "aliased-bundle"))
    if file_exists(aliased_dashboard) { delete_file(aliased_dashboard) }; if path_is_dir(aliased_bundle) { remove_tree(aliased_bundle) }; spawn_process(["unlink", output_alias], {"inherit_env": false, "timeout_ms": 10000, "max_output_bytes": 1048576})
    check(dashboard_alias_result["ok"] == false && bundle_alias_result["ok"] == false && dashboard_alias_mutation == false && bundle_alias_mutation == false, "dashboard and bundle outputs reject symlink-parent aliases into sealed run storage")

    bundle_path := join_path(ROOT, "bundle")
    bundle := export_bundle(storage, run_id, bundle_path)
    check(bundle["ok"] == true && file_exists(join_path(bundle_path, "bundle.json")) && len(bundle["bundle"]["artifactDescriptors"]) == bundle["bundle"]["artifactCount"], "signed evidence bundle exports through bounded streaming copies with transfer descriptors")
    imported_storage := join_path(ROOT, "imported-runs")
    imported := import_bundle(bundle_path, imported_storage, trust, "bundle-import")
    check(imported["ok"] == true && imported["verification"]["signature"] == "verified", "signed evidence bundle imports under trust policy")
    encryption_keys := join_path(ROOT, "encryption-keys"); ensure_dir(encryption_keys)
    recipient := generate_keys(join_path(encryption_keys, "recipient-private.pem"), join_path(encryption_keys, "recipient-public.pem"), 2048)
    recovery := generate_keys(join_path(encryption_keys, "recovery-private.pem"), join_path(encryption_keys, "recovery-public.pem"), 2048)
    successor := generate_keys(join_path(encryption_keys, "successor-private.pem"), join_path(encryption_keys, "successor-public.pem"), 2048)
    encrypted_path := join_path(ROOT, "encrypted-bundle")
    encrypted := export_encrypted_bundle(storage, run_id, encrypted_path, recipient["publicKey"], recovery["publicKey"])
    independent := verify_encrypted_bundle_integrity(encrypted_path, signed["publicKey"])
    check(recipient["ok"] == true && recovery["ok"] == true && successor["ok"] == true && encrypted["ok"] == true && len(encrypted["envelope"]["wrappedKeys"]) == 2, "portable evidence bundle uses AES-256-GCM envelope encryption with a recovery recipient")
    check(export_encrypted_bundle(storage, run_id, join_path(join_path(storage, run_id), "encrypted-bundle"), recipient["publicKey"], "")["ok"] == false, "encrypted bundle export refuses to write inside run storage")
    check(independent["ok"] == true && independent["signature"] == "verified" && independent["confidentiality"] == "not-required-for-integrity-check", "encrypted bundle integrity verifies without a decryption key")
    source_signature_path := join_path(join_path(storage, run_id), "signature.json"); source_signature_original := read_file(source_signature_path); source_signature := parse_json(source_signature_original); source_manifest_text := read_file(join_path(join_path(storage, run_id), "artifact-manifest.json"))
    write_json(source_signature_path, {"schemaVersion": "1.0.0", "runId": run_id, "algorithm": "RSA-PKCS1v15-SHA256", "manifestSha256": sha256(source_manifest_text), "keyId": source_signature["keyId"], "signedAt": source_signature["signedAt"], "signature": rsa_sign(source_manifest_text, read_file(join_path(rotation_root, "private.pem")))})
    legacy_encrypted_path := join_path(ROOT, "legacy-signature-encrypted-bundle"); legacy_encrypted := export_encrypted_bundle(storage, run_id, legacy_encrypted_path, recipient["publicKey"], ""); write_file(source_signature_path, source_signature_original, true)
    check(legacy_encrypted["ok"] == true && verify_encrypted_bundle_integrity(legacy_encrypted_path, signed["publicKey"])["ok"] == true, "encrypted bundle verification preserves supported legacy v1.0 signature compatibility")
    encrypted_signature_path := join_path(join_path(encrypted_path, "integrity"), "signature.json"); encrypted_signature_original := read_file(encrypted_signature_path); encrypted_signature := parse_json(encrypted_signature_original)
    write_json(encrypted_signature_path, {"runId": encrypted_signature["runId"], "algorithm": encrypted_signature["algorithm"], "manifestSha256": encrypted_signature["manifestSha256"], "keyId": encrypted_signature["keyId"], "signedAt": encrypted_signature["signedAt"], "payloadSha256": encrypted_signature["payloadSha256"], "signature": encrypted_signature["signature"]})
    check(verify_encrypted_bundle_integrity(encrypted_path, signed["publicKey"])["ok"] == false, "encrypted bundle verification rejects a structurally incomplete signature without crashing")
    write_file(encrypted_signature_path, encrypted_signature_original, true)
    payload_signature := parse_json(encrypted_signature_original); payload_signature["payloadSha256"] := repeat("0", 64); write_json(encrypted_signature_path, payload_signature)
    payload_envelope_path := join_path(encrypted_path, "envelope.json"); payload_envelope_original := read_file(payload_envelope_path); payload_envelope := parse_json(payload_envelope_original); payload_entries := payload_envelope["artifacts"]; payload_index := 0; while payload_index < len(payload_entries) && payload_entries[payload_index]["path"] != "signature.json" { payload_index = payload_index + 1 }; payload_entry := payload_entries[payload_index]; payload_entry["bytes"] := file_size(encrypted_signature_path); payload_entry["plaintextSha256"] := sha256_file(encrypted_signature_path); payload_entries[payload_index] := payload_entry; payload_envelope["artifacts"] := payload_entries; write_json(payload_envelope_path, payload_envelope)
    check(verify_encrypted_bundle_integrity(encrypted_path, signed["publicKey"])["ok"] == false, "encrypted bundle verification rejects a tampered signature payload digest")
    write_file(encrypted_signature_path, encrypted_signature_original, true); write_file(payload_envelope_path, payload_envelope_original, true)
    envelope_binding_path := join_path(encrypted_path, "envelope.json"); envelope_binding_original := read_file(envelope_binding_path); envelope_binding := parse_json(envelope_binding_original); binding_entries := envelope_binding["artifacts"]; binding_index := 0; while binding_index < len(binding_entries) && (binding_entries[binding_index]["path"] == "artifact-manifest.json" || binding_entries[binding_index]["path"] == "signature.json") { binding_index = binding_index + 1 }; binding_entry := binding_entries[binding_index]; binding_entry["plaintextSha256"] := repeat("0", 64); binding_entries[binding_index] := binding_entry; envelope_binding["artifacts"] := binding_entries; write_json(envelope_binding_path, envelope_binding)
    check(verify_encrypted_bundle_integrity(encrypted_path, signed["publicKey"])["ok"] == false, "encrypted bundle plaintext inventory is bound to the signed artifact manifest")
    write_file(envelope_binding_path, envelope_binding_original, true)
    encrypted_import_storage := join_path(ROOT, "encrypted-import-runs")
    encrypted_import := import_encrypted_bundle(encrypted_path, encrypted_import_storage, trust, "bundle-import", recipient["privateKey"])
    check(encrypted_import["ok"] == true && encrypted_import["verification"]["signature"] == "verified", "primary envelope key decrypts and imports authenticated evidence")
    first_cipher := encrypted["envelope"]["artifacts"][0]["path"]
    cipher_path := join_path(join_path(encrypted_path, "artifacts"), first_cipher + ".enc")
    cipher_before_rotation := sha256_file(cipher_path)
    rotated_envelope := rotate_encrypted_bundle_key(encrypted_path, recipient["privateKey"], successor["publicKey"])
    check(rotated_envelope["ok"] == true && rotated_envelope["ciphertextUnchanged"] == true && sha256_file(cipher_path) == cipher_before_rotation, "envelope-key rotation leaves authenticated ciphertext unchanged")
    check(rotate_encrypted_bundle_key(encrypted_path, successor["privateKey"], recovery["publicKey"])["ok"] == false, "encrypted bundle rotation keeps the primary and recovery recipients distinct")
    envelope_path := join_path(encrypted_path, "envelope.json"); envelope_original := read_file(envelope_path); write_file(envelope_path, "{corrupt", true)
    check(rotate_encrypted_bundle_key(encrypted_path, successor["privateKey"], recipient["publicKey"])["ok"] == false && verify_encrypted_bundle_integrity(encrypted_path, signed["publicKey"])["ok"] == false, "encrypted bundle operations reject invalid envelope JSON")
    write_file(envelope_path, envelope_original, true)
    check(import_encrypted_bundle(encrypted_path, join_path(ROOT, "old-key-import"), trust, "bundle-import", recipient["privateKey"])["ok"] == false, "rotated primary envelope key is rejected")
    recovery_import := import_encrypted_bundle(encrypted_path, join_path(ROOT, "recovery-import"), trust, "bundle-import", recovery["privateKey"])
    check(recovery_import["ok"] == true && recovery_import["recoveryPurpose"] == "recovery", "recovery envelope key restores evidence after primary rotation")
    cipher_original := io_read_bytes(cipher_path, file_size(cipher_path)); io_append_bytes(cipher_path, bytes([116, 97, 109, 112, 101, 114]))
    check(verify_encrypted_bundle_integrity(encrypted_path, signed["publicKey"])["ok"] == false && import_encrypted_bundle(encrypted_path, join_path(ROOT, "tampered-encrypted-import"), trust, "bundle-import", recovery["privateKey"])["ok"] == false, "encrypted bundle corruption fails before disclosure or import")
    io_write_bytes(cipher_path, cipher_original)
    metadata_path := join_path(bundle_path, "bundle.json"); original_metadata := read_file(metadata_path); malformed_metadata := parse_json(original_metadata); malformed_metadata["artifactCount"] := malformed_metadata["artifactCount"] + 1; write_json(metadata_path, malformed_metadata)
    check(import_bundle(bundle_path, join_path(ROOT, "malformed-import"), trust, "bundle-import")["ok"] == false, "bundle import rejects inconsistent artifact inventory before copying")
    write_file(metadata_path, original_metadata, true)

    store_root := join_path(ROOT, "artifact-store")
    published := publish_local(storage, run_id, store_root, "")
    check(published["ok"] == true && published["version"] == checked["manifestSha256"], "immutable store publishes first conditional version")
    check(publish_local(storage, run_id, store_root, "")["ok"] == false, "immutable store rejects stale expected version")
    pulled_storage := join_path(ROOT, "pulled-runs")
    pulled := pull_local(store_root, run_id, published["version"], pulled_storage, trust, "store-pull")
    check(pulled["ok"] == true, "versioned immutable store restores trusted evidence")
    index_path := join_path(join_path(store_root, "indexes"), run_id + ".json"); index_original := read_file(index_path); corrupt_index := parse_json(index_original); corrupt_index["currentVersion"] := "../../unsafe"; write_json(index_path, corrupt_index)
    check(pull_local(store_root, run_id, "", join_path(ROOT, "corrupt-index-pull"), trust, "store-pull")["ok"] == false, "local store rejects a corrupt index before resolving object paths")
    write_file(index_path, index_original, true)

    store_token_path := join_path(ROOT, "store-token")
    store_token := "store-token-that-must-never-leak"
    write_file(store_token_path, store_token)
    http_config := default_config(); http_store := http_config["artifact_store"]; http_store["provider"] := "http-immutable"; http_store["endpoint"] := "http://127.0.0.1:9"; http_store["tenant_id"] := "tenant-a"; http_store["bearer_token_file"] := store_token_path; http_store["region"] := "region-a"; http_config["artifact_store"] := http_store
    check(validate_config(http_config) == "", "authenticated HTTP store requires an explicit tenant, token file, and region")
    check(publish_http(storage, run_id, "http://127.0.0.1:9", "")["ok"] == false, "unauthenticated HTTP artifact-store calls fail closed")
    unavailable_store := publish_http(storage, run_id, http_store, "")
    check(unavailable_store["ok"] == false && unavailable_store["attempts"] == 3 && contains(unavailable_store["error"], store_token) == 0, "authenticated HTTP store retries are bounded and credentials are never returned")
    invalid_tenant_config := http_config; invalid_store := invalid_tenant_config["artifact_store"]; invalid_store["tenant_id"] := "../tenant-b"; invalid_tenant_config["artifact_store"] := invalid_store
    check(validate_config(invalid_tenant_config) != "", "HTTP store tenant identity cannot contain path traversal")

    page := list_runs_page(storage, "completed", "executioner-only", 1, "")
    check(len(page["items"]) == 1, "cursor page returns bounded items")
    stats_page := collect_stats_page(storage, "", 1, null)
    check(stats_page["ok"] == true && stats_page["runsProcessed"] == 1 && stats_page["pageLimit"] == 1, "stats aggregation exposes a bounded incremental page contract")
    telemetry_page := telemetry_payload_page(storage, "", 1, stats_page["stats"])
    check(telemetry_page["ok"] == true && telemetry_page["runsProcessed"] == 1 && telemetry_page["pageLimit"] == 1, "telemetry projection exposes a bounded incremental page contract")
    bulk_page := verify_runs_page(storage, "", 1, signed["publicKey"], true)
    check(bulk_page["ok"] == true && bulk_page["runsProcessed"] == 1 && json_schema_validate(bulk_page, parse_json(read_file(join_path(HOME, "schemas/bulk-verification.schema.json"))))["valid"] == true, "bulk integrity verification is cursor-bounded and schema-valid")
    indexed := verify_run_index(storage)
    check(indexed["ok"] == true && indexed["indexed"] == 1, "persistent run index matches durable storage")
    orphan_id := "2026-07-12-orphan-index-fixture"
    orphan_root := join_path(storage, orphan_id); ensure_dir(orphan_root)
    write_json(join_path(orphan_root, "manifest.json"), {"schemaVersion": "1.0.0", "runId": orphan_id, "status": "stopped", "openedAt": "2026-07-12T00:00:00Z", "completedAt": "2026-07-12T00:00:01Z", "panelId": "executioner-only", "seatIds": ["executioner"], "docketSource": "fixture", "mockMode": true, "blindFirstPassRequired": true, "sdkBoundary": "KujoModelClient", "governance": {}})
    drifted_index := verify_run_index(storage)
    check(drifted_index["ok"] == false && len(drifted_index["missing"]) == 1, "run-index verification detects an unindexed durable run")
    repaired_index := repair_run_index(storage)
    check(repaired_index["ok"] == true && repaired_index["indexed"] == 2, "run-index repair rebuilds missing entries from durable manifests")
    indexed_manifest_path := join_path(join_path(storage, run_id), "manifest.json")
    indexed_manifest_original := read_file(indexed_manifest_path)
    indexed_manifest := parse_json(indexed_manifest_original); indexed_manifest["status"] := "stopped"; write_json(indexed_manifest_path, indexed_manifest)
    check(len(verify_run_index(storage)["mismatched"]) == 1, "run-index verification detects manifest digest drift")
    write_file(indexed_manifest_path, indexed_manifest_original, true)
    stale_index_temp := run_index_path(storage) + ".tmp-crash-fixture"; write_file(stale_index_temp, "partial")
    write_file(run_index_path(storage), "{corrupt", true)
    recovered_index := repair_run_index(storage)
    check(recovered_index["ok"] == true && recovered_index["staleTempsRemoved"] == 1 && file_exists(stale_index_temp) == false, "crash repair atomically rebuilds a corrupt index and removes stale write fragments")
}

governance_storage := join_path(ROOT, "governance-runs")
governed := review(config_for(governance_storage), DOCKET, "executioner-only", "", "")
check(governed["ok"] == true && governed["record"]["governance"]["retentionDays"] == 365, "run persists retention metadata before sealing")
if governed["ok"] == true {
    blocked := delete_run(governance_storage, governed["runId"], "local-operator", "premature", false)
    check(blocked["ok"] == false, "retention policy blocks premature deletion")
    applied_hold := set_legal_hold(governance_storage, governed["runId"], "legal-officer", true, "litigation")
    check(applied_hold["ok"] == true && delete_run(governance_storage, governed["runId"], "local-operator", "blocked by external hold", true)["ok"] == false, "post-seal external legal hold blocks deletion")
    released_hold := set_legal_hold(governance_storage, governed["runId"], "legal-officer", false, "matter closed")
    check(released_hold["ok"] == true && len(released_hold["governance"]["history"]) == 2, "legal-hold release preserves append-only governance history")
    governance_path := join_path(join_path(governance_storage, ".governance"), governed["runId"] + ".json"); governance_original := read_file(governance_path); write_json(governance_path, {"legalHold": false})
    check(deletion_eligibility(governance_storage, governed["runId"], true)["ok"] == false, "deletion fails closed on a malformed external governance record")
    write_file(governance_path, governance_original, true)
    deleted := delete_run(governance_storage, governed["runId"], "local-operator", "approved test expiry", true)
    tombstone_path := join_path(join_path(governance_storage, ".deletions"), governed["runId"] + ".json")
    check(deleted["ok"] == true && file_exists(tombstone_path) && parse_json(read_file(tombstone_path))["status"] == "deleted", "policy deletion precommits and finalizes an external tombstone")
}

hold_config := config_for(join_path(ROOT, "hold-runs")); hold_governance := hold_config["governance"]; hold_governance["legal_hold"] := true; hold_config["governance"] := hold_governance
held := review(hold_config, DOCKET, "executioner-only", "", "")
check(held["ok"] == true && delete_run(hold_config["tribunal"]["storage_dir"], held["runId"], "local-operator", "must fail", true)["ok"] == false, "legal hold blocks forced deletion")

remove_tree(ROOT)
print("")
print("Tribunal enterprise tests: " + to_string(passed) + " passed, " + to_string(failed) + " failed")
if failed > 0 { exit(1) }
exit(0)
