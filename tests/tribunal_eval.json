{
  "name": "tribunal-kujo-native-gate",
  "description": "Deterministic Kujo-only checks for Tribunal's native implementation.",
  "version": "4.0.0",
  "output_dir": "./eval_results/tribunal",
  "snapshot_dir": "./tests/snapshots",
  "stop_on_failure": true,
  "tests": [
    {
      "name": "Tribunal Kujo check passes",
      "check": "command_succeeds",
      "params": {
        "command": "cd ../tribunal && ../kujo/target/release/kujo check tribunal.kujo"
      }
    },
    {
      "name": "Tribunal Kujo test suite passes",
      "check": "command_succeeds",
      "params": {
        "command": "cd ../tribunal && TRIBUNAL_HOME=. KUJO_BIN=../kujo/target/release/kujo ../kujo/target/release/kujo run tests/tribunal_tests.kujo"
      }
    },
    {
      "name": "Tribunal Kujo CLI integration passes",
      "check": "command_succeeds",
      "params": {
        "command": "cd ../tribunal && TRIBUNAL_HOME=. KUJO_BIN=../kujo/target/release/kujo ../kujo/target/release/kujo run tests/cli_integration.kujo"
      }
    },
    {
      "name": "Tribunal enterprise trust and operations pass",
      "check": "command_succeeds",
      "params": {
        "command": "cd ../tribunal && TRIBUNAL_HOME=. KUJO_BIN=../kujo/target/release/kujo ../kujo/target/release/kujo run tests/enterprise_tests.kujo"
      }
    },
    {
      "name": "Tribunal property boundary corpus passes",
      "check": "command_succeeds",
      "params": {
        "command": "cd ../tribunal && TRIBUNAL_HOME=. KUJO_BIN=../kujo/target/release/kujo ../kujo/target/release/kujo run tests/property_tests.kujo"
      }
    },
    {
      "name": "Kujo-native schema gate passes",
      "check": "command_succeeds",
      "params": {
        "command": "cd ../tribunal && TRIBUNAL_HOME=. KUJO_BIN=../kujo/target/release/kujo ../kujo/target/release/kujo run scripts/schema_gate.kujo"
      }
    },
    {
      "name": "Kujo-native Concord gate passes",
      "check": "command_succeeds",
      "params": {
        "command": "cd ../tribunal && TRIBUNAL_HOME=. KUJO_BIN=../kujo/target/release/kujo ../kujo/target/release/kujo run scripts/drift_gate.kujo"
      }
    },
    {
      "name": "Kujo-native Spec gate passes",
      "check": "command_succeeds",
      "params": {
        "command": "cd ../tribunal && TRIBUNAL_HOME=. KUJO_BIN=../kujo/target/release/kujo ../kujo/target/release/kujo run scripts/spec_gate.kujo"
      }
    },
    {
      "name": "Tribunal local benchmark passes",
      "check": "command_succeeds",
      "params": {
        "command": "cd ../tribunal && TRIBUNAL_HOME=. KUJO_BIN=../kujo/target/release/kujo ../kujo/target/release/kujo run scripts/perf_gate.kujo"
      }
    },
    {
      "name": "Tribunal scale budget passes",
      "check": "command_succeeds",
      "params": {
        "command": "cd ../tribunal && TRIBUNAL_HOME=. KUJO_BIN=../kujo/target/release/kujo ../kujo/target/release/kujo run scripts/scale_perf_gate.kujo"
      }
    }
  ]
}
