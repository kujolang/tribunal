{
  "name": "tribunal-post-mvp-gate",
  "description": "Deterministic checks for Tribunal's completed README Next work.",
  "version": "1.0.0",
  "output_dir": "./eval_results/tribunal",
  "snapshot_dir": "./tests/snapshots",
  "stop_on_failure": true,
  "tests": [
    {
      "name": "Tribunal typecheck passes",
      "check": "command_succeeds",
      "params": { "command": "npm run typecheck" }
    },
    {
      "name": "Tribunal test suite passes",
      "check": "command_succeeds",
      "params": { "command": "npm test" }
    },
    {
      "name": "Artifact manifest schema exists",
      "check": "file_exists",
      "params": { "path": "schemas/artifact-manifest.schema.json" }
    },
    {
      "name": "Signature schema exists",
      "check": "file_exists",
      "params": { "path": "schemas/signature.schema.json" }
    },
    {
      "name": "README documents trusted signed ingestion",
      "check": "file_contains",
      "params": {
        "path": "README.md",
        "expected": "Signed ingestion"
      }
    }
  ]
}
