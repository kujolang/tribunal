# Offline independent-process workload for the shared-index regression.
from src.storage import save_json, list_runs_page, rebuild_run_index
values := args()
if len(values) != 3 { exit(2) }
storage := values[0]; mode := values[1]; prefix := values[2]
mut i := 0
while i < 15 {
    if mode == "write" {
        run_id := prefix + "-" + to_string(i)
        if save_json(storage, run_id, "manifest.json", {"runId": run_id, "status": "completed", "panelId": "fixture"}) != true { exit(1) }
    } else if mode == "rebuild" {
        if rebuild_run_index(storage)["ok"] != true { exit(1) }
    } else {
        page := list_runs_page(storage, "", "", 10, "")
        if has_key(page, "error") == 1 { print(to_json(page)); exit(1) }
    }
    i = i + 1
}
